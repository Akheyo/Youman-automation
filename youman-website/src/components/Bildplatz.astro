---
/**
 * Reservierte Fläche für ein Bild.
 *
 * Solange keine Datei vorliegt, steht hier ein ruhiger Platzhalter mit der
 * Angabe, was an diese Stelle gehört. Sobald ein Bild da ist, wird es über
 * `bild` und `alt` übergeben und ersetzt den Platzhalter, ohne dass sich das
 * Layout ändert: Die Fläche hat schon vorher exakt das Seitenverhältnis des
 * späteren Bildes. Deshalb springt beim Nachrüsten nichts (CLS bleibt 0).
 *
 * Bild einsetzen:
 *   import motiv from '../assets/img/motiv.webp';
 *   <Bildplatz bild={motiv} alt="Was zu sehen ist" bezeichnung="…" />
 *
 * Der Platzhalter ist fuer Vorlesewerkzeuge ausgeblendet. Er richtet sich an
 * die, die die Seite bauen, nicht an die, die sie lesen; in einer Kachel, die
 * selbst ein Verweis ist, waere seine Beschriftung sonst Teil des
 * Verweisnamens und wuerde vor jedem Kacheltitel mit vorgelesen. Sobald ein
 * Bild gesetzt ist, traegt dessen alt-Text die Bedeutung.
 *
 * Er ist eine gerahmte Fläche mit einer kleinen Marke in der Mitte. Der
 * Rahmen ist nötig, damit er überhaupt als reservierte Fläche gelesen wird,
 * bleibt aber hell: Auf einer Seite, die öffentlich ist, soll er nicht nach
 * Baustelle aussehen, sondern nach einem Feld, das noch besetzt wird.
 */
import { Image } from 'astro:assets';

interface Props {
  /** Was an diese Stelle gehört, in wenigen Worten. */
  bezeichnung: string;
  /** Seitenverhältnis, CSS-Schreibweise. Bestimmt die reservierte Höhe. */
  verhaeltnis?: string;
  /** Sobald vorhanden: das importierte Bild. */
  bild?: ImageMetadata;
  /** Bildbeschreibung. Pflicht, sobald `bild` gesetzt ist. */
  alt?: string;
  /** Angezeigte Breiten, für die Astro Varianten erzeugt. */
  sizes?: string;
  class?: string;
}

const {
  bezeichnung,
  verhaeltnis = '3 / 2',
  bild,
  alt = '',
  sizes = '(min-width: 1024px) 50vw, 100vw',
  class: className = '',
} = Astro.props;
---

<figure
  class:list={[
    'relative overflow-hidden',
    bild ? 'bild-zieht-heran' : 'bildplatz',
    className,
  ]}
  style={`aspect-ratio: ${verhaeltnis};`}
>
  {
    bild ? (
      <Image
        src={bild}
        alt={alt}
        sizes={sizes}
        widths={[480, 768, 1024, 1440]}
        loading="lazy"
        decoding="async"
        class="absolute inset-0 size-full object-cover"
      />
    ) : (
      <div class="absolute inset-0 grid place-items-center p-6" aria-hidden="true">
        <div class="bildplatz-marke flex items-center gap-3 px-5 py-3">
          <svg
            class="size-5 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.25"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="4" width="18" height="16" rx="1" />
            <circle cx="8.5" cy="9.5" r="1.5" />
            <path d="m3 16.5 4.5-4.5 4 4 3-3L21 18" />
          </svg>
          <figcaption class="text-left leading-tight">
            <span class="block text-sm font-medium">{bezeichnung}</span>
            {/*
              Kein opacity auf der Zeile: Bei 70 % landet #2e2e2e auf der
              hellen Marke bei 4.3:1 und damit unter der Grenze. Die
              Abstufung kommt deshalb ueber eine eigene Farbe.
            */}
            <span class="text-muted-fg mt-0.5 block text-[0.6875rem] tracking-[0.14em] uppercase">
              Bildplatz {verhaeltnis.replace(' / ', ':')}
            </span>
          </figcaption>
        </div>
      </div>
    )
  }
</figure>

<style>
  /*
    Ruhige Flaeche statt Schraffur: ein flacher Verlauf, der die Flaeche von
    oben links oeffnet, und eine feine Innenlinie. Die Schraffur davor war
    laut genug, dass sie neben den echten Bildern danebenstand.
  */
  .bildplatz {
    background-image:
      linear-gradient(
        135deg,
        color-mix(in oklab, var(--color-surface) 88%, white) 0%,
        var(--color-muted) 62%,
        color-mix(in oklab, var(--color-muted) 92%, black) 100%
      );
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-line) 22%, transparent);
  }

  /* Die Marke traegt eine eigene helle Flaeche, damit sie auf jedem
     Verlaufsabschnitt gleich gut lesbar bleibt. */
  .bildplatz-marke {
    color: var(--color-ink-soft);
    background-color: color-mix(in oklab, var(--color-surface) 78%, white);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--color-line) 14%, transparent);
  }
</style>
