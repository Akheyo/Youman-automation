---
/**
 * Reservierte Fläche für ein Bild.
 *
 * Solange keine Datei vorliegt, steht hier ein ruhiger Platzhalter mit der
 * Angabe, was an diese Stelle gehört. Sobald ein Bild da ist, wird es über
 * `bild` und `alt` übergeben und ersetzt den Platzhalter, ohne dass sich das
 * Layout ändert: Die Fläche hat schon vorher exakt das Seitenverhältnis des
 * späteren Bildes. Deshalb springt beim Nachrüsten nichts (CLS bleibt 0).
 *
 * Bild einsetzen:
 *   import motiv from '../assets/img/motiv.webp';
 *   <Bildplatz bild={motiv} alt="Was zu sehen ist" bezeichnung="…" />
 *
 * Der Platzhalter ist eine umrandete Fläche mit feiner Schraffur. Beides ist
 * nötig, damit er als reservierte Fläche gelesen wird: Ohne Rand und Muster
 * sieht ein heller Kasten auf weißem Grund nach Weißraum aus, nicht nach
 * "hier fehlt ein Bild". Eine gestrichelte Warnbox ist es trotzdem nicht,
 * die Seite ist öffentlich und soll nicht nach Baustelle aussehen.
 */
import { Image } from 'astro:assets';

interface Props {
  /** Was an diese Stelle gehört, in wenigen Worten. */
  bezeichnung: string;
  /** Seitenverhältnis, CSS-Schreibweise. Bestimmt die reservierte Höhe. */
  verhaeltnis?: string;
  /** Sobald vorhanden: das importierte Bild. */
  bild?: ImageMetadata;
  /** Bildbeschreibung. Pflicht, sobald `bild` gesetzt ist. */
  alt?: string;
  /** Angezeigte Breiten, für die Astro Varianten erzeugt. */
  sizes?: string;
  class?: string;
}

const {
  bezeichnung,
  verhaeltnis = '3 / 2',
  bild,
  alt = '',
  sizes = '(min-width: 1024px) 50vw, 100vw',
  class: className = '',
} = Astro.props;
---

<figure
  class:list={['relative overflow-hidden', bild ? '' : 'border border-line bg-muted', className]}
  style={`aspect-ratio: ${verhaeltnis};`}
>
  {
    bild ? (
      <Image
        src={bild}
        alt={alt}
        sizes={sizes}
        widths={[480, 768, 1024, 1440]}
        loading="lazy"
        decoding="async"
        class="absolute inset-0 size-full object-cover"
      />
    ) : (
      <div class="absolute inset-0 flex flex-col items-center justify-center gap-4 p-6 text-center">
        {/*
          Schraffur nur als Hintergrund, nicht als eigenes Element mit Inhalt:
          sie traegt keine Information und darf von Vorlesewerkzeugen nicht
          angesagt werden.
        */}
        <span class="bildplatz-schraffur absolute inset-0" aria-hidden="true" />
        <svg
          class="relative size-12 shrink-0 text-ink"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="3" y="4" width="18" height="16" rx="1" />
          <circle cx="8.5" cy="9.5" r="1.5" />
          <path d="m3 16.5 4.5-4.5 4 4 3-3L21 18" />
        </svg>
        <figcaption class="relative">
          <span class="block text-base font-semibold text-ink md:text-lg">{bezeichnung}</span>
          <span class="mt-1 block text-sm text-muted-fg">
            Bildplatz, Format {verhaeltnis.replace(' / ', ':')}
          </span>
        </figcaption>
      </div>
    )
  }
</figure>

<style>
  /*
    Feine Diagonalschraffur. Sehr schwach gehalten: Sie soll die Flaeche als
    reserviert kennzeichnen, nicht mit der Beschriftung darauf konkurrieren.
  */
  .bildplatz-schraffur {
    background-image: repeating-linear-gradient(
      45deg,
      rgb(0 0 0 / 0.06) 0,
      rgb(0 0 0 / 0.06) 1px,
      transparent 1px,
      transparent 9px
    );
  }
</style>
