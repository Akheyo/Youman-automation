---
import { withBase } from '../lib/url';

/**
 * Kopfbereich einer Seite.
 *
 * Ohne Bild: Das Motiv der Seite steht weiter unten, hier traegt die
 * Typografie auf schwarzem Grund. Das spart auf jeder Seite mehrere hundert
 * Kilobyte und macht einen Layout-Sprung beim Nachladen unmoeglich.
 *
 * Ueber dem Schwarz liegen zwei sehr schwache Ebenen: ein feines Raster und
 * ein Lichtschein von links oben. Beide sind kaum zu benennen, wenn man
 * hinsieht, nehmen der Flaeche aber das Tote. Rein dekorativ, deshalb
 * aria-hidden.
 */
interface Props {
  kicker?: string;
  title: string;
  lead?: string;
  breadcrumb?: { label: string; href: string }[];
}

const { kicker, title, lead, breadcrumb = [] } = Astro.props;
---

<div class="on-dark relative isolate overflow-hidden bg-ink-deep text-white">
  <div class="seitenkopf-raster absolute inset-0" aria-hidden="true"></div>
  <div class="seitenkopf-schein absolute inset-0" aria-hidden="true"></div>

  <div class="container-page relative py-16 md:py-24 lg:py-32">
    {
      breadcrumb.length > 0 && (
        <nav aria-label="Brotkrumennavigation" class="mb-6">
          <ol class="flex flex-wrap items-center gap-x-2 text-sm text-white/70">
            {breadcrumb.map((crumb, index) => (
              <li class="flex items-center gap-2">
                {index > 0 && <span aria-hidden="true">/</span>}
                <a
                  href={withBase(crumb.href)}
                  class="inline-flex min-h-11 items-center hover:text-white transition-colors duration-200"
                >
                  {crumb.label}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    {
      kicker && (
        <p class="flex items-center gap-3 text-xs font-semibold tracking-[0.18em] text-accent-on-dark uppercase">
          <span class="block h-px w-8 bg-white/50" aria-hidden="true" />
          {kicker}
        </p>
      )
    }
    <h1 class="mt-5 max-w-4xl text-3xl sm:text-5xl lg:text-6xl">{title}</h1>
    {lead && <p class="prose-measure mt-6 text-lg text-white/80">{lead}</p>}
  </div>
</div>

<style>
  .seitenkopf-raster {
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.055) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.055) 1px, transparent 1px);
    background-size: 88px 88px;
    /* Nach unten ausblenden, sonst endet das Raster mit einer harten Kante. */
    mask-image: linear-gradient(to bottom, black 0%, transparent 92%);
  }

  .seitenkopf-schein {
    background-image: radial-gradient(
      70% 120% at 8% -20%,
      rgb(255 255 255 / 0.1) 0%,
      transparent 70%
    );
  }
</style>
