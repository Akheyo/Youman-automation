---
import { withBase } from '../lib/url';

/**
 * Schaltflaeche als Verweis.
 *
 * Der Pfeil rueckt beim Ueberfahren ein Stueck nach rechts. Das ist die
 * einzige Bewegung daran und sie sagt etwas: Es geht weiter, die Flaeche ist
 * kein Schalter, der etwas auf dieser Seite tut. Bei reduzierter Bewegung
 * steht er still, sichtbar bleibt er.
 */
interface Props {
  href: string;
  /**
   * "invers" ist die Hauptschaltflaeche in den schwarzen Sektionen: weiss
   * gefuellt, damit sie sich von der umrissenen "ghost"-Variante daneben
   * abhebt. Zwei gleich aussehende Schaltflaechen nebeneinander lassen
   * offen, welche die wichtigere ist.
   */
  variant?: 'primary' | 'secondary' | 'ghost' | 'invers';
  /** false, wenn der Pfeil nicht passt, etwa bei sehr schmalen Flaechen. */
  pfeil?: boolean;
  class?: string;
}

const { href, variant = 'primary', pfeil = true, class: className = '' } = Astro.props;

const styles = {
  primary: 'bg-accent text-accent-fg hover:bg-accent-hover border border-transparent',
  secondary: 'bg-transparent text-accent border border-accent hover:bg-accent hover:text-accent-fg',
  ghost: 'bg-transparent text-white border border-white/60 hover:bg-white hover:text-ink-deep',
  invers: 'bg-white text-ink-deep border border-white hover:bg-surface hover:border-surface',
} as const;
---

<a
  href={withBase(href)}
  class:list={[
    'gruppe-knopf druckt-sich inline-flex min-h-11 items-center justify-center gap-2.5 px-6 py-3 text-[0.9375rem] font-medium transition-colors duration-200',
    styles[variant],
    className,
  ]}
>
  <slot />
  {
    pfeil && (
      <svg
        class="knopf-pfeil size-4 shrink-0"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h13M13 6l6 6-6 6" />
      </svg>
    )
  }
</a>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .knopf-pfeil {
      transition: translate 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .gruppe-knopf:hover .knopf-pfeil,
    .gruppe-knopf:focus-visible .knopf-pfeil {
      translate: 3px 0;
    }
  }
</style>
