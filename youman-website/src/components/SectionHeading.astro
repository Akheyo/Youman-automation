---
interface Props {
  /** Kleine Zeile über der Überschrift, gesperrt und in Versalien. */
  kicker?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  as?: 'h2' | 'h3';
  tone?: 'light' | 'dark';
  class?: string;
}

const {
  kicker,
  title,
  lead,
  align = 'left',
  as: Tag = 'h2',
  tone = 'light',
  class: className = '',
}: Props = Astro.props;
---

<div class:list={[align === 'center' && 'text-center', className]}>
  {/*
    Akzentlinie als Anfangsmarke des Abschnitts. Sie waechst beim
    Hereinscrollen auf und traegt keine Information - bleibt sie stehen,
    fehlt nichts.
  */}
  <span
    class:list={[
      'linie-waechst mb-6 block h-0.5 w-14',
      align === 'center' && 'mx-auto',
      // Ternaer statt zweier Klassen: bei `bg-accent bg-accent-on-dark`
      // entschiede die Reihenfolge im Stylesheet, nicht die im Attribut.
      tone === 'dark' ? 'bg-accent-on-dark' : 'bg-accent',
    ]}
    aria-hidden="true"
  />
  {
    kicker && (
      <p
        class:list={[
          'text-xs font-semibold uppercase tracking-[0.18em]',
          tone === 'dark' ? 'text-accent-on-dark' : 'text-accent',
        ]}
      >
        {kicker}
      </p>
    )
  }
  <Tag
    class:list={[
      'text-3xl sm:text-4xl lg:text-5xl',
      kicker && 'mt-3',
      tone === 'dark' ? 'text-white' : 'text-ink',
    ]}
  >
    {title}
  </Tag>
  {
    lead && (
      <p
        class:list={[
          /*
            Kein Blocksatz in der Einleitungszeile. Sie ist ein bis zwei
            Zeilen lang, und bei zwei Zeilen dehnt der Browser die erste auf
            volle Breite, sobald das letzte Wort nicht mehr hineinpasst:
            ein einzelner Satz mit fingerbreiten Luecken. Die Breite bleibt
            dieselbe wie im Fliesstext.
          */
          'mt-5 max-w-[68ch] text-lg text-pretty hyphens-auto',
          align === 'center' && 'mx-auto',
          tone === 'dark' ? 'text-white/80' : 'text-ink-soft',
        ]}
      >
        {lead}
      </p>
    )
  }
</div>
