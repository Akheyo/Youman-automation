---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import Bildplatz from '../../components/Bildplatz.astro';
import Kicker from '../../components/Kicker.astro';
import Kachel from '../../components/Kachel.astro';
import Kasten from '../../components/Kasten.astro';
import { leistungen } from '../../data/leistungen';
import { branchen } from '../../data/branchen';
import { referenzenZurLeistung } from '../../data/caseStudies';
import { prozess } from '../../data/site';
import { withBase } from '../../lib/url';
import { ersterSatz } from '../../lib/text';

export function getStaticPaths() {
  return leistungen.map((leistung) => ({
    params: { slug: leistung.slug },
    props: { leistung },
  }));
}

const { leistung } = Astro.props;

const passendeBranchen = branchen.filter((b) => b.leistungen.includes(leistung.slug));

// Der erste Satz der Einleitung traegt die Aussage und wird als Vorspann
// gesetzt, der Rest als Fliesstext darunter.
const einleitung = ersterSatz(leistung.intro);
const referenzen = referenzenZurLeistung(leistung.slug);

const brotkrumen = [
  { label: 'Home', href: '/' },
  { label: 'Leistungen', href: '/leistungen/' },
];
---

<Base
  title={leistung.seoTitel ?? leistung.title}
  description={leistung.seoBeschreibung ?? leistung.teaser}
  breadcrumb={brotkrumen}
  dienstleistung={{ name: leistung.title, beschreibung: leistung.teaser }}
  bild={leistung.bild}
>
  <PageHeader
    kicker="Leistungen"
    title={leistung.title}
    lead={leistung.teaser}
    breadcrumb={brotkrumen}
  />

  {/*
    Motiv und Einleitung nebeneinander. Das Bild liegt schon in den Daten,
    stand auf der Detailseite aber bisher nicht: Wer hierher durchklickt, hat
    es auf der Kachel gesehen und findet es hier wieder.
  */}
  <Section>
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-6">
        <Bildplatz
          bild={leistung.bild}
          alt={leistung.bildAlt}
          bezeichnung={leistung.bildhinweis}
          verhaeltnis="16 / 9"
          sizes="(min-width: 1024px) 48vw, 100vw"
        />
      </div>
      <div class="lg:col-span-5 lg:col-start-8">
        <Kicker>Worum es geht</Kicker>
        <p class="vorspann mt-5">{einleitung.satz}</p>
        {einleitung.rest && <p class="prose-measure mt-5 text-ink-soft">{einleitung.rest}</p>}
      </div>
    </div>
  </Section>

  <Section tone="canvas">
    <SectionHeading
      kicker="Woran es hakt"
      title="Typische Problemstellungen"
      lead="Wenn Ihnen davon etwas bekannt vorkommt, lohnt sich ein Gespräch."
    />
    <ul class="mt-12 rasterfugen sm:grid-cols-2" data-reveal>
      {
        leistung.painpoints.map((punkt, i, alle) => (
          <li
            class:list={[
              'flex items-start gap-5 bg-surface p-7 md:p-8',
              /*
                Ungerade Zahl in zwei Spalten: Der letzte Eintrag zieht sich
                ueber die Reihe, sonst bleibt daneben ein Loch stehen. Das
                betraf jede Leistungs- und jede Branchenseite, weil dort
                jeweils fuenf Punkte stehen.
              */
              i === alle.length - 1 && alle.length % 2 === 1 && 'sm:col-span-2',
            ]}
          >
            <span class="zaehlziffer shrink-0 text-3xl leading-none">
              {String(i + 1).padStart(2, '0')}
            </span>
            <p class="text-pretty pt-1 text-ink-soft">{punkt}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  {/*
    Bausteine zum Aufklappen. Zu, solange niemand klickt: die Seite soll
    zuerst zeigen, WAS es gibt, nicht alle Erlaeuterungen auf einmal.
  */}
  <Section>
    <SectionHeading
      title="Was dabei gebaut wird"
      lead="Zugeschnitten auf den konkreten Ablauf, nie als Standardfunktion von der Stange."
    />
    <div class="mt-12 grid gap-10 lg:grid-cols-12 lg:gap-16">
    <ul class="divide-y divide-line border-y border-line lg:col-span-7">
      {
        leistung.bausteine.map((baustein, i) => (
          <li>
            <details class="group">
              <summary class="flex cursor-pointer items-center justify-between gap-6 py-6 marker:content-none [&::-webkit-details-marker]:hidden">
                <span class="flex items-baseline gap-5">
                  <span class="zaehlziffer shrink-0 text-xl leading-none">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="text-lg text-ink">{baustein.titel}</span>
                </span>
                <svg
                  class="size-5 shrink-0 text-accent transition-transform duration-200 group-open:rotate-45"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </summary>
              <p class="prose-measure pb-7 pl-12 pr-4 text-ink-soft">{baustein.text}</p>
            </details>
          </li>
        ))
      }
    </ul>
    <Kasten titel="Was das kostet" class="lg:col-span-4 lg:col-start-9 self-start">
      <p>
        Preise und Laufzeiten stehen hier bewusst nicht. Beides hängt daran, wie die vorhandenen
        Systeme aussehen und wie viel davon dokumentiert ist.
      </p>
      <p class="mt-3">
        Das lässt sich in einem{' '}
        <a href={withBase('/kontakt')} class="textverweis">Gespräch</a> in einer halben Stunde
        klären. Eine Preisliste würde für keinen der Fälle stimmen.
      </p>
    </Kasten>
    </div>
  </Section>

  <Section tone="canvas">
    <SectionHeading kicker="Vorgehen" title="Von der Analyse bis zum Betrieb" />
    <ol class="mt-12 rasterfugen sm:grid-cols-2 lg:grid-cols-4" data-reveal>
      {
        prozess.map((schritt) => (
          <li class="bg-surface p-7">
            <span class="zaehlziffer block text-3xl leading-none">{schritt.step}</span>
            <h3 class="mt-3 text-lg text-ink">{schritt.title}</h3>
            <p class="mt-2 text-sm text-ink-soft">{schritt.description}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  {/*
    Das Projekt, das diese Leistung belegt. Steht vor den Branchen, weil ein
    abgeschlossener Fall mehr sagt als die Einordnung in einen Wirtschaftszweig.
    Die Zuordnung kommt aus caseStudies.ts, nicht aus dieser Seite.
  */}
  {
    referenzen.length > 0 && (
      <Section>
        <SectionHeading
          kicker="Aus der Praxis"
          title={referenzen.length === 1 ? 'Ein abgeschlossenes Projekt dazu' : 'Abgeschlossene Projekte dazu'}
          lead="Mit Namen des Kunden und mit dem, was dort tatsächlich gebaut wurde."
        />
        <ul class="mt-12 rasterfugen sm:grid-cols-2" data-reveal>
          {referenzen.map((fall) => (
            <Kachel
              href={fall.href}
              kicker={fall.branche}
              title={fall.title}
              teaser={fall.excerpt}
              bild={fall.bild}
              bildAlt={fall.bildAlt}
              bildhinweis={fall.bildhinweis}
              verhaeltnis="16 / 9"
              sizes="(min-width: 640px) 50vw, 100vw"
            />
          ))}
        </ul>
      </Section>
    )
  }

  {
    passendeBranchen.length > 0 && (
      <Section>
        <SectionHeading kicker="Branchen" title="Wo dieser Bereich greift" />
        <ul class="mt-12 rasterfugen sm:grid-cols-2 lg:grid-cols-3">
          {passendeBranchen.map((branche) => (
            <Kachel
              href={`/branchen/${branche.slug}`}
              title={branche.title}
              teaser={branche.teaser}
              bild={branche.bild}
              bildAlt={branche.bildAlt}
              bildhinweis={branche.bildhinweis}
              groesse="klein"
            />
          ))}
        </ul>
      </Section>
    )
  }

  <Section tone="dark">
    <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
      <SectionHeading
        title="Klingt nach Ihrem Fall?"
        lead="Dreißig Minuten reichen für eine erste Einschätzung."
        tone="dark"
        class="max-w-2xl"
      />
      <Button href="/kontakt" variant="invers" class="shrink-0">Gespräch vereinbaren</Button>
    </div>
  </Section>
</Base>
