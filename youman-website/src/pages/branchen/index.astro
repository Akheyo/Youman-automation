---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import Textspalten from '../../components/Textspalten.astro';
import Kachel from '../../components/Kachel.astro';
import Kasten from '../../components/Kasten.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { branchen } from '../../data/branchen';
import { leistungen, anfrageHinweis } from '../../data/leistungen';
import { withBase } from '../../lib/url';

const brotkrumen = [{ label: 'Home', href: '/' }];
---

<Base
  title="Branchen: Handel, Logistik, Produktion, Handwerk"
  description="Wo youman arbeitet: E-Commerce, Spedition, Produktion, Großhandel, Handwerk und Dienstleistung. Je Branche die typischen Abläufe, an denen Arbeit hängen bleibt."
  breadcrumb={brotkrumen}
>
  <PageHeader
    kicker="Branchen"
    title="Wo wir arbeiten"
    lead="Sechs Bereiche, in denen sich dieselbe Beobachtung wiederholt: Der Aufwand steckt nicht in der eigentlichen Leistung, sondern in dem, was drumherum von Hand erledigt wird."
    breadcrumb={brotkrumen}
  />

  <Section>
    <Textspalten>
      <SectionHeading slot="titel" kicker="Zur Einordnung" title="Warum genau diese sechs" as="h2" />
      <div class="space-y-6">
        <p class="vorspann">
          Die Einteilung nach Branchen ist eine Abkürzung für Leser, keine Grenze.
        </p>
        <p class="prose-measure initiale text-lg text-ink-soft">
          Wer einen Handwerksbetrieb mit eigenem Onlineshop führt, erkennt sich in zwei
          Bereichen wieder, und wer in keinem davon vorkommt, ist deshalb nicht ausgeschlossen.
          Gemeinsam ist allen sechs, dass die Systeme grundsätzlich laufen.
        </p>
        <p class="prose-measure text-lg text-ink-soft">
          Das Problem liegt in der Lücke zwischen dem, was ein System vorsieht, und dem, was der
          Betrieb tatsächlich tut:
        </p>
        <ul class="liste-strich prose-measure space-y-3 text-ink-soft">
          <li>Angaben, die zweimal erfasst werden.</li>
          <li>Entscheidungen, die nur eine Person treffen kann.</li>
          <li>Auskünfte, die jeden Tag neu gegeben werden.</li>
        </ul>
        <p class="prose-measure text-lg text-ink-soft">
          Diese Lücke lässt sich schließen, ohne das Bestehende abzulösen.
        </p>
      </div>
    </Textspalten>
  </Section>

  {/*
    Die sechs Branchen als Kacheln, jede mit einem Bildplatz. Solange kein
    Motiv vorliegt, steht dort die reservierte Flaeche mit der Angabe, was
    hingehoert - sie hat schon jetzt das Seitenverhaeltnis des spaeteren
    Bildes, deshalb verschiebt das Nachruesten die Kachel nicht.
  */}
  <Section tone="canvas">
    <h2 class="sr-only">Branchen im Überblick</h2>
    <ul class="rasterfugen sm:grid-cols-2 lg:grid-cols-3">
      {
        branchen.map((branche) => (
          <Kachel
            href={`/branchen/${branche.slug}`}
            title={branche.title}
            teaser={branche.teaser}
            bild={branche.bild}
            bildAlt={branche.bildAlt}
            bildhinweis={branche.bildhinweis}
          />
        ))
      }
    </ul>
  </Section>

  {/*
    Leistungen als Aufklapper unter den Branchen.

    Ausdruecklich zu, solange niemand klickt: Die Seite soll den Ueberblick
    ueber die Bereiche geben, nicht fuenf Beschreibungen gleichzeitig zeigen.

    <details> und <summary> statt eigener Klapplogik. Das bringt
    Tastaturbedienung, Vorlesbarkeit und die Suchfunktion des Browsers ohne
    eine Zeile JavaScript mit, und es funktioniert auch dann, wenn Skripte
    nicht laufen.
  */}
  <Section>
    <SectionHeading
      kicker="Leistungen"
      title="Was wir in diesen Branchen bauen"
      lead="Fünf Bereiche. Aufklappen zeigt, was jeweils dahintersteckt."
    />

    <ul class="mt-12 divide-y divide-line border-y border-line">
      {
        leistungen.map((leistung, i) => (
          <li>
            <details class="group">
              <summary class="flex cursor-pointer items-center justify-between gap-6 py-6 marker:content-none [&::-webkit-details-marker]:hidden">
                <span class="flex items-baseline gap-5">
                  <span class="zaehlziffer shrink-0 text-xl leading-none">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="flex flex-col gap-1.5">
                    <span class="text-lg text-ink">{leistung.title}</span>
                    <span class="text-sm text-ink-soft">{leistung.teaser}</span>
                  </span>
                </span>
                <svg
                  class="size-5 shrink-0 text-accent transition-transform duration-200 group-open:rotate-45"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </summary>

              <div class="pb-8 lg:pl-12">
                <p class="prose-measure text-ink-soft">{leistung.intro}</p>
                <ul class="mt-6 rasterfugen sm:grid-cols-2">
                  {leistung.bausteine.map((baustein) => (
                    <li class="bg-surface p-6">
                      <h3 class="font-serif text-lg text-ink">{baustein.titel}</h3>
                      <p class="mt-2 text-pretty text-sm text-ink-soft">{baustein.text}</p>
                    </li>
                  ))}
                </ul>
                <a
                  href={withBase(`/leistungen/${leistung.slug}`)}
                  class="textverweis mt-6 inline-flex min-h-11 items-center text-sm font-semibold text-ink"
                >
                  Zur Leistung {leistung.title}
                </a>
              </div>
            </details>
          </li>
        ))
      }
    </ul>

    <Kasten titel="Nicht dabei?" class="mt-12">
      <p>{anfrageHinweis}</p>
      <a
        href={withBase('/kontakt')}
        class="textverweis mt-4 inline-flex min-h-11 items-center text-sm font-semibold text-ink"
      >
        Anfrage schreiben
      </a>
    </Kasten>
  </Section>
</Base>
