---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import Bildplatz from '../../components/Bildplatz.astro';
import Kicker from '../../components/Kicker.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import Kachel from '../../components/Kachel.astro';
import Kasten from '../../components/Kasten.astro';
import { branchen } from '../../data/branchen';
import { leistungen } from '../../data/leistungen';
import { caseStudyNach } from '../../data/caseStudies';
import { withBase } from '../../lib/url';
import { ersterSatz } from '../../lib/text';

export function getStaticPaths() {
  return branchen.map((branche) => ({
    params: { slug: branche.slug },
    props: { branche },
  }));
}

const { branche } = Astro.props;

const passendeLeistungen = leistungen.filter((l) => branche.leistungen.includes(l.slug));
const referenz = branche.referenz ? caseStudyNach(branche.referenz) : undefined;
const einleitung = ersterSatz(branche.intro);

const brotkrumen = [
  { label: 'Home', href: '/' },
  { label: 'Branchen', href: '/branchen' },
];
---

<Base
  title={branche.seoTitel ?? branche.title}
  description={branche.seoBeschreibung ?? branche.teaser}
  breadcrumb={brotkrumen}
  bild={branche.bild}
>
  <PageHeader kicker="Branchen" title={branche.title} lead={branche.teaser} breadcrumb={brotkrumen} />

  <Section>
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-6">
        <Bildplatz
          bild={branche.bild}
          alt={branche.bildAlt}
          bezeichnung={branche.bildhinweis}
          verhaeltnis="16 / 9"
          sizes="(min-width: 1024px) 48vw, 100vw"
        />
      </div>
      <div class="lg:col-span-5 lg:col-start-8">
        <Kicker>Worum es geht</Kicker>
        <p class="vorspann mt-5">{einleitung.satz}</p>
        {einleitung.rest && <p class="prose-measure mt-5 text-ink-soft">{einleitung.rest}</p>}
      </div>
    </div>
    {
      referenz && branche.referenzHinweis && (
        <Kasten titel="Aus der Praxis" class="mt-14 lg:mt-16">
          <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-center">
            <p class="text-lg text-ink">
              {branche.referenzHinweis}{' '}
              <a href={withBase(referenz.href)} class="textverweis">
                {referenz.title}
              </a>
              .
            </p>
            {referenz.kennzahl && (
              <p class="flex items-end gap-3 md:border-l md:border-line md:pl-6">
                <span class="font-display text-4xl font-normal tabular-nums leading-none text-ink">
                  {referenz.kennzahl.wert}
                </span>
                <span class="max-w-40 text-sm leading-snug text-muted-fg">
                  {referenz.kennzahl.beschreibung}
                </span>
              </p>
            )}
          </div>
        </Kasten>
      )
    }
  </Section>

  {/* Erst das Problem, dann die Antwort. Wer sein eigenes Problem oben
      wiedererkennt, liest den Rest. */}
  <Section tone="canvas">
    <SectionHeading
      kicker="Woran es hakt"
      title="Typische Problemstellungen in dieser Branche"
      lead="Wenn Ihnen davon etwas bekannt vorkommt, lohnt sich ein Gespräch. Genau an solchen Stellen setzen wir an."
    />
    <ul class="mt-12 rasterfugen sm:grid-cols-2" data-reveal>
      {
        branche.painpoints.map((punkt, i, alle) => (
          <li
            class:list={[
              'flex items-start gap-5 bg-surface p-7 md:p-8',
              /*
                Ungerade Zahl in zwei Spalten: Der letzte Eintrag zieht sich
                ueber die Reihe, sonst bleibt daneben ein Loch stehen. Das
                betraf jede Leistungs- und jede Branchenseite, weil dort
                jeweils fuenf Punkte stehen.
              */
              i === alle.length - 1 && alle.length % 2 === 1 && 'sm:col-span-2',
            ]}
          >
            <span class="zaehlziffer shrink-0 text-3xl leading-none">
              {String(i + 1).padStart(2, '0')}
            </span>
            <p class="text-pretty pt-1 text-ink-soft">{punkt}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section>
    <SectionHeading
      kicker="Leistungen"
      title="Was hier üblicherweise greift"
      lead="Meistens beginnt es an einer Stelle und wächst von dort, sobald es dort trägt."
    />
    <ul class="mt-12 rasterfugen sm:grid-cols-2 lg:grid-cols-3">
      {
        passendeLeistungen.map((leistung) => (
          <Kachel
            href={`/leistungen/${leistung.slug}`}
            title={leistung.title}
            teaser={leistung.teaser}
            bild={leistung.bild}
            bildAlt={leistung.bildAlt}
            bildhinweis={leistung.bildhinweis}
            groesse="klein"
          />
        ))
      }
    </ul>
  </Section>

  <Section tone="dark">
    <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
      <SectionHeading
        title="Passt das zu Ihrer Situation?"
        lead="Schildern Sie kurz, wo es klemmt. Wir sagen Ihnen, ob sich das automatisieren lässt."
        tone="dark"
        class="max-w-2xl"
      />
      <Button href="/kontakt" variant="invers" class="shrink-0">Kontakt aufnehmen</Button>
    </div>
  </Section>
</Base>
