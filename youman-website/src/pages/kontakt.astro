---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PlaceholderNote from '../components/PlaceholderNote.astro';
import Button from '../components/Button.astro';
import { kontakt, formularBereit, istWeb3Forms } from '../data/kontakt';
import { withBase } from '../lib/url';

const felder = [
  { id: 'name', label: 'Name', type: 'text', autocomplete: 'name', required: true },
  {
    id: 'unternehmen',
    label: 'Unternehmen',
    type: 'text',
    autocomplete: 'organization',
    required: true,
  },
  { id: 'email', label: 'E-Mail-Adresse', type: 'email', autocomplete: 'email', required: true },
  { id: 'telefon', label: 'Telefon (optional)', type: 'tel', autocomplete: 'tel', required: false },
] as const;

const brotkrumen = [{ label: 'Home', href: '/' }];

const feldKlasse =
  'mt-2 block min-h-11 w-full border border-line bg-surface px-4 py-3 text-ink transition-colors duration-200 focus:border-accent';
---

<Base
  title="Kontakt und unverbindliches Erstgespräch"
  description="Schildern Sie uns Ihren operativen Engpass. Wir melden uns mit einer ersten Einschätzung."
  breadcrumb={brotkrumen}
>
  <PageHeader
    kicker="Kontakt"
    title="Sprechen wir über Ihren Prozess"
    lead="Beschreiben Sie kurz, wo es im Tagesgeschäft klemmt und welches ERP-System im Einsatz ist. Wir melden uns mit einer ersten Einschätzung."
    breadcrumb={brotkrumen}
  />

  <Section>
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <SectionHeading as="h2" title="Direkter Draht" />
        {kontakt.terminlink && (
          <div class="mt-8 border-l-2 border-accent bg-canvas p-6">
            <p class="font-serif text-xl text-ink">Am schnellsten geht es im Gespräch.</p>
            <p class="mt-2 text-sm text-ink-soft">
              Suchen Sie sich direkt einen freien Termin aus. 30 Minuten, unverbindlich.
            </p>
            <Button href={kontakt.terminlink} class="mt-5">
              Termin auswählen
            </Button>
            <p class="mt-4 text-xs text-muted-fg">
              Die Terminauswahl öffnet Google Kalender. Dabei werden Daten an Google übertragen.
            </p>
          </div>
        )}

        {
          kontakt.email || kontakt.telefon ? (
            <dl class="mt-8 space-y-6">
              {kontakt.email && (
                <div>
                  <dt class="text-sm font-semibold text-ink">E-Mail</dt>
                  <dd class="mt-1">
                    <a
                      href={`mailto:${kontakt.email}`}
                      class="inline-flex min-h-11 items-center text-accent hover:text-accent-hover transition-colors duration-200"
                    >
                      {kontakt.email}
                    </a>
                  </dd>
                </div>
              )}
              {kontakt.telefon && (
                <div>
                  <dt class="text-sm font-semibold text-ink">Telefon</dt>
                  <dd class="mt-1">
                    <a
                      href={`tel:${kontakt.telefon.replace(/[^\d+]/g, '')}`}
                      class="inline-flex min-h-11 items-center text-accent hover:text-accent-hover transition-colors duration-200"
                    >
                      {kontakt.telefon}
                    </a>
                  </dd>
                </div>
              )}
            </dl>
          ) : (
            <div class="mt-8">
              <PlaceholderNote title="Platzhalter: Kontaktdaten fehlen noch">
                <p>
                  E-Mail-Adresse und Telefonnummer sind noch nicht hinterlegt. Sie werden als
                  Variablen <code class="px-1">KONTAKT_EMAIL</code> und
                  <code class="px-1">KONTAKT_TELEFON</code> gesetzt, in GitHub unter Settings,
                  Secrets and variables, Actions, Variables. Ein Codeeingriff ist dafür nicht
                  nötig.
                </p>
              </PlaceholderNote>
            </div>
          )
        }
      </div>

      {/* Die Kennung bleibt: sie dient als Sprungziel fuer Verweise von
          aussen. Innerhalb der Seite wird sie nicht mehr angesteuert, damit
          in der Adresszeile kein Anker auftaucht. */}
      <div id="formular">
        <SectionHeading as="h2" title="Nachricht senden" />
        {
          formularBereit ? (
            <form
              action={kontakt.formularEndpunkt}
              method="post"
              class="mt-8 space-y-6"
              data-kontaktformular
            >
              {kontakt.formularSchluessel && (
                <input type="hidden" name="access_key" value={kontakt.formularSchluessel} />
              )}
              {/*
                Der Betreff heisst je nach Dienst anders: Web3Forms liest
                `subject`, Formspree `_subject`. Das falsche Feld wuerde als
                gewoehnliche Angabe in der Mail landen statt als Betreff.
              */}
              <input
                type="hidden"
                name={istWeb3Forms ? 'subject' : '_subject'}
                value="Anfrage über die youman-Website"
              />

              {istWeb3Forms && (
                <>
                  {/*
                    Erscheint als Absendername in der Benachrichtigung, damit
                    im Postfach nicht jede Anfrage gleich aussieht.
                  */}
                  <input type="hidden" name="from_name" value="youman Website" />
                  {/*
                    Bot-Pruefung von Web3Forms: ein angehaktes Kaestchen laesst
                    der Dienst serverseitig durchfallen. Wichtig, weil der
                    eigene Honigtopf unten nur im Skript geprueft wird - ohne
                    JavaScript greift allein diese Pruefung.
                  */}
                  <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" aria-hidden="true" />
                </>
              )}

              {felder.map((feld) => (
                <div>
                  <label for={feld.id} class="block text-sm font-semibold text-ink">
                    {feld.label}
                    {feld.required && <span aria-hidden="true"> *</span>}
                  </label>
                  <input
                    id={feld.id}
                    name={feld.id}
                    type={feld.type}
                    autocomplete={feld.autocomplete}
                    required={feld.required}
                    class={feldKlasse}
                  />
                </div>
              ))}

              <div>
                <label for="nachricht" class="block text-sm font-semibold text-ink">
                  Ihre Situation <span aria-hidden="true">*</span>
                </label>
                <p id="nachricht-hinweis" class="mt-1 text-sm text-muted-fg">
                  Welcher Prozess kostet aktuell die meiste Zeit? Welches ERP-System läuft?
                </p>
                <textarea
                  id="nachricht"
                  name="nachricht"
                  rows="6"
                  required
                  aria-describedby="nachricht-hinweis"
                  class="mt-2 block w-full border border-line bg-surface px-4 py-3 text-ink transition-colors duration-200 focus:border-accent"
                />
              </div>

              {/*
                Honigtopf gegen Bots. Kein `display:none`: manche Bots
                erkennen das und lassen das Feld dann bewusst leer. Es steht
                stattdessen ausserhalb des sichtbaren Bereichs, ist fuer
                Screenreader ausgeblendet und aus der Tabreihenfolge genommen.
              */}
              <div class="absolute left-[-9999px]" aria-hidden="true">
                <label for="webseite">Dieses Feld bitte frei lassen</label>
                <input id="webseite" name="webseite" type="text" tabindex="-1" autocomplete="off" />
              </div>

              <div class="flex gap-3">
                <input
                  id="einwilligung"
                  name="einwilligung"
                  type="checkbox"
                  required
                  class="mt-1 size-5 shrink-0 border border-line accent-accent"
                />
                <label for="einwilligung" class="text-sm text-ink-soft">
                  Ich habe die{' '}
                  <a href={withBase('/datenschutz')} class="text-accent">
                    Datenschutzerklärung
                  </a>{' '}
                  zur Kenntnis genommen und bin damit einverstanden, dass meine Angaben zur
                  Bearbeitung meiner Anfrage verarbeitet werden.
                </label>
              </div>

              <button
                type="submit"
                class="druckt-sich inline-flex min-h-11 items-center justify-center bg-accent px-6 py-3 font-medium text-accent-fg transition-colors duration-200 hover:bg-accent-hover cursor-pointer"
                data-absenden
              >
                Nachricht senden
              </button>

              {/*
                Rueckmeldung ohne Seitenwechsel. Das Feld ist immer im Markup,
                damit ein Screenreader die spaetere Aenderung ankuendigen kann -
                ein erst dann eingefuegtes Element wird nicht zuverlaessig
                vorgelesen.
              */}
              <p
                class="hidden border-l-2 border-accent bg-canvas px-5 py-4 text-sm text-ink"
                role="status"
                aria-live="polite"
                data-rueckmeldung
              />
            </form>
          ) : (
            <div class="mt-8">
              <PlaceholderNote title="Formular wartet nur noch auf eine Adresse">
                <p>
                  Das vollständige Formular ist gebaut und geprüft: Beschriftungen, Pflichtfelder,
                  Einwilligung, Spamschutz und Rückmeldung ohne Seitenwechsel. Es fehlt allein die
                  Adresse, an die gesendet wird: GitHub Pages liefert nur statische Dateien und kann
                  selbst nichts entgegennehmen.
                </p>
                <p class="mt-3">
                  Konto bei <strong>Formspree</strong> oder <strong>Web3Forms</strong> anlegen, die
                  Adresse als Variable <code class="px-1">FORMULAR_ENDPUNKT</code> hinterlegen, in
                  GitHub unter Settings, Secrets and variables, Actions, Variables. Bei Web3Forms
                  zusätzlich <code class="px-1">FORMULAR_SCHLUESSEL</code>. Danach erscheint das
                  Formular beim nächsten Build von selbst.
                </p>
              </PlaceholderNote>
            </div>
          )
        }
      </div>
    </div>
  </Section>

  {/*
    Was nach der Anfrage passiert. Die Seite hatte 116 Woerter, bei vierzehn
    internen Verweisen darauf die duennste Stelle im ganzen Auftritt. Bewusst
    ohne zugesagte Antwortzeit: eine Frist, die niemand freigegeben hat,
    waere eine erfundene Zusage.
  */}
  <Section tone="canvas">
    <SectionHeading
      as="h2"
      kicker="Ablauf"
      title="Was nach Ihrer Anfrage passiert"
      lead="Kein Vertriebsprozess mit mehreren Stufen. Drei Schritte, und nach dem zweiten wissen Sie, ob sich ein Projekt lohnt."
    />
    <ol class="mt-12 rasterfugen sm:grid-cols-3" data-reveal>
      <li class="bg-surface p-7">
        <span class="zaehlziffer block text-3xl leading-none">01</span>
        <h3 class="mt-3 text-lg text-ink">Erste Einschätzung</h3>
        <p class="prose-measure mt-3 text-ink-soft">
          Wir lesen die Anfrage und antworten mit einer ersten Einordnung: ob das, was Sie
          beschreiben, in unser Feld fällt und woran wir bei einer ähnlichen Aufgabe zuerst
          denken würden. Stellt sich heraus, dass jemand anderes besser passt, sagen wir das
          und nennen, wonach Sie suchen sollten.
        </p>
      </li>
      <li class="bg-surface p-7">
        <span class="zaehlziffer block text-3xl leading-none">02</span>
        <h3 class="mt-3 text-lg text-ink">Gespräch, 30 Minuten</h3>
        <p class="prose-measure mt-3 text-ink-soft">
          Unverbindlich und ohne Präsentation. Wir fragen nach dem tatsächlichen Ablauf, nach
          den Stellen, an denen von Hand nachgeholfen wird, und nach dem System, das darunter
          liegt. Nach dem Budget fragen wir in diesem Gespräch nicht.
        </p>
      </li>
      <li class="bg-surface p-7">
        <span class="zaehlziffer block text-3xl leading-none">03</span>
        <h3 class="mt-3 text-lg text-ink">Aufwand und Zuschnitt</h3>
        <p class="prose-measure mt-3 text-ink-soft">
          Erst danach lässt sich sagen, was ein Modul umfassen müsste und in welcher
          Größenordnung der Aufwand liegt. Wenn ein kleinerer Zuschnitt den größeren Teil des
          Problems löst, schlagen wir den vor.
        </p>
      </li>
    </ol>

    <div class="prose-measure mt-16">
      <h3 class="text-2xl text-ink">Was in die erste Nachricht gehört</h3>
      <p class="prose-measure mt-4 text-ink-soft">
        Vier Angaben reichen, damit die Antwort mehr ist als eine Rückfrage:
      </p>
      <ul class="mt-6 space-y-3 text-ink-soft">
        <li>Welches ERP-System im Einsatz ist, oder dass keines läuft.</li>
        <li>
          An welcher Stelle es klemmt, möglichst an einem konkreten Vorgang statt allgemein.
          Ein Satz wie „die Versandpapiere entstehen jeden Morgen von Hand aus zwei Listen"
          sagt mehr als eine Seite Prozessbeschreibung.
        </li>
        <li>Wer im Betrieb damit arbeitet und wie viele Personen betroffen sind.</li>
        <li>Ob es dafür schon eine Behelfslösung gibt, etwa eine gewachsene Tabelle.</li>
      </ul>
      <p class="prose-measure mt-6 text-ink-soft">
        Was nicht nötig ist: ein Lastenheft, eine fertige Anforderungsliste oder eine
        Vorstellung davon, wie die Lösung aussehen soll. Das herauszufinden ist unsere
        Aufgabe, nicht Ihre Vorleistung. Wenn Sie nicht sicher sind, ob Ihr Fall passt,
        helfen die typischen Problemstellungen auf den{' '}
        <a href={withBase('/leistungen')} class="textverweis">Leistungsseiten</a> beim
        Einordnen.
      </p>
      <p class="prose-measure mt-6 text-ink-soft">
        Wir sitzen in Borken und arbeiten im gesamten deutschsprachigen Raum. Wenn Sie aus der
        Nähe kommen, ist ein Termin im Betrieb meist der schnellste Weg. Was die räumliche
        Nähe praktisch ändert und wann sie nichts ändert, steht auf der Seite{' '}
        <a href={withBase('/muensterland')} class="textverweis">Münsterland</a>.
      </p>
    </div>
  </Section>
</Base>

<script>
  /*
    Sendet das Formular im Hintergrund, damit die Person auf der Seite bleibt
    und die Rueckmeldung dort erscheint.

    Ohne JavaScript passiert nichts davon: dann greift das normale
    action/method des Formulars, der Dienst nimmt die Anfrage entgegen und
    zeigt seine eigene Bestaetigungsseite. Der Weg funktioniert also in jedem
    Fall - das Skript macht ihn nur angenehmer.
  */
  const formular = document.querySelector<HTMLFormElement>('[data-kontaktformular]');

  if (formular) {
    const knopf = formular.querySelector<HTMLButtonElement>('[data-absenden]');
    const rueckmeldung = formular.querySelector<HTMLParagraphElement>('[data-rueckmeldung]');
    const knopfText = knopf?.textContent ?? 'Nachricht senden';

    const melden = (text: string) => {
      if (!rueckmeldung) return;
      rueckmeldung.textContent = text;
      rueckmeldung.classList.remove('hidden');
    };

    formular.addEventListener('submit', async (ereignis) => {
      // Der Browser hat die Pflichtfelder bereits geprueft.
      ereignis.preventDefault();

      // Wer den Honigtopf ausgefuellt hat, ist kein Mensch. Still abbrechen
      // und Erfolg vortaeuschen - eine Fehlermeldung wuerde dem Bot verraten,
      // woran es lag.
      const honig = formular.querySelector<HTMLInputElement>('[name="webseite"]');
      if (honig?.value) {
        melden('Vielen Dank. Ihre Nachricht ist eingegangen.');
        formular.reset();
        return;
      }

      if (knopf) {
        knopf.disabled = true;
        knopf.textContent = 'Wird gesendet …';
      }

      try {
        const antwort = await fetch(formular.action, {
          method: 'POST',
          body: new FormData(formular),
          headers: { Accept: 'application/json' },
        });

        if (antwort.ok) {
          melden(
            'Vielen Dank. Ihre Nachricht ist eingegangen. Wir melden uns in der Regel innerhalb eines Werktages.',
          );
          formular.reset();
        } else {
          melden(
            `Das hat nicht geklappt (Fehler ${antwort.status}). Bitte versuchen Sie es erneut oder schreiben Sie uns direkt per E-Mail.`,
          );
        }
      } catch {
        melden(
          'Die Nachricht konnte nicht gesendet werden. Vermutlich ist die Verbindung unterbrochen. Bitte versuchen Sie es erneut oder schreiben Sie uns direkt per E-Mail.',
        );
      } finally {
        if (knopf) {
          knopf.disabled = false;
          knopf.textContent = knopfText;
        }
      }
    });
  }
</script>
