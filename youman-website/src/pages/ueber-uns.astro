---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Textspalten from '../components/Textspalten.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import Merksatz from '../components/Merksatz.astro';
import Kasten from '../components/Kasten.astro';
import Fakten from '../components/Fakten.astro';
import { site, prozess } from '../data/site';
import { anbieter } from '../data/anbieter';
import { withBase } from '../lib/url';

/**
 * Die Geschichte stammt aus dem freigegebenen Text.
 *
 * Angepasst gegenueber der ersten Fassung: Der urspruengliche Text erklaerte
 * die Luecke ausschliesslich am ERP-System, das war zu eng. Und er war auf
 * zwei Gruender geschrieben. Beides ist hier korrigiert.
 *
 * Zweite Anpassung: Der Absatz sagte "im beruflichen Umfeld von Amanuel
 * Kheyo entstehen bereits Automatisierungen" und liess offen, wo das war.
 * Genau diese Stelle traegt aber die eigene Erfahrung, den ersten
 * Buchstaben in E-E-A-T. Jetzt steht dort, was der Fall ist: gelernter
 * Kaufmann im E-Commerce, Interesse an Technik schon davor, daraus ein
 * eigenes Geschaeft im Onlinehandel, das Schritt fuer Schritt automatisiert
 * wurde. Dieselben Angaben stehen in anbieter.ts und gehen von dort in die
 * strukturierten Daten, damit sichtbarer Text und Auszeichnung nicht
 * auseinanderlaufen.
 *
 * Was NICHT drinsteht: eine erfundene Begruendung fuer die Aenderung, ein
 * Zeitraum oder ein Firmenname. Beides liegt nicht vor. Es steht schlicht,
 * was gilt.
 */
const geschichte = {
  vorspann:
    'Jedes Unternehmen macht früher oder später dieselbe Erfahrung: Die eingesetzten Systeme decken vieles ab, aber nicht alles.',
  anfang: [
    'Was übrig bleibt, sind die Abläufe, die sich nicht ins Schema pressen lassen, und die am Ende wieder in Tabellen und persönlichen Absprachen landen.',
    'Genau dort setzt youman an, gegründet 2026. Der Anlass war keine Marktlücke auf dem Papier, sondern die eigene Arbeit. Amanuel Kheyo ist gelernter Kaufmann im E-Commerce, das Interesse an Technik war schon vor der Ausbildung da. Aus beidem zusammen entstand ein eigenes Geschäft im Onlinehandel.',
    'Dieses Geschäft wurde Schritt für Schritt automatisiert, bis es ohne tägliches Zutun lief. Dabei entstanden die Workflow-Automatisierungen und Softwaremodule, aus denen später youman wurde. Immer dieselbe Sorte Problem, immer dieselbe Sorte Lösung: Was das System nicht abdeckt, macht ein Mensch von Hand, jeden Tag aufs Neue.',
  ],
  /* Der Satz, der bleiben soll. Er steht als Merksatz zwischen den Absaetzen,
     nicht zusaetzlich im Fliesstext. */
  merksatz: 'Was hier fehlt, muss gebaut werden, nicht nur beschrieben.',
  ende: [
    'Daraus wurde eine Überzeugung, die bis heute die Arbeitsweise bestimmt. Eine Empfehlung, die niemand umsetzt, hat den Betrieb keinen Schritt weitergebracht. Und wer einen Ablauf im eigenen Geschäft automatisiert hat, kennt die Stellen, an denen so etwas in der Praxis hakt, aus eigener Anschauung.',
    'Der Anspruch dabei bleibt gleich: Kein bestehendes System wird ersetzt. Jede Lösung entsteht dort, wo ein Unternehmen sie tatsächlich braucht, und hängt an dem, was ohnehin schon läuft.',
  ],
};

const fakten = [
  { wert: site.gruendungsjahr, label: 'Gegründet' },
  ...(anbieter.ort ? [{ wert: anbieter.ort, label: 'Sitz' }] : []),
  { wert: 'DACH', label: 'Arbeitsraum' },
  { wert: String(prozess.length), label: 'Schritte je Projekt' },
];

const werte = [
  {
    titel: 'Ehrlichkeit',
    text: 'Wir nennen Risiken, Aufwände und Grenzen einer Lösung offen, auch wenn das kurzfristig unbequem ist. Wenn ein Vorhaben sich nicht lohnt, sagen wir das, bevor es beauftragt wird.',
  },
  {
    titel: 'Transparenz',
    text: 'Sie sehen, woran gearbeitet wird und wo es steht. Keine Blackbox, aus der nach Monaten ein fertiges Ergebnis fällt.',
  },
  {
    titel: 'Verlässlichkeit',
    text: 'Zusagen werden gehalten oder rechtzeitig zurückgezogen. Ein zu spät gemeldeter Verzug ist teurer als ein früh gemeldeter.',
  },
  {
    titel: 'Nachvollziehbarkeit',
    text: 'Was wir bauen, ist dokumentiert und übergebbar. Sie sollen nicht von uns abhängig sein, sondern uns behalten, weil es passt.',
  },
];

/* Die betreibende Person. Eine einzige Quelle fuer Impressum, sichtbaren
   Text und strukturierte Daten. */
const person = anbieter.personen[0];

const brotkrumen = [{ label: 'Home', href: '/' }];
---

<Base
  title="Über uns: KI-Automation und Softwareentwicklung"
  description="youman verbindet Prozessanalyse mit Softwareentwicklung: erst verstehen, warum ein Ablauf hakt, dann das Fehlende bauen. Gegründet 2026 in Borken."
  breadcrumb={brotkrumen}
>
  <PageHeader
    kicker="Über uns"
    title={`Wer hinter ${site.name} steht`}
    lead="Analyse und Umsetzung in einer Hand: erst verstehen, warum ein Ablauf hakt, dann das Fehlende bauen."
    breadcrumb={brotkrumen}
  />

  {/*
    Ohne Bild.

    Hier stand eine reservierte Flaeche fuer ein Portraet des Gruenders. Ein
    Portraet ist auf einer Seite ueber die Menschen hinter einer Firma das
    naheliegende Motiv, es ist aber ausdruecklich nicht gewuenscht, und ein
    Platzhalter, der nie besetzt wird, ist schlechter als gar keine Flaeche:
    Er sieht dauerhaft nach Baustelle aus.

    Was das Bild geleistet haette, uebernimmt jetzt der Kasten rechts. Ein
    Portraet beantwortet auf so einer Seite die Frage "mit wem habe ich es zu
    tun". Diese Frage laesst sich auch in Worten beantworten, und zwar
    genauer: Name, Rolle und Ausbildung sagen mehr darueber, ob jemand die
    Richtige oder der Richtige fuer ein Vorhaben ist, als ein Gesicht.

    Der Abschnitt steht dafuer zweispaltig wie auf den Unterseiten. Ohne die
    zweite Spalte bliebe auf breiten Bildschirmen die halbe Flaeche leer, und
    genau das war der Grund, warum hier ueberhaupt ein Bild stand.
  */}
  <Section tone="canvas">
    <Textspalten>
      <SectionHeading
        slot="titel"
        kicker="Analyse und Umsetzung"
        title="Zwei Dinge, die sonst getrennt eingekauft werden"
      />
      <div>
        <p class="vorspann">
          {site.name} ist kein reines Beratungshaus, das Empfehlungen ausspricht. Und kein
          Anbieter, der ein fertiges Produkt verkauft, in das der Betrieb hineinpassen muss.
        </p>
        <p class="prose-measure mt-5 text-ink-soft">
          Wir tun beides: Wir analysieren den Ablauf, und wir bauen die Lösung dafür. Der
          Unterschied zeigt sich in der Praxis daran, wer die Verantwortung trägt, wenn etwas
          nicht funktioniert. Wo Beratung und Umsetzung getrennt eingekauft werden, zeigen im
          Zweifel beide aufeinander. Hier gibt es diese Trennung nicht.
        </p>
        {/*
          Die Angaben stammen aus anbieter.ts, derselben Quelle, aus der auch
          das Impressum und der Person-Knoten in den strukturierten Daten
          erzeugt werden. Damit steht der Name genau einmal im Projekt.
        */}
        <Kasten titel="Wer dahintersteht" tone="muted" class="mt-10">
          <p>
            <strong class="font-semibold text-ink">{person.name}</strong>, {person.rolle},
            gelernter {person.ausbildung}.
          </p>
          <p class="mt-3">
            Wie aus einem eigenen Geschäft im Onlinehandel die Automatisierungen wurden, aus
            denen {site.name} entstanden ist, steht weiter unten unter Geschichte.
          </p>
        </Kasten>
      </div>
    </Textspalten>

    <Fakten eintraege={fakten} class="mt-16 md:mt-20" />
  </Section>

  <Section>
    <Textspalten>
      <SectionHeading slot="titel" kicker={site.name} title="Geschichte" />
      <div class="space-y-5">
        <p class="vorspann">{geschichte.vorspann}</p>
        {geschichte.anfang.map((absatz) => <p class="prose-measure text-ink-soft">{absatz}</p>)}
        <Merksatz class="my-10">{geschichte.merksatz}</Merksatz>
        {geschichte.ende.map((absatz) => <p class="prose-measure text-ink-soft">{absatz}</p>)}
      </div>
    </Textspalten>
  </Section>

  <Section tone="canvas">
    <SectionHeading
      kicker="Vorgehen"
      title="Wie ein Projekt abläuft"
      lead="Vier Schritte. Nach dem zweiten wissen Sie, ob sich das Vorhaben lohnt."
    />
    <ol class="mt-12 rasterfugen sm:grid-cols-2 lg:grid-cols-4" data-reveal>
      {
        prozess.map((schritt) => (
          <li class="bg-surface p-7">
            <span class="zaehlziffer block text-3xl leading-none">{schritt.step}</span>
            <h3 class="mt-3 text-lg text-ink">{schritt.title}</h3>
            <p class="mt-2 text-sm text-ink-soft">{schritt.description}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section>
    <SectionHeading kicker={site.name} title="Werte" />
    <dl class="mt-12 rasterfugen sm:grid-cols-2" data-reveal>
      {
        werte.map((wert, i) => (
          <div class="bg-surface p-7 md:p-8">
            <span class="zaehlziffer block text-3xl leading-none" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <dt class="mt-4 font-serif text-xl text-ink">{wert.titel}</dt>
            <dd class="mt-2.5 text-pretty text-ink-soft">{wert.text}</dd>
          </div>
        ))
      }
    </dl>
    <div class="mt-12 border-t border-line pt-8 md:flex md:items-baseline md:gap-12">
      <p class="zwischenzeile shrink-0 text-ink">Standort</p>
      <p class="prose-measure mt-3 text-lg text-ink-soft md:mt-0">
        Unser Sitz ist {anbieter.ort}, gearbeitet wird im gesamten deutschsprachigen Raum. Was
        die räumliche Nähe an einem Projekt praktisch ändert und an welchen Stellen sie nichts
        ändert, haben wir auf der Seite{' '}
        <a href={withBase('/muensterland')} class="textverweis">Münsterland</a> aufgeschrieben.
      </p>
    </div>
  </Section>

  <Section tone="dark">
    <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
      <SectionHeading
        title="Klingt nach der richtigen Herangehensweise?"
        lead="Dann beschreiben Sie uns kurz, woran es bei Ihnen hängt."
        tone="dark"
        class="max-w-2xl"
      />
      <Button href="/kontakt" variant="invers" class="shrink-0">Kontakt aufnehmen</Button>
    </div>
  </Section>
</Base>
