---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Bildplatz from '../../components/Bildplatz.astro';
import Section from '../../components/Section.astro';
import Textspalten from '../../components/Textspalten.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import Merksatz from '../../components/Merksatz.astro';
import { caseStudyNach, andereReferenzen } from '../../data/caseStudies';
import Kachel from '../../components/Kachel.astro';

/**
 * Quelle: die gelieferte Case-Study-Unterlage zu Drahtmüller und "Überblick wer wir sind.pdf".
 * Bewusst NICHT enthalten: Einsparungs- oder Prozentangaben und Kundenstimmen –
 * dafür liegt bislang nichts Freigegebenes vor.
 */

const fall = caseStudyNach('drahtmueller-palettenoptimierung')!;
const weitere = andereReferenzen('drahtmueller-palettenoptimierung');

const folgen = [
  'Hoher Planungsaufwand bei jeder neuen Auftragssituation.',
  'Fehlende Standardisierung bei wiederkehrenden Palettenmaßen.',
  'Hohe Komplexität in Beschaffung und Disposition durch 2.556 aktive Palettentypen.',
  'Keine direkte Verbindung zwischen Auftragseingang und Palettenplanung im ERP-System.',
];

const berechnung = [
  'Welche Standardpaletten verwendet werden können.',
  'Welche Sonderpaletten gefertigt werden müssen.',
  'Wie viele Einheiten pro Typ benötigt werden.',
];

const vorgehen = [
  {
    step: '01',
    title: 'Analyse',
    text: 'Der bestehende Prozess vom Auftragseingang bis zur Palettenentscheidung wurde detailliert aufgenommen: Auftragsdaten, Entscheidungsregeln, Maßlogiken und Schnittstellen im operativen Ablauf.',
  },
  {
    step: '02',
    title: 'Konzept',
    text: 'Darauf aufbauend entstand ein Lösungsdesign, das sowohl die fachliche Logik für Standard- und Sonderpaletten als auch die technische Integration in die bestehende ERP-Landschaft berücksichtigt.',
  },
  {
    step: '03',
    title: 'Entwicklung',
    text: 'Das kundenspezifische Modul wurde innerhalb des Systems entwickelt. Im Fokus stand nicht eine allgemeine Standardfunktion, sondern die präzise digitale Abbildung des tatsächlichen Fachprozesses.',
  },
  {
    step: '04',
    title: 'Integration',
    text: 'Anschließend wurde das Modul an das ERP-System angebunden, sodass relevante Auftragsdaten automatisiert übernommen, verarbeitet und in den bestehenden Prozess zurückgeführt werden.',
  },
];
---

<Base
  title="Palettenoptimierung bei der Drahtmüller GmbH"
  description="2.556 aktive Palettentypen, jede Entscheidung ein Einzelfall: Wie ein Modul von youman die Palettenlogik an das ERP-System anbindet, ohne Systemablösung."
  breadcrumb={[
    { label: 'Home', href: '/' },
    { label: 'Referenzprojekte', href: '/case-studies/' },
  ]}
  artikel={{
    titel: 'Palettenoptimierung bei der Drahtmüller GmbH',
    beschreibung:
      '2.556 aktive Palettentypen, jede Entscheidung ein Einzelfall: Wie ein Modul von youman die Palettenlogik an das ERP-System anbindet, ohne Systemablösung.',
    datum: null,
  }}
  bild={fall.bild}
>
  <PageHeader
    kicker="Referenzprojekt"
    title="Palettenoptimierung bei der Drahtmüller GmbH"
    lead="Drahtmüller GmbH / Lichtgitter-Gruppe, Palettenoptimierung und Logistiksoftware via youman"
    breadcrumb={[
      { label: 'Home', href: '/' },
      { label: 'Referenzprojekte', href: '/case-studies/' },
    ]}
  />

  <Section tone="canvas">
    <Bildplatz
      bild={fall.bild}
      alt={fall.bildAlt}
      bezeichnung="Gitterroste in Transportgestellen"
      verhaeltnis="16 / 9"
      sizes="(min-width: 1024px) 64rem, 100vw"
      class="mx-auto max-w-5xl border border-line"
    />
  </Section>

  <Section>
    <div class="grid gap-12 lg:grid-cols-[2fr_1fr] lg:gap-20">
      <div class="space-y-5">
        <p class="vorspann">
          Drahtmüller produziert Gitterdrähte nach kundenindividuellen Maßen.
        </p>
        <p class="prose-measure initiale text-lg text-ink-soft">
          Dadurch entstehen auch bei den Versandpaletten stark variierende Anforderungen, da
          Paletten passgenau zur jeweiligen Produktion gefertigt oder beschafft werden müssen.
        </p>
        <p class="prose-measure text-lg text-ink-soft">
          youman entwickelte für diesen Engpass ein kundenspezifisches Palettenoptimierungs-Modul,
          das direkt an das vorhandene ERP-System angebunden ist und relevante Auftragsdaten
          automatisiert verarbeitet. Die Case Study zeigt exemplarisch, wie sich operative
          Sonderlogik digital abbilden lässt, ohne die bestehende Systemlandschaft abzulösen.
        </p>
      </div>

      <aside class="kasten bg-canvas">
        <p class="font-display text-5xl font-normal tabular-nums text-ink">2.556</p>
        <p class="mt-2 text-sm text-ink-soft">
          verschiedene Palettentypen waren im aktiven Einsatz.
        </p>
        <dl class="mt-8 space-y-4 border-t border-line pt-6 text-sm">
          <div>
            <dt class="font-semibold text-ink">Branche</dt>
            <dd class="text-ink-soft">Fertigung und Logistik</dd>
          </div>
          <div>
            <dt class="font-semibold text-ink">Lösung</dt>
            <dd class="text-ink-soft">Palettenoptimierungs-Modul im youman-Gerüst</dd>
          </div>
          <div>
            <dt class="font-semibold text-ink">Anbindung</dt>
            <dd class="text-ink-soft">API-Schnittstelle zum bestehenden ERP-System</dd>
          </div>
        </dl>
      </aside>
    </div>
  </Section>

  <Section tone="canvas">
    <SectionHeading
      kicker="Ausgangssituation"
      title="Jeder Auftrag ein Einzelfall"
      lead="Bei Drahtmüller musste für viele Kundenaufträge individuell entschieden werden, welche Paletten benötigt werden und ob bestehende Varianten wiederverwendet werden können. Da jeder Auftrag andere Abmessungen aufweist, entstand eine hohe Zahl an Sonderfällen, die im Tagesgeschäft manuell bewertet und eingeplant werden mussten."
    />
    <ul class="mt-12 rasterfugen md:grid-cols-2" data-reveal>
      {
        folgen.map((folge, i) => (
          <li class="flex items-start gap-5 bg-surface p-7 md:p-8">
            <span class="zaehlziffer shrink-0 text-3xl leading-none">
              {String(i + 1).padStart(2, '0')}
            </span>
            <p class="text-pretty pt-1 text-ink-soft">{folge}</p>
          </li>
        ))
      }
    </ul>
    <Merksatz class="mt-14 max-w-4xl">
      In einem variantengetriebenen Umfeld werden operative Entscheidungen so unnötig aufwendig,
      fehleranfällig und schwer skalierbar.
    </Merksatz>
  </Section>

  <Section>
    <Textspalten>
      <SectionHeading
        slot="titel"
        kicker="Herausforderung"
        title="Nicht das ERP fehlte, sondern die Logik davor"
      />
      <div class="space-y-5">
        <p class="vorspann">
          Die zentrale Herausforderung bestand nicht im Fehlen eines ERP-Systems, sondern in der
          fehlenden operativen Logik zwischen Auftragseingang und Palettenentscheidung.
        </p>
        <p class="prose-measure text-lg text-ink-soft">
          Wiederkehrende Maße wurden nicht systematisch als Standardfälle erkannt, sodass viele
          Vorgänge immer wieder als Einzelfall behandelt werden mussten.
        </p>
        <p class="prose-measure text-lg text-ink-soft">
          Gesucht war deshalb keine zusätzliche Inselsoftware, sondern eine Lösung, die sich in die
          bestehende Systemlandschaft einfügt und genau den Prozess digitalisiert, der im Tagesgeschäft
          den größten Engpass verursacht.
        </p>
      </div>
    </Textspalten>
  </Section>

  <Section tone="dark">
    <SectionHeading
      kicker="Lösung"
      title="Ein Modul als eigenständiges Modul, angebunden per API"
      lead="Das Modul liest alle relevanten Auftragsdaten automatisiert aus und verarbeitet sie unmittelbar nach Auftragseingang."
      tone="dark"
    />

    <div class="mt-14 grid gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <h3 class="text-lg text-white">Die Kernfunktion berechnet automatisch:</h3>
        <ol class="liste-nummern mt-6 space-y-4 text-white/85">
          {berechnung.map((punkt) => <li>{punkt}</li>)}
        </ol>
      </div>

      <div>
        <Merksatz kicker="Die entscheidende Logik">
          Ab einer Mindestbestellmenge von fünf identischen Maßen klassifiziert die Software eine
          Palette automatisch als Standardpalette und führt sie dauerhaft im Sortiment.
        </Merksatz>
        <p class="mt-6 text-white/80">
          Seltener auftretende Maße werden weiterhin als Sonderpaletten behandelt, durch die neue
          Systematik jedoch deutlich strukturierter abgebildet.
        </p>
      </div>
    </div>
  </Section>

  <Section>
    <SectionHeading
      kicker="Vorgehen"
      title="In klaren Schritten umgesetzt"
      lead="Das Projekt folgte dem allgemeinen Vorgehensmodell von youman."
    />
    <ol class="mt-12 rasterfugen md:grid-cols-2 xl:grid-cols-4">
      {
        vorgehen.map((schritt) => (
          <li class="bg-surface p-7 md:p-8">
            <span class="zaehlziffer block text-3xl leading-none">{schritt.step}</span>
            <h3 class="mt-4 text-xl text-ink">{schritt.title}</h3>
            <p class="mt-3 text-pretty text-sm text-ink-soft">{schritt.text}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  {/*
    Das jeweils andere Projekt. Beide Fallseiten hingen vorher mit vier und
    fuenf eingehenden Verweisen am Rand der Seite, ohne Verbindung
    untereinander. Wer einen Fall gelesen hat, ist genau der Leser fuer den
    zweiten.
  */}
  {
    weitere.length > 0 && (
      <Section>
        <SectionHeading kicker="Weiteres Projekt" title="Auch abgeschlossen" />
        <ul class="mt-12 rasterfugen sm:grid-cols-2" data-reveal>
          {weitere.map((fall) => (
            <Kachel
              href={fall.href}
              kicker={fall.branche}
              title={fall.title}
              teaser={fall.excerpt}
              bild={fall.bild}
              bildAlt={fall.bildAlt}
              bildhinweis={fall.bildhinweis}
              verhaeltnis="16 / 9"
              sizes="(min-width: 640px) 50vw, 100vw"
            />
          ))}
        </ul>
      </Section>
    )
  }

  {/*
    Hier stand vorher ein halbes SectionHeading ohne oeffnendes Tag, und
    Astro gab die Attribute als Text aus: kicker="Ergebnis" title=... stand
    lesbar auf der Seite. Jetzt wieder ein vollstaendiger Kopf.
  */}
  <Section tone="dark">
    <SectionHeading
      kicker="Ergebnis"
      title="Aus manueller Bewertung wird ein strukturierter Prozess"
      tone="dark"
    />
    <p class="vorspann mt-8 max-w-3xl">
      Mit dem neuen Modul wurde die zuvor manuelle Palettenlogik in einen klar strukturierten,
      systemisch unterstützten Prozess überführt.
    </p>
    <p class="prose-measure mt-5 text-lg text-white/80">
      Wiederkehrende Maße können automatisiert erkannt und als Standardfälle behandelt werden,
      während Sonderfälle gezielter und nachvollziehbarer gesteuert werden.
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <Button href="/kontakt" variant="invers">Ähnlichen Fall besprechen</Button>
      <Button href="/leistungen/individuelle-software" variant="ghost">
        Individuelle Software
      </Button>
    </div>
  </Section>
</Base>
