---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import Logo from '../components/Logo.astro';
import Bildplatz from '../components/Bildplatz.astro';
import { site } from '../data/site';
import { leistungen, anfrageHinweis } from '../data/leistungen';
import { branchen } from '../data/branchen';
import { caseStudies } from '../data/caseStudies';
import { withBase } from '../lib/url';
---

<Base title={site.name} description={site.startseitenBeschreibung}>
  {/*
    Der Hero traegt die Wortmarke statt eines Videos. Ohne Bildmaterial muss
    die Typografie die Wirkung uebernehmen, deshalb hier die einzige Stelle,
    an der die Marke gross gesetzt wird. Kein Video heisst auch: nichts, was
    nachlaedt, nichts, was springt, und mehrere Megabyte weniger.
  */}
  <section class="on-dark relative isolate flex min-h-[calc(100svh-5rem)] flex-col justify-center bg-ink-deep py-24 text-white">
    <div class="container-page">
      <Logo as="h1" variant="light" mitClaim class="text-[2.25rem] sm:text-6xl lg:text-8xl" />

      <p class="prose-measure mt-12 text-xl text-white/85 sm:text-2xl">
        Wir automatisieren, was in Ihrem Betrieb jeden Tag Zeit kostet: Anfragen, die von Hand
        sortiert werden, Angaben, die zweimal erfasst werden, Auskünfte, die immer wieder
        dieselben sind.
      </p>

      <div class="mt-12 flex flex-wrap gap-4">
        <Button href="/kontakt" variant="ghost">Gespräch vereinbaren</Button>
        <Button href="/leistungen" variant="ghost">Leistungen ansehen</Button>
      </div>
    </div>
  </section>

  {/* Einordnung direkt unter dem Hero: Wer hier landet, soll nach zwei
      Saetzen wissen, worum es geht. */}
  <Section>
    <div class="prose-measure space-y-6 text-lg text-ink-soft">
      <p>
        {site.name} verbindet zwei Dinge, die sonst getrennt eingekauft werden: Wir sehen uns
        den Ablauf an, um den es geht, und wir bauen anschließend die Lösung dafür. Kein
        Beratungshaus, das Empfehlungen ausspricht, und kein Anbieter, der ein fertiges Produkt
        verkauft, in das der Betrieb hineinpassen muss.
      </p>
      <p>
        Das Ergebnis hängt an dem, was schon läuft, und ersetzt es nicht. Buchhaltung, Lager
        und Stammdaten bleiben, wo sie sind. Dazu kommt genau das Stück, das bisher von Hand
        erledigt wurde.
      </p>
    </div>
  </Section>

  {/*
    Bildplatz statt Bild. Die Flaeche steht schon in ihrem spaeteren
    Seitenverhaeltnis, damit das Nachruesten das Layout nicht verschiebt.
    In `Bildplatz.astro` steht, wie ein Bild eingesetzt wird.
  */}
  <Section tone="canvas">
    <Bildplatz
      bezeichnung="Startseite: ein Motiv aus der Arbeit"
      verhaeltnis="16 / 9"
      sizes="(min-width: 1280px) 1200px, 100vw"
    />
  </Section>

  <Section>
    <SectionHeading
      kicker="Leistungen"
      title="Was wir bauen"
      lead="Fünf Bereiche, gegliedert nach dem, was gesucht wird."
    />
    <ul class="mt-12 rasterfugen sm:grid-cols-2 lg:grid-cols-3" data-reveal>
      {
        leistungen.map((leistung) => (
          <li class="hebt-sich bg-surface">
            <a
              href={withBase(`/leistungen/${leistung.slug}`)}
              class="group flex h-full flex-col p-8 transition-colors duration-200"
            >
              <h3 class="text-xl text-ink group-hover:text-accent transition-colors duration-200">
                {leistung.title}
              </h3>
              <p class="prose-measure mt-3 text-ink-soft">{leistung.teaser}</p>
            </a>
          </li>
        ))
      }
      <li class="bg-muted p-8">
        <h3 class="text-xl text-ink">Nicht dabei?</h3>
        <p class="prose-measure mt-3 text-ink-soft">
          Dann fragen Sie an. Wir sagen Ihnen ehrlich, ob wir die Richtigen dafür sind.
        </p>
        <a
          href={withBase('/kontakt')}
          class="textverweis mt-5 inline-flex min-h-11 items-center text-sm font-semibold text-ink"
        >
          Anfrage schreiben
        </a>
      </li>
    </ul>
  </Section>

  <Section tone="canvas">
    <SectionHeading
      kicker="Branchen"
      title="Wo wir arbeiten"
      lead="Eine Abkürzung für Leser, keine Grenze. Wer hier nicht vorkommt, ist nicht ausgeschlossen."
    />
    <ul class="mt-12 rasterfugen sm:grid-cols-2 lg:grid-cols-3" data-reveal>
      {
        branchen.map((branche) => (
          <li class="hebt-sich bg-surface">
            <a
              href={withBase(`/branchen/${branche.slug}`)}
              class="group flex h-full flex-col p-7 transition-colors duration-200"
            >
              <h3 class="text-lg text-ink group-hover:text-accent transition-colors duration-200">
                {branche.title}
              </h3>
              <p class="mt-3 text-sm text-ink-soft">{branche.teaser}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section>
    <SectionHeading
      kicker="Referenzprojekte"
      title="Abgeschlossene Projekte"
      lead="Beide mit Namen des Kunden. Ohne Einsparquoten, weil dafür nichts Belegtes vorliegt."
    />
    <ul class="mt-12 rasterfugen sm:grid-cols-2" data-reveal>
      {
        caseStudies.map((fall) => (
          <li class="hebt-sich bg-surface">
            <a
              href={withBase(fall.href)}
              class="group flex h-full flex-col p-8 transition-colors duration-200"
            >
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">
                {fall.branche}
              </p>
              <h3 class="mt-3 text-xl text-ink group-hover:text-accent transition-colors duration-200">
                {fall.title}
              </h3>
              <p class="prose-measure mt-3 text-ink-soft">{fall.excerpt}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section tone="canvas">
    <p class="prose-measure text-lg text-ink-soft">{anfrageHinweis}</p>
  </Section>

  <Section tone="dark">
    <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
      <SectionHeading
        title="Wo klemmt es bei Ihnen?"
        lead="Beschreiben Sie kurz einen Vorgang, der zu viel Zeit kostet. Das reicht für eine erste Einschätzung."
        tone="dark"
        class="max-w-2xl"
      />
      <Button href="/kontakt" variant="ghost" class="shrink-0">Gespräch vereinbaren</Button>
    </div>
  </Section>
</Base>
