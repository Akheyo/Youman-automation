{
  "name": "@youman/desktop",
  "version": "1.1.29",
  "description": "adept& – Universal Business Process Desktop App",
  "main": "./electron/dist/main.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development concurrently \"tsc -p electron/tsconfig.json --watch\" \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsup && vite build",
    "dist": "pnpm build && electron-builder",
    "release": "pnpm build && electron-builder --publish always",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src electron --ext .ts,.tsx"
  },
  "dependencies": {
    "@youman/shared": "workspace:*",
    "@youman/config-engine": "workspace:*",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@tanstack/react-query": "^5.45.1",
    "@tanstack/react-table": "^8.17.3",
    "axios": "^1.7.2",
    "better-sqlite3": "^11.0.0",
    "bindings": "^1.5.0",
    "file-uri-to-path": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.396.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.0",
    "react-router-dom": "^6.24.0",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^10.0.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.4",
    "@hookform/resolvers": "^3.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.1.2",
    "electron-builder": "^24.13.3",
    "electron-updater": "^6.3.9",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "de.adept.desktop",
    "productName": "adept&",
    "npmRebuild": false,
    "directories": {
      "output": "dist-electron"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "akheyo",
        "repo": "Youman-automation",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "de_DE",
        "en_US"
      ],
      "language": "1031"
    },
    "files": [
      "electron/dist/**",
      "dist/**",
      "node_modules/better-sqlite3/**",
      "node_modules/bindings/**",
      "node_modules/file-uri-to-path/**"
    ]
  }
}
