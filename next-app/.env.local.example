# Public Mapbox token used in the browser by Mapbox GL JS.
# Restrict it to your domain in https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_public_token_here

# Optional secret token for server-side Geocoding requests.
# If empty, the public token above is used.
MAPBOX_SECRET_TOKEN=

# Optional: override the default OSM Overpass mirror used by the building API.
# Leave empty to use the built-in mirror cascade.
OVERPASS_URL=
