---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import TeaserCard from '../../components/TeaserCard.astro';
import PlaceholderNote from '../../components/PlaceholderNote.astro';
import { news } from '../../data/news';
import { withBase } from '../../lib/url';

const veroeffentlicht = news.filter((item) => !item.platzhalter);
const offen = news.filter((item) => item.platzhalter);
---

<Base
  title="News"
  description="Meldungen und Beiträge von adept& zu ERP-Integration, SAP-Anbindung, Individualsoftware und Prozessberatung im Betrieb."
  bild="material"
  breadcrumb={[{ label: 'Home', href: '/' }]}
>
  <PageHeader kicker="News" bild="material" title="Aktuelle Themen" breadcrumb={[{ label: 'Home', href: '/' }]} />

  <Section>
    <h2 class="sr-only">Veröffentlichte Beiträge</h2>
    <ul class="grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {
        veroeffentlicht.map((item, index) => (
          <li>
            <TeaserCard
              title={item.title}
              href={item.href}
              kicker={item.kicker}
              date={item.date}
              excerpt={item.excerpt}
              bild={item.bild}
              index={index}
            />
          </li>
        ))
      }
    </ul>

    {
      offen.length > 0 && (
        <div class="mt-16">
          <PlaceholderNote title={`Platzhalter – ${offen.length} weitere Beiträge offen`}>
            <p>
              Hier stehen Meldungen und Beiträge. Abgeschlossene Kundenprojekte finden Sie unter
              <a href={withBase('/case-studies')} class="text-accent">Case Studies</a>.
            </p>
            <p>
              Für „Aktuelle Themen“ liegen noch keine freigegebenen Inhalte vor. Sobald Titel,
              Datum, Text und Bild vorliegen, werden sie in
              <code class="px-1">src/data/news.ts</code> ergänzt.
            </p>
          </PlaceholderNote>
        </div>
      )
    }
  </Section>
</Base>
