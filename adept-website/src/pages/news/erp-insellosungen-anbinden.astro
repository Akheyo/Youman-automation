---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import { news } from '../../data/news';
import { withBase } from '../../lib/url';

/**
 * Fachbeitrag, keine Case Study und keine Meldung ueber ein Projekt.
 *
 * Bewusst ohne fremde Zahlen und ohne Studienzitate: der Beitrag lebt von
 * Erfahrung mit dem Problem, nicht von Prognosen. Wo keine Quelle steht,
 * steht auch keine Zahl. Das ist der Unterschied zum Logistik-Beitrag, der
 * seine vier Werte ausdruecklich Gartner zuschreibt.
 *
 * Ebenso ohne Aussagen darueber, was adept& in einem konkreten Projekt
 * erreicht hat. Solche Aussagen gehoeren in die Referenzprojekte, wo sie
 * belegt sind.
 */

const beitrag = news.find((e) => e.slug === 'erp-insellosungen-anbinden')!;

const BESCHREIBUNG =
  'Warum Ablöseprojekte scheitern, obwohl das alte System das Problem ist: Woran man erkennt, dass eine Anbindung reicht, und woran, dass sie es nicht tut.';

const gruende = [
  {
    titel: 'Das Wissen steckt in den Ausnahmen',
    text: 'Ein gewachsenes System bildet nicht nur den Prozess ab, sondern jede Ausnahme, die in Jahren dazugekommen ist. Diese Ausnahmen stehen nirgends geschrieben. Sie tauchen erst auf, wenn im neuen System etwas nicht geht, das vorher ging.',
  },
  {
    titel: 'Die Umstellung bindet die Falschen',
    text: 'Ein Wechsel braucht über die gesamte Laufzeit genau die Leute, die den Betrieb am besten kennen. Dieselben Leute halten währenddessen das Tagesgeschäft am Laufen. Beides gleichzeitig geht selten gut aus, und meistens leidet das Projekt zuerst.',
  },
  {
    titel: 'Am Ende steht ein anderer Satz Kompromisse',
    text: 'Auch das neue System bildet den eigenen Sonderfall nicht ab. Es bildet einen anderen Standard ab. Die Tabellen daneben verschwinden nicht, sie werden nur neu gebaut.',
  },
];

const wannAnbindung = [
  'Das bestehende System führt die Stammdaten zuverlässig, und niemand bestreitet, welcher Stand der richtige ist.',
  'Das Problem lässt sich an einem konkreten Vorgang festmachen statt an einem Gefühl, dass alles zu umständlich sei.',
  'Es gibt eine Schnittstelle oder wenigstens einen dokumentierten Weg, Daten aus dem System heraus und wieder hinein zu bekommen.',
  'Der Sonderfall, um den es geht, ist fachlich beschreibbar. Wer ihn erklären kann, kann ihn auch als Regel hinterlegen lassen.',
];

const wannNicht = [
  'Die Stammdaten selbst sind unzuverlässig. Eine Anbindung verteilt dann nur schneller, was ohnehin falsch ist.',
  'Der Hersteller stellt das System ein oder liefert keine Sicherheitsaktualisierungen mehr. Das ist kein Prozessproblem, sondern ein Risiko.',
  'Es gibt keinen Weg an die Daten, weder über eine Schnittstelle noch über die Datenbank, und der Hersteller öffnet keinen.',
  'Das System bildet den Kernprozess des Betriebs schon im Grundsatz nicht ab, nicht nur dessen Ausnahmen.',
];

const brotkrumen = [
  { label: 'Home', href: '/' },
  { label: 'News', href: '/news' },
];
---

<Base
  title="ERP-Insellösungen anbinden statt wechseln"
  description={BESCHREIBUNG}
  bild={beitrag.bild}
  breadcrumb={brotkrumen}
  artikel={{ titel: beitrag.title, beschreibung: BESCHREIBUNG, datum: beitrag.date }}
>
  <PageHeader
    kicker="Praxis"
    bild={beitrag.bild}
    title="ERP-Insellösungen anbinden statt das System wechseln"
    lead="Der Wunsch nach einem sauberen Neuanfang ist verständlich. Er ist nur selten die günstigste Antwort auf das Problem, das ihn ausgelöst hat."
    breadcrumb={brotkrumen}
  />

  <Section>
    <div class="prose-measure space-y-5 text-lg text-ink-soft">
      <p>
        Der Satz fällt in fast jedem ersten Gespräch: „Eigentlich müssten wir das ganze System
        mal ablösen." Dahinter steckt meistens kein Fehler im System, sondern eine Stelle im
        Ablauf, an der seit Jahren von Hand nachgeholfen wird. Jemand exportiert morgens eine
        Liste, gleicht sie mit einer zweiten ab und trägt das Ergebnis wieder ein. Das
        funktioniert, kostet aber jeden Tag Zeit und hängt an einer einzigen Person.
      </p>
      <p>
        Aus dieser Stelle wird im Kopf schnell ein Systemproblem. Der Schluss liegt nahe: Wenn
        das System diese Aufgabe nicht kann, braucht es ein anderes. Der Schluss ist nur
        deshalb falsch, weil er die Ursache verwechselt. Nicht das System kann die Aufgabe
        nicht. Es kennt sie nicht.
      </p>
    </div>
  </Section>

  <Section tone="canvas">
    <SectionHeading
      kicker="Woran es liegt"
      title="Drei Gründe, warum Ablöseprojekte teurer werden als geplant"
      lead="Keiner davon ist ein Argument gegen einen Wechsel. Alle drei sind Argumente dafür, ihn nicht zu beginnen, bevor man das eigentliche Problem benannt hat."
    />
    <ul class="mt-12 rasterfugen sm:grid-cols-3" data-reveal>
      {
        gruende.map((grund, i) => (
          <li class="bg-surface p-7">
            <span class="font-display text-sm font-semibold tabular-nums text-accent">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h2 class="mt-3 text-lg text-ink">{grund.titel}</h2>
            <p class="mt-3 text-ink-soft">{grund.text}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section>
    <div class="prose-measure space-y-5 text-lg text-ink-soft">
      <h2 class="font-serif text-3xl text-ink">Die Alternative ist kein Kompromiss</h2>
      <p>
        Ein Modul neben dem bestehenden System zu bauen, klingt nach halber Lösung. Es ist
        meistens die vollständigere. Der Grund ist einfach: Ein Modul muss nur den einen
        Vorgang abbilden, um den es geht. Es muss nicht gleichzeitig Buchhaltung,
        Materialwirtschaft und Personalverwaltung mitbringen, die im alten System längst
        funktionieren.
      </p>
      <p>
        Dadurch verschiebt sich auch der Zeitpunkt, an dem man merkt, ob es trägt. Bei einem
        Wechsel zeigt sich das nach Monaten, beim Umstellen des laufenden Betriebs. Bei einem
        Modul zeigt es sich an der einen Stelle, an der es eingesetzt wird, und zwar bevor
        etwas anderes daran hängt. Geht die Rechnung nicht auf, hat man einen Baustein
        verloren und kein Jahr.
      </p>
      <p>
        Wie weit das im Einzelfall reicht, steht im Referenzprojekt{' '}
        <a href={withBase('/case-studies/absolar-warenwirtschaft')} class="textverweis"
          >Warenwirtschaftssystem für Solarprojekte</a
        >: Angebote lagen in einer Buchhaltungssoftware, Lagerdaten in einer eigenen Datenbank
        und die Baustellenplanung wieder woanders. Abgelöst wurde keines der drei.
      </p>
    </div>
  </Section>

  <Section tone="canvas">
    <SectionHeading
      kicker="Einordnung"
      title="Wann eine Anbindung reicht und wann nicht"
      lead="Die Unterscheidung lässt sich vor einem Projekt treffen, nicht erst danach."
    />
    <div class="mt-12 grid gap-8 md:grid-cols-2">
      <div class="bg-surface p-8">
        <h2 class="text-xl text-ink">Anbinden genügt, wenn</h2>
        <ul class="mt-5 space-y-4 text-ink-soft">
          {wannAnbindung.map((punkt) => <li>{punkt}</li>)}
        </ul>
      </div>
      <div class="bg-surface p-8">
        <h2 class="text-xl text-ink">Ein Wechsel ist die ehrlichere Antwort, wenn</h2>
        <ul class="mt-5 space-y-4 text-ink-soft">
          {wannNicht.map((punkt) => <li>{punkt}</li>)}
        </ul>
      </div>
    </div>
  </Section>

  <Section>
    <div class="prose-measure space-y-5 text-lg text-ink-soft">
      <h2 class="font-serif text-3xl text-ink">Was daraus folgt</h2>
      <p>
        Die Frage am Anfang sollte nicht lauten, ob das System noch das richtige ist. Sie
        sollte lauten, welcher Vorgang genau Zeit kostet und woran das liegt. In vielen Fällen
        steht am Ende dieser Frage kein Projekt über Monate, sondern ein Modul, das eine
        Handvoll Regeln abbildet, die vorher niemand aufgeschrieben hatte.
      </p>
      <p>
        In den anderen Fällen steht am Ende doch ein Wechsel. Dann aber mit einer Begründung,
        die über ein ungutes Gefühl hinausgeht, und mit dem Wissen, welche Ausnahmen das neue
        System können muss.
      </p>
    </div>
  </Section>

  <Section tone="dark">
    <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
      <SectionHeading
        kicker="Nächster Schritt"
        title="Unsicher, welcher der beiden Fälle vorliegt?"
        lead="Das lässt sich in einem Gespräch klären. Dreißig Minuten, unverbindlich."
        tone="dark"
        class="max-w-2xl"
      />
      <Button href="/kontakt" variant="ghost" class="shrink-0">Gespräch vereinbaren</Button>
    </div>
  </Section>
</Base>
