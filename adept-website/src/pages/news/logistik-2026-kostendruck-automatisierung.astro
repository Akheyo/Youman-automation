---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import { news } from '../../data/news';

/**
 * Redaktioneller Beitrag, keine Case Study.
 *
 * Alle Zahlen stammen aus den unten genannten Quellen und sind im Text
 * ausdrücklich Gartner zugeschrieben. Das ist kein Formalismus: eine
 * Prognose eines Analysehauses ist etwas anderes als eine eigene Messung,
 * und wer das verwischt, verliert genau die Glaubwürdigkeit, die ein
 * solcher Beitrag bringen soll.
 *
 * Nicht übernommen wurden die Quellenmarken "[indexbox]" aus dem
 * gelieferten Text – sie stammen aus der Textproduktion. Die Quellen
 * stehen stattdessen als Verweise am Ende.
 */

const beitrag = news.find((e) => e.slug === 'logistik-2026-kostendruck-automatisierung')!;

const BESCHREIBUNG =
  'Kostendruck, Arbeitskräftemangel und der nüchterne Umgang mit KI: Was aktuelle Logistikprognosen für produktionsnahe und logistikintensive Betriebe bedeuten.';

/**
 * Die vier Zahlen, die den Beitrag tragen. Jede mit ihrer Quelle im
 * Fließtext – hier stehen sie zusätzlich als Überblick, weil sie sonst
 * zwischen den Absätzen untergehen.
 */
const zahlen = [
  {
    wert: '13 %',
    text: 'der Logistikverantwortlichen haben KI vollständig in ihre Abläufe integriert – deutlich weniger als in Produktion, Planung oder Supply-Chain-Strategie.',
  },
  {
    wert: '50 %',
    text: 'der bis 2030 neu gebauten Lagerhäuser in entwickelten Volkswirtschaften sollen "robot-centric" konzipiert sein: menschliche Arbeitskraft optional statt notwendig.',
  },
  {
    wert: '+50 %',
    text: 'Produktivität der Logistikmitarbeiter bei Unilever, nachdem Routineanfragen zu Aufträgen, Lastwagen und Containern über agentenbasierte KI automatisiert wurden.',
  },
  {
    wert: '+40 %',
    text: 'Gesamtbetriebskosten für SaaS-Logistikanwendungen bis 2030, allein durch die fortlaufende Integration fortgeschrittener KI-Funktionen.',
  },
];

const prioritaeten = [
  'Verbesserung der Kundenerfahrung durch mehr Serviceoptionen',
  'Zunehmende Digitalisierung von Prozessen und Angeboten',
  'Steigende Automatisierung der physischen Ausführung',
  'Resilienz und Nachhaltigkeit',
];

const quellen = [
  {
    text: 'IndexBox – Gartner: Supply Chain Must Prioritize Cost Management, Practical Tech, and Infrastructure',
    href: 'https://www.indexbox.io/',
  },
  {
    text: 'im.se – Reflecting on Gartner® supply chain technology predictions (Predicts 2026: Logistics must be more bullish)',
    href: 'https://im.se/',
  },
];

const brotkrumen = [
  { label: 'Home', href: '/' },
  { label: 'News', href: '/news' },
];
---

<Base
  title="Logistik 2026: Kostendruck und Automatisierung"
  description={BESCHREIBUNG}
  bild={beitrag.bild}
  breadcrumb={brotkrumen}
  artikel={{ titel: beitrag.title, beschreibung: BESCHREIBUNG, datum: beitrag.date }}
>
  <PageHeader
    kicker="Branche"
    bild={beitrag.bild}
    title="Logistik 2026: Kostendruck als Treiber für pragmatische Automatisierung"
    lead="Nicht fehlende Technologie ist das Problem, sondern ihr Einsatz ohne klare Kosten-Nutzen-Rechnung."
    breadcrumb={brotkrumen}
  />

  <Section>
    <div class="prose-measure space-y-5 text-lg text-ink-soft">
      <p>
        Aktuelle Branchenanalysen zeichnen ein Bild, das sich deutlich von reiner
        Technologie-Euphorie unterscheidet. Im Zentrum steht die Frage, wie Logistik- und
        Supply-Chain-Verantwortliche gleichzeitig mit steigenden Frachtkosten, wachsenden
        Serviceerwartungen und anhaltendem Arbeitskräftemangel umgehen sollen, ohne sich in teuren
        Technologieprojekten zu verlieren, die am Ende keinen messbaren Nutzen bringen.
      </p>
      <p>
        Grundlage ist eine breite Befragung von Logistikverantwortlichen zu ihren strategischen
        Prioritäten für die kommenden fünf Jahre.
      </p>
    </div>
  </Section>

  {/* ------------------------------------------------------------- Zahlen */}
  <Section tone="canvas">
    <SectionHeading
      kicker="Zahlen"
      title="Vier Werte, die den Rahmen setzen"
      lead="Alle Angaben stammen aus den unten genannten Analysen von Gartner. Es handelt sich um Erhebungen und Prognosen des Analysehauses, nicht um eigene Messungen von adept&."
    />

    <ul class="mt-12 rasterfugen sm:grid-cols-2" data-reveal>
      {
        zahlen.map((zahl) => (
          <li class="bg-surface p-8">
            <p class="font-display text-4xl font-semibold tabular-nums text-ink md:text-5xl">
              {zahl.wert}
            </p>
            <p class="mt-4 text-ink-soft">{zahl.text}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* ------------------------------------------------ Kosten gegen Service */}
  <Section>
    <SectionHeading kicker="Zielkonflikt" title="Kosten gegen Service" />
    <div class="prose-measure mt-8 space-y-5 text-lg text-ink-soft">
      <p>
        Ein Grundproblem begleitet viele Logistikorganisationen seit Jahren: der Zielkonflikt
        zwischen Kosteneffizienz und immer höheren Serviceerwartungen der Kunden. Wenn die Nachfrage
        nach Premiumleistungen wie Same-Day-Delivery steigt, während gleichzeitig die Margen unter
        Druck stehen, drohen Logistikabteilungen faktisch mit Verlust zu arbeiten.
      </p>
      <p>
        Unternehmen sollten deshalb konsequente Kosten-zu-Serviceleistung-Rechnungen aufstellen und
        offen mit der Unternehmensführung klären, wer die tatsächlichen Kosten bestimmter
        Serviceversprechen trägt. Wenn weder eine Weitergabe an den Kunden noch eine Absorption über
        die Marge funktioniert, sollte sogar hinterfragt werden, ob eine Serviceleistung überhaupt
        sinnvoll angeboten werden soll.
      </p>
    </div>

    <div class="mt-10 border-l-2 border-accent pl-6">
      <p class="font-serif text-xl text-ink sm:text-2xl">
        Nicht jede Serviceleistung, die technisch möglich ist, verdient auch Geld.
      </p>
    </div>
  </Section>

  {/* ---------------------------------------------------------------- KI */}
  <Section tone="canvas">
    <SectionHeading kicker="Künstliche Intelligenz" title="Zurückhaltung ist kein Rückstand" />
    <div class="prose-measure mt-8 space-y-5 text-lg text-ink-soft">
      <p>
        Diese Nüchternheit setzt sich beim Thema künstliche Intelligenz fort. Bislang haben nur etwa
        13 Prozent der Logistikverantwortlichen KI vollständig in ihre Abläufe integriert, deutlich
        weniger als in Produktion, Planung oder Supply-Chain-Strategie.
      </p>
      <p>
        Das ist nicht zwangsläufig negativ zu werten, sondern eher Ausdruck einer pragmatischen
        Grundhaltung der Branche: Wer stark auf physische Abläufe fokussiert ist, geht bei neuen
        Technologien vorsichtiger vor. Als positives Beispiel dient Unilever, das mithilfe
        agentenbasierter KI Routineanfragen zu Aufträgen, Lastwagen und Containern automatisiert hat
        und dadurch die Produktivität der Logistikmitarbeiter um 50 Prozent steigern konnte.
      </p>
    </div>
  </Section>

  {/* ----------------------------------------------------- Automatisierung */}
  <Section>
    <SectionHeading
      kicker="Lager"
      title="Automatisierung als demografische Notwendigkeit"
      lead="Bis 2030 soll die Hälfte aller neu gebauten Lagerhäuser in entwickelten Volkswirtschaften „robot-centric“ konzipiert sein – so, dass menschliche Arbeitskräfte optional statt notwendig sind."
    />
    <div class="prose-measure mt-8 space-y-5 text-lg text-ink-soft">
      <p>
        Das gilt als tiefgreifende strukturelle Veränderung: Künstliche Intelligenz ermöglicht es,
        Lagerhäuser in Echtzeit zu optimieren und von statischen Anlagen zu flexiblen Systemen zu
        machen, die sich an schwankende Nachfrage anpassen.
      </p>
      <p>
        Getrieben wird diese Entwicklung weniger von technologischem Innovationsdrang als von
        demografischer Notwendigkeit: Immer weniger junge Arbeitskräfte wollen im Lager oder als
        Lkw-Fahrer arbeiten, was Unternehmen praktisch zur Automatisierung zwingt.
      </p>
      <p>
        Gleichzeitig wird vor einer naiven Umsetzung gewarnt. Klassische Industrieroboter sind
        bereits weit verbreitet, doch die eigentliche Schwierigkeit liegt in der nahtlosen
        Integration in bestehende, oft veraltete Gebäudestrukturen. Empfohlen wird, Lagerhäuser und
        Fahrzeuge von vornherein für eine Zukunft mit wenigen menschlichen Kommissionierern zu
        gestalten, statt Roboter nachträglich in ungeeignete Räume zu zwingen.
      </p>
    </div>
  </Section>

  {/* -------------------------------------------------- Individualisierung */}
  <Section tone="canvas">
    <SectionHeading kicker="Sendungsstruktur" title="Von Standardisierung zu Individualisierung" />
    <div class="prose-measure mt-8 space-y-5 text-lg text-ink-soft">
      <p>
        Logistik setzte historisch auf Standardisierung, also auf einheitliche Paletten und
        Container zur Effizienzsteigerung. Die zunehmende Direct-to-Consumer-Zustellung verlangt
        jedoch immer öfter maßgeschneiderte Handhabung individueller, unregelmäßig geformter
        Sendungen.
      </p>
      <p>
        Automatisierte Anlagen kommen mit einheitlichen Kartons gut zurecht, scheitern aber oft an
        sperrigen oder ungewöhnlich geformten Gütern – ein Spannungsfeld, das die Branche noch
        länger begleiten wird.
      </p>
    </div>
  </Section>

  {/* ---------------------------------------------------------- Prioritäten */}
  <Section>
    <SectionHeading
      kicker="Prioritäten"
      title="Was in den nächsten fünf Jahren zählt"
      lead="Eine begleitende Befragung zu strategischen Prioritäten in der Logistik ergab eine klare Reihenfolge."
    />

    <ol class="mt-12 rasterfugen sm:grid-cols-2" data-reveal>
      {
        prioritaeten.map((punkt, i) => (
          <li class="flex gap-5 bg-surface p-7">
            <span class="font-display text-sm font-semibold tabular-nums text-accent">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="text-ink-soft">{punkt}</span>
          </li>
        ))
      }
    </ol>

    <p class="prose-measure mt-10 text-lg text-ink-soft">
      Gleichzeitig wird vor unkontrollierten Kostensteigerungen bei KI-gestützter Logistiksoftware
      gewarnt: Bis 2030 sollen die Gesamtbetriebskosten für SaaS-Logistikanwendungen um mindestens
      40 Prozent steigen, allein durch die fortlaufende Integration fortgeschrittener
      KI-Funktionen.
    </p>
  </Section>

  {/* ------------------------------------------------------------- Fazit */}
  <section class="on-dark bg-ink-deep py-20 text-white md:py-28">
    <div class="container-page">
      <p class="text-xs font-semibold tracking-[0.18em] text-accent-on-dark uppercase">Fazit</p>
      <p class="mt-6 max-w-3xl font-serif text-3xl leading-[1.15] sm:text-4xl lg:text-5xl" data-reveal>
        Logistikunternehmen leiden 2026 nicht an einem Mangel an verfügbarer Technologie, sondern an
        der Herausforderung, sie gezielt einzusetzen.
      </p>
      <div class="prose-measure mt-8 space-y-5 text-lg text-white/80" data-reveal>
        <p>
          Wer Technologie ohne klaren Plan anschafft, verschwendet schnell Ressourcen – unabhängig
          davon, wie fortschrittlich die Lösung selbst ist.
        </p>
        <p>
          Für Unternehmen in produktionsnahen und logistikintensiven Branchen bedeutet das, gezielt
          einzelne, klar abgegrenzte operative Probleme anzugehen, anstatt eine komplette
          technologische Neuaufstellung zu versuchen.
        </p>
      </div>
      <div class="mt-10">
        <Button href="/kontakt" variant="primary">Über ein konkretes Problem sprechen</Button>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ Quellen */}
  <Section tone="canvas">
    <h2 class="font-sans text-sm font-semibold tracking-[0.18em] text-ink uppercase">Quellen</h2>
    <ul class="mt-6 space-y-3 text-ink-soft">
      {
        quellen.map((quelle) => (
          <li>
            <a
              class="text-accent"
              href={quelle.href}
              target="_blank"
              rel="noopener noreferrer nofollow"
            >
              {quelle.text}
            </a>
          </li>
        ))
      }
    </ul>
  </Section>
</Base>
