---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import PlaceholderNote from '../components/PlaceholderNote.astro';
import {
  anbieter,
  anbieterName,
  anbieterLuecken,
  anbieterVollstaendig,
} from '../data/anbieter';

/**
 * Die Anbieterkennzeichnung nach § 5 DDG wird aus `anbieter.ts` erzeugt – das
 * sind reine Tatsachenangaben. Rechtstexte entstehen hier nicht: Haftungs-
 * und Urheberrechtshinweise sowie die Erklärung zur Verbraucherschlichtung
 * sind Willenserklärungen und kommen von der Rechtsberatung.
 *
 * Fehlt ein Pflichtfeld, bleibt der Platzhalter stehen und benennt genau die
 * Lücke. Eine halb ausgefüllte Anbieterkennzeichnung wäre schlechter als eine
 * sichtbar als unvollständig markierte.
 */

const telefone = anbieter.personen.filter((person) => person.telefon);
---

<Base
  title="Impressum"
  description="Impressum von adept& – Anbieterkennzeichnung nach § 5 DDG mit Namen, Anschrift und Kontaktdaten der verantwortlichen Personen."
  noindex={true}
>
  <PageHeader title="Impressum" breadcrumb={[{ label: 'Home', href: '/' }]} />

  <Section>
    {
      anbieterVollstaendig ? (
        <div class="max-w-2xl">
          <h2 class="text-2xl md:text-3xl">Angaben gemäß § 5 DDG</h2>

          <address class="mt-6 not-italic text-lg leading-relaxed text-ink-soft">
            <span class="block font-medium text-ink">{anbieterName}</span>
            {/* Besteht eine Gesellschaft, sind die Personen nicht der
                Anbieter, sondern seine Vertretung – das muss dranstehen. */}
            {anbieter.rechtsform && <span class="mt-2 block">Vertreten durch die Gesellschafter:</span>}
            {anbieter.personen.map((person) => (
              <span class="block">{person.name}</span>
            ))}
            <span class="mt-4 block">{anbieter.strasse}</span>
            <span class="block">
              {anbieter.plz} {anbieter.ort}
            </span>
            <span class="block">{anbieter.land}</span>
          </address>

          <h2 class="mt-14 text-2xl md:text-3xl">Kontakt</h2>
          <dl class="mt-6 grid gap-x-10 gap-y-3 text-lg sm:grid-cols-[auto_minmax(0,1fr)]">
            {telefone.map((person) => (
              <>
                <dt class="text-muted-fg">Telefon {person.name}</dt>
                <dd>
                  <a class="text-accent" href={`tel:${person.telefon?.replace(/\s/g, '')}`}>
                    {person.telefon}
                  </a>
                </dd>
              </>
            ))}
            {anbieter.email && (
              <>
                <dt class="text-muted-fg">E-Mail</dt>
                <dd>
                  <a class="text-accent" href={`mailto:${anbieter.email}`}>
                    {anbieter.email}
                  </a>
                </dd>
              </>
            )}
          </dl>

          {(anbieter.registernummer || anbieter.ustId) && (
            <>
              <h2 class="mt-14 text-2xl md:text-3xl">Registerangaben</h2>
              <dl class="mt-6 grid gap-x-10 gap-y-3 text-lg sm:grid-cols-[auto_minmax(0,1fr)]">
                {anbieter.registergericht && (
                  <>
                    <dt class="text-muted-fg">Registergericht</dt>
                    <dd>{anbieter.registergericht}</dd>
                  </>
                )}
                {anbieter.registernummer && (
                  <>
                    <dt class="text-muted-fg">Registernummer</dt>
                    <dd>{anbieter.registernummer}</dd>
                  </>
                )}
                {anbieter.ustId && (
                  <>
                    <dt class="text-muted-fg">Umsatzsteuer-ID</dt>
                    <dd>{anbieter.ustId}</dd>
                  </>
                )}
              </dl>
            </>
          )}

          {anbieter.inhaltlichVerantwortlich && (
            <>
              <h2 class="mt-14 text-2xl md:text-3xl">
                Inhaltlich verantwortlich nach § 18 Abs. 2 MStV
              </h2>
              <p class="mt-6 text-lg text-ink-soft">{anbieter.inhaltlichVerantwortlich}</p>
            </>
          )}

          <div class="mt-16">
            <PlaceholderNote title="Noch offen – Texte der Rechtsberatung">
              <p>
                Die Angaben oben sind vollständig. Was hier noch fehlt, sind Erklärungen mit
                rechtlicher Wirkung, die nicht erzeugt werden können:
              </p>
              <ul class="mt-3 list-disc space-y-1 pl-5">
                <li>Haftung für Inhalte und für Verweise auf fremde Seiten</li>
                <li>Hinweis zum Urheberrecht</li>
                <li>
                  Erklärung zur Teilnahme an einem Streitbeilegungsverfahren vor einer
                  Verbraucherschlichtungsstelle (§ 36 VSBG)
                </li>
              </ul>
              <p class="mt-4">
                Sobald die Texte vorliegen, werden sie unterhalb der Angaben eingesetzt.
              </p>
            </PlaceholderNote>
          </div>
        </div>
      ) : (
        <PlaceholderNote title="Platzhalter – Impressum noch unvollständig">
          <p>
            Die Anbieterkennzeichnung wird aus hinterlegten Angaben erzeugt. Sie bleibt so lange
            unveröffentlicht, bis alle Pflichtfelder vorliegen – es wird nichts geraten und nichts
            halb ausgefüllt veröffentlicht.
          </p>
          <p class="mt-3">Es fehlt noch:</p>
          <ul class="mt-3 list-disc space-y-1 pl-5">
            {anbieterLuecken.map((luecke) => (
              <li>{luecke}</li>
            ))}
          </ul>
          <p class="mt-4">
            Die Angaben stehen in <code class="px-1">src/data/anbieter.ts</code>. Ergänzt werden dort
            später auch Rechtsform, Registerangaben und Umsatzsteuer-Identifikationsnummer – an
            dieser Seite ist dafür nichts zu ändern.
          </p>
        </PlaceholderNote>
      )
    }
  </Section>
</Base>
