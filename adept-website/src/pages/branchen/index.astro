---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import { branchen } from '../../data/branchen';
import { withBase } from '../../lib/url';
---

<Base
  title="Branchen"
  description="Wo adept& arbeitet: produktionsnahe und logistikintensive Branchen – Fertigung und Maschinenbau, Logistik, Handel, Automobilzulieferung."
  bild="maschinenbau"
  breadcrumb={[{ label: 'Home', href: '/' }]}
>
  <PageHeader
    kicker="Branchen"
    bild="halle"
    title="Wo wir arbeiten"
    lead="adept& arbeitet in produktionsnahen und logistikintensiven Branchen."
  />

  <Section>
    <ul class="rasterfugen sm:grid-cols-2">
      {
        branchen.map((branche) => (
          <li class="hebt-sich bg-surface">
            <a
              href={withBase(`/branchen/${branche.slug}`)}
              class="group flex h-full flex-col p-8 transition-colors duration-200 md:p-10"
            >
              <h2 class="flex items-start gap-2 text-2xl text-ink group-hover:text-accent transition-colors duration-200">
                <span>{branche.title}</span>
                <svg
                  class="mt-2 size-4 shrink-0 text-accent transition-transform duration-200 group-hover:translate-x-1"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m9 18 6-6-6-6" />
                </svg>
              </h2>
              <p class="prose-measure mt-3 text-ink-soft">{branche.teaser}</p>
              {branche.platzhalter && (
                <span class="mt-5 inline-flex w-fit border border-muted-fg/50 bg-muted px-2.5 py-1 text-[0.6875rem] font-semibold uppercase tracking-widest text-muted-fg">
                  Platzhalter
                </span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </Section>
</Base>
