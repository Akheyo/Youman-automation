---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import PlaceholderNote from '../../components/PlaceholderNote.astro';
import Button from '../../components/Button.astro';
import { branchen } from '../../data/branchen';
import { funktionen } from '../../data/funktionen';
import { caseStudyNach } from '../../data/caseStudies';
import { withBase } from '../../lib/url';

export function getStaticPaths() {
  return branchen.map((branche) => ({
    params: { slug: branche.slug },
    props: { branche },
  }));
}

const { branche } = Astro.props;

const passendeFunktionen = branche.funktionen.flatMap((slug) => {
  const treffer = funktionen.find((f) => f.slug === slug);
  return treffer ? [treffer] : [];
});

const referenz = branche.referenz ? caseStudyNach(branche.referenz) : undefined;
---

<Base
  title={branche.title}
  description={branche.platzhalter
    ? `${branche.title}: Inhalte für diese Branche werden derzeit erarbeitet.`
    : `${branche.teaser} adept& baut dafür Module und bindet sie an das bestehende ERP-System an.`}
  bild={branche.bild}
  breadcrumb={[
    { label: 'Home', href: '/' },
    { label: 'Branchen', href: '/branchen' },
  ]}
>
  <PageHeader
    kicker="Branchen"
    bild={branche.bild}
    title={branche.title}
    lead={branche.platzhalter ? undefined : branche.teaser}
    breadcrumb={[
      { label: 'Home', href: '/' },
      { label: 'Branchen', href: '/branchen' },
    ]}
  />

  <Section>
    {
      branche.platzhalter ? (
        <PlaceholderNote title="Platzhalter – Branchentexte fehlen noch">
          <p>
            Für <strong>{branche.title}</strong> liegen bislang keine freigegebenen operativen
            Painpoints aus adept&-Projekten vor. Sobald drei bis fünf konkrete Problemstellungen
            benannt sind, wird dieser Abschnitt ersetzt.
          </p>
          <p class="mt-3">
            Bis dahin bleibt diese Seite bewusst ohne inhaltliche Aussage – es werden keine
            Herausforderungen, Zahlen oder Referenzen erfunden.
          </p>
        </PlaceholderNote>
      ) : (
        <p class="prose-measure text-lg text-ink-soft">{branche.intro}</p>
      )
    }
  </Section>

  <Section tone="canvas">
    <SectionHeading
      kicker="Passende Funktionen"
      title="Was wir in dieser Branche bauen"
      lead="Die folgenden Funktionsbereiche greifen hier typischerweise. Jede Lösung entsteht als eigenes Modul im adept&-Gerüst."
    />
    <ul class="mt-12 grid gap-px bg-line md:grid-cols-3">
      {
        passendeFunktionen.map((funktion) => (
          <li class="bg-canvas">
            <a
              href={withBase(`/funktionen/${funktion.slug}`)}
              class="group flex h-full flex-col p-8 transition-colors duration-200 hover:bg-surface"
            >
              <h3 class="text-lg text-ink group-hover:text-accent transition-colors duration-200">
                {funktion.title}
              </h3>
              <p class="mt-3 text-sm text-ink-soft">{funktion.teaser}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  {
    referenz && (
      <Section>
        <SectionHeading kicker="Referenz" title="Aus der Praxis" />
        <div class="mt-8 max-w-3xl">
          <h3 class="text-2xl text-ink">{referenz.title}</h3>
          <p class="mt-4 text-ink-soft">{referenz.excerpt}</p>
          <Button href={referenz.href} variant="secondary" class="mt-8">
            Case Study lesen
          </Button>
        </div>
      </Section>
    )
  }

  <Section tone="dark">
    <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
      <SectionHeading
        title="Passt das zu Ihrer Situation?"
        lead="Schildern Sie uns den Engpass – wir sagen Ihnen, ob sich das als Modul abbilden lässt."
        tone="dark"
      />
      <Button href="/kontakt" variant="ghost" class="shrink-0">Kontakt aufnehmen</Button>
    </div>
  </Section>
</Base>
