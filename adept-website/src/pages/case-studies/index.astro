---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import Bild from '../../components/Bild.astro';
import { caseStudies } from '../../data/caseStudies';
import { withBase } from '../../lib/url';

const brotkrumen = [{ label: 'Home', href: '/' }];
---

<Base
  title="Case Studies"
  description="Abgeschlossene Projekte von adept&: Palettenoptimierung bei der Drahtmüller GmbH und ein integriertes Warenwirtschaftssystem für A&B SolarEnergy."
  bild="paletten"
  breadcrumb={brotkrumen}
>
  <PageHeader
    kicker="Case Studies"
    bild="paletten"
    title="Was wir gebaut haben"
    lead="Zwei abgeschlossene Projekte, jeweils vom operativen Engpass bis zur Anbindung an das bestehende System."
    breadcrumb={brotkrumen}
  />

  <Section>
    {/*
      Liste statt Kachelraster: bei zwei Einträgen wirkt ein dreispaltiges
      Raster löchrig. Jeder Eintrag bekommt dafür die volle Breite und trägt
      Kunde, Branche und – wo belegt – die eine Zahl, die den Fall ausmacht.
    */}
    <ul class="divide-y divide-line border-y border-line">
      {
        caseStudies.map((fall, i) => (
          <li>
            <a
              href={withBase(fall.href)}
              class="hebt-sich group grid gap-8 bg-surface p-6 sm:p-8 md:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] md:gap-12 md:p-10"
              data-reveal
            >
              <Bild
                name={fall.bild}
                index={i}
                ratio="4/3"
                zoom
                sizes="(min-width: 768px) 22rem, 100vw"
              />
              <div class="flex flex-col justify-center">
                <p class="font-sans text-xs font-semibold uppercase tracking-[0.18em] text-accent">
                  {fall.branche}
                </p>
                <h2 class="mt-3 text-2xl text-ink md:text-3xl">{fall.title}</h2>
                <p class="mt-2 text-sm text-muted-fg">{fall.kunde}</p>
                <p class="prose-measure mt-5 text-ink-soft">{fall.excerpt}</p>

                {fall.kennzahl && (
                  <p class="mt-6 flex flex-wrap items-end gap-x-4 gap-y-2 border-t border-line pt-5">
                    <span class="font-display text-3xl font-semibold tabular-nums text-ink md:text-4xl">
                      {fall.kennzahl.wert}
                    </span>
                    <span class="min-w-0 pb-1 text-sm text-muted-fg">
                      {fall.kennzahl.beschreibung}
                    </span>
                  </p>
                )}

                <span
                  class="mt-7 inline-flex items-center gap-2 font-medium text-accent"
                  aria-hidden="true"
                >
                  Case Study lesen
                  <svg
                    class="size-4 transition-transform duration-200 group-hover:translate-x-1"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m9 18 6-6-6-6" />
                  </svg>
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>
</Base>
