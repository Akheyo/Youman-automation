---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import { site, prozess } from '../data/site';
import { anbieter } from '../data/anbieter';
import { withBase } from '../lib/url';

/**
 * Die Geschichte stammt aus dem freigegebenen Text der Gruender.
 *
 * Angepasst wurde die Einordnung: Der urspruengliche Text erklaerte die
 * Luecke ausschliesslich am ERP-System. Das war zu eng, denn dieselbe Luecke
 * entsteht ueberall dort, wo ein Ablauf nicht in den Standard passt. An den
 * Aussagen ueber die Personen ist nichts geaendert.
 *
 * Die Nachnamen stehen abgekuerzt, wie im gelieferten Text. Vollstaendig
 * stehen sie im Impressum, wo sie hingehoeren.
 */
const geschichte = [
  'Jedes Unternehmen macht früher oder später dieselbe Erfahrung: Die eingesetzten Systeme decken vieles ab, aber nicht alles. Was übrig bleibt, sind die Abläufe, die sich nicht ins Schema pressen lassen, und die am Ende wieder in Tabellen und persönlichen Absprachen landen. Genau dort setzt youman an, gegründet 2026 von zwei Personen mit gegensätzlichen Blickwinkeln auf dasselbe Problem.',
  'Isho I. sieht die Lücke aus der Beratungsperspektive. Als Wirtschaftsingenieur im TMT-Sektor tätig und mit Zertifizierungen in Business Process Modeling und Unternehmensanalytik ausgestattet, beobachtet er dasselbe Muster immer wieder: Unternehmen mit solider Systemlandschaft, die im operativen Alltag trotzdem an denselben Stellen hängen bleiben.',
  'Amanuel K. kennt das Problem von der anderen Seite. Lange bevor youman existiert, baut er in seinem eigenen beruflichen Umfeld bereits Workflow-Automatisierungen und Softwaremodule, um genau solche Lücken zu schließen.',
  'Die Beobachtung des einen trifft auf die Umsetzungskompetenz des anderen, und daraus entsteht eine gemeinsame Überzeugung: Was hier fehlt, muss gebaut werden, nicht nur beschrieben.',
  'Unterschiedlich in der Aufgabe, identisch im Anspruch: Kein bestehendes System wird ersetzt. Jede Lösung entsteht dort, wo ein Unternehmen sie tatsächlich braucht.',
];

const werte = [
  {
    titel: 'Ehrlichkeit',
    text: 'Wir nennen Risiken, Aufwände und Grenzen einer Lösung offen, auch wenn das kurzfristig unbequem ist. Wenn ein Vorhaben sich nicht lohnt, sagen wir das, bevor es beauftragt wird.',
  },
  {
    titel: 'Transparenz',
    text: 'Sie sehen, woran gearbeitet wird und wo es steht. Keine Blackbox, aus der nach Monaten ein fertiges Ergebnis fällt.',
  },
  {
    titel: 'Verlässlichkeit',
    text: 'Zusagen werden gehalten oder rechtzeitig zurückgezogen. Ein zu spät gemeldeter Verzug ist teurer als ein früh gemeldeter.',
  },
  {
    titel: 'Nachvollziehbarkeit',
    text: 'Was wir bauen, ist dokumentiert und übergebbar. Sie sollen nicht von uns abhängig sein, sondern uns behalten, weil es passt.',
  },
];

const brotkrumen = [{ label: 'Home', href: '/' }];
---

<Base
  title="Über uns: KI-Automation und Softwareentwicklung"
  description="youman verbindet Prozessanalyse mit Softwareentwicklung. Gegründet 2026 von zwei Personen, die dasselbe Problem aus zwei Richtungen kennen."
  breadcrumb={brotkrumen}
>
  <PageHeader
    kicker="Über uns"
    title={`Wer hinter ${site.name} steht`}
    lead="Zwei Blickwinkel auf dasselbe Problem: die Analyse, warum ein Ablauf hakt, und die Fähigkeit, das Fehlende zu bauen."
    breadcrumb={brotkrumen}
  />

  <Section>
    <div class="prose-measure space-y-5 text-lg text-ink-soft">
      <p>
        {site.name} ist kein reines Beratungshaus, das Empfehlungen ausspricht. Und kein
        Anbieter, der ein fertiges Produkt verkauft, in das der Betrieb hineinpassen muss. Wir
        tun beides: Wir analysieren den Ablauf, und wir bauen die Lösung dafür.
      </p>
      <p>
        Der Unterschied zeigt sich in der Praxis daran, wer die Verantwortung trägt, wenn
        etwas nicht funktioniert. Bei getrennten Rollen zeigen Beratung und Umsetzung
        aufeinander. Bei uns gibt es diese Trennung nicht.
      </p>
    </div>
  </Section>

  <Section tone="canvas">
    <SectionHeading kicker={site.name} title="Geschichte" />
    <div class="prose-measure mt-10 space-y-5 text-ink-soft">
      {geschichte.map((absatz) => <p>{absatz}</p>)}
    </div>
  </Section>

  <Section>
    <SectionHeading
      kicker="Vorgehen"
      title="Wie ein Projekt abläuft"
      lead="Vier Schritte. Nach dem zweiten wissen Sie, ob sich das Vorhaben lohnt."
    />
    <ol class="mt-12 rasterfugen sm:grid-cols-2 lg:grid-cols-4" data-reveal>
      {
        prozess.map((schritt) => (
          <li class="bg-surface p-7">
            <span class="font-display text-sm font-semibold tabular-nums text-accent">
              {schritt.step}
            </span>
            <h3 class="mt-3 text-lg text-ink">{schritt.title}</h3>
            <p class="mt-2 text-sm text-ink-soft">{schritt.description}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section tone="canvas">
    <SectionHeading kicker={site.name} title="Werte" />
    <dl class="mt-12 rasterfugen sm:grid-cols-2" data-reveal>
      {
        werte.map((wert) => (
          <div class="bg-surface p-7">
            <dt class="text-lg text-ink">{wert.titel}</dt>
            <dd class="prose-measure mt-2.5 text-ink-soft">{wert.text}</dd>
          </div>
        ))
      }
    </dl>
    <p class="prose-measure mt-12 text-lg text-ink-soft">
      Unser Sitz ist {anbieter.ort}, gearbeitet wird im gesamten deutschsprachigen Raum. Was
      die räumliche Nähe an einem Projekt praktisch ändert und an welchen Stellen sie nichts
      ändert, haben wir auf der Seite{' '}
      <a href={withBase('/muensterland')} class="textverweis">Münsterland</a> aufgeschrieben.
    </p>
  </Section>

  <Section tone="dark">
    <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
      <SectionHeading
        title="Klingt nach der richtigen Herangehensweise?"
        lead="Dann beschreiben Sie uns kurz, woran es bei Ihnen hängt."
        tone="dark"
        class="max-w-2xl"
      />
      <Button href="/kontakt" variant="ghost" class="shrink-0">Kontakt aufnehmen</Button>
    </div>
  </Section>
</Base>
