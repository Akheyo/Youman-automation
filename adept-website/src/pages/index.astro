---
import Base from '../layouts/Base.astro';
import HeroVideo from '../components/HeroVideo.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TeaserCard from '../components/TeaserCard.astro';
import Bild from '../components/Bild.astro';
import Button from '../components/Button.astro';
import { news } from '../data/news';
import { branchen } from '../data/branchen';
import { funktionen } from '../data/funktionen';
import { site, kernleistungen } from '../data/site';
import { withBase } from '../lib/url';

/**
 * Reihenfolge der Startseite:
 * Hero > Aktuelle Themen > Was wir tun > Claim > Über adept&
 * > Branchen und Funktionen.
 *
 * "Aktuelle Themen" steht auf Wunsch direkt unter dem Hero und damit vor der
 * Erklärung, was adept& tut. Das entspricht dem Briefing, das "Aktuelle
 * Themen" als ersten Block nach dem Hero führt.
 *
 * "Was wir tun" und "Branchen" sind Ergänzungen zum Briefing – ohne sie sagt
 * die Startseite an keiner Stelle, womit das Unternehmen sein Geld verdient.
 */

// Die Case Study ist der Aufmacher, die noch offenen Themen folgen darunter.
const aufmacher = news.find((n) => !n.platzhalter);
const weitere = news.filter((n) => n !== aufmacher);

// Inhalte für "Geschichte" und "Werte" liegen noch nicht vor.
const ueberKacheln = [
  { title: 'Geschichte', href: '/ueber-uns#geschichte', bild: 'architektur' as const },
  { title: 'Werte', href: '/ueber-uns#werte', bild: 'gitter' as const },
];
---

<Base title={site.name} description={site.description}>
  {/* Das Video ist ohne eingebrannte Schrift geliefert – "adept&" und
      "Deutschland" stehen deshalb wieder als echter Text darüber. Die leichte
      Verlangsamung nimmt den drei Einstellungen die Hektik, ohne dass das
      Video neu gerendert werden muss. */}
  <HeroVideo
    title={site.name}
    subtitle={site.region}
    videoSrc="/hero.mp4"
    poster="/hero-poster.jpg"
    playbackRate={0.85}
  />

  {/* ---------------------------------------------------- Aktuelle Themen */}
  <Section tone="canvas">
    <SectionHeading kicker="Aktuelles" title="Aktuelle Themen" align="center" />

    {/* Die Case Study ist der einzige belastbare Beleg – sie bekommt deshalb
        das Gewicht eines Aufmachers statt einer Kachel unter vieren. */}
    {
      aufmacher && (
        <a
          href={withBase(aufmacher.href)}
          class="hebt-sich group mt-14 grid overflow-hidden bg-surface shadow-sm ring-1 ring-line lg:grid-cols-2"
          data-reveal
        >
          <Bild
            name={aufmacher.bild}
            ratio="4/3"
            zoom
            sizes="(min-width: 1024px) 50vw, 100vw"
            class="wischt-auf lg:h-full"
          />
          <div class="flex flex-col justify-center p-8 md:p-12 lg:p-16">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">
              {aufmacher.kicker}
            </p>
            <h3 class="mt-4 text-2xl text-ink transition-colors duration-200 group-hover:text-accent md:text-3xl">
              {aufmacher.title}
            </h3>
            <p class="prose-measure mt-5 text-ink-soft">{aufmacher.excerpt}</p>

            <div class="mt-8 flex items-end gap-5 border-t border-line pt-6">
              <span class="font-display text-4xl font-semibold tabular-nums text-ink md:text-5xl">
                2.556
              </span>
              <span class="pb-1 text-sm text-muted-fg">
                verschiedene Palettentypen<br />waren im aktiven Einsatz
              </span>
            </div>

            <span
              class="mt-8 inline-flex items-center gap-2 font-medium text-accent"
              aria-hidden="true"
            >
              Case Study lesen
              <svg
                class="size-4 transition-transform duration-200 group-hover:translate-x-1"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m9 18 6-6-6-6" />
              </svg>
            </span>
          </div>
        </a>
      )
    }

    <ul class="mt-12 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3" data-reveal-gruppe>
      {
        weitere.map((item, index) => (
          <li data-reveal style={`--reveal-index:${index}`}>
            <TeaserCard
              title={item.title}
              href={item.href}
              kicker={item.kicker}
              date={item.date}
              excerpt={item.excerpt}
              bild={item.bild}
              index={index + 1}
              platzhalter={item.platzhalter}
            />
          </li>
        ))
      }
    </ul>
  </Section>

  {/* ---------------------------------------------------- Was wir tun */}
  <Section tone="light">
    <div class="grid gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-24" data-reveal>
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">
          {site.claim}
        </p>
        <h2 class="mt-5 text-3xl sm:text-4xl lg:text-5xl">
          Wir beraten, wo andere nur liefern – und wir bauen, was andere nur empfehlen.
        </h2>
        <p class="prose-measure mt-7 text-lg text-ink-soft">
          adept& ist kein reines Beratungshaus, das Empfehlungen ausspricht, und kein
          Softwareunternehmen, das ein Standardprodukt verkauft. Wir analysieren das operative
          Problem – und wir bauen die Lösung, eingebettet in Ihr bestehendes ERP- oder SAP-System.
        </p>
        <div class="mt-9 border-l-2 border-accent pl-6">
          <p class="font-serif text-xl text-ink sm:text-2xl">
            Kein Systemwechsel. Keine Medienbrüche. Eine Oberfläche.
          </p>
        </div>
        <Button href="/ueber-uns" variant="secondary" class="mt-9">
          Wie wir arbeiten
        </Button>
      </div>

      <ol class="grid gap-px self-start bg-line sm:grid-cols-2">
        {
          kernleistungen.map((leistung, i) => (
            <li class="bg-surface p-7">
              <p class="font-display text-sm font-semibold tabular-nums text-accent">
                {String(i + 1).padStart(2, '0')}
              </p>
              <h3 class="mt-3 text-lg text-ink">{leistung.title}</h3>
              <p class="mt-2.5 text-sm leading-relaxed text-ink-soft">{leistung.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  {/* ---------------------------------------------------- Claim-Bahn */}
  <section class="on-dark relative isolate overflow-hidden bg-ink-deep text-white">
    <div class="absolute inset-0 -z-10">
      <Bild name="oberflaeche" ratio="fill" parallax sizes="100vw" class="size-full" />
      <div class="absolute inset-0 bg-ink-deep/20" aria-hidden="true"></div>
      {/* Kraeftiger Verlauf nur ueber der linken Haelfte, wo der Text steht */}
      <div
        class="absolute inset-0 bg-gradient-to-r from-ink-deep from-30% via-ink-deep/90 via-55% to-transparent"
        aria-hidden="true"
      >
      </div>
    </div>
    <div class="container-page py-24 md:py-36">
      <p class="max-w-2xl font-serif text-4xl leading-[1.05] sm:text-6xl lg:text-7xl" data-reveal>
        Kein Systemwechsel.<br />Keine Medienbrüche.<br /><span class="text-accent-on-dark"
          >Eine Oberfläche.</span
        >
      </p>
      <p class="max-w-xl mt-8 text-lg text-white/80" data-reveal>
        Der Mitarbeiter beim Kunden sieht nur eine Oberfläche. Datenabruf, Berechnung und
        Synchronisation mit dem ERP-System laufen vollautomatisch im Hintergrund.
      </p>
    </div>
  </section>

  {/*
    ---------------------------------------------------- Über adept&

    Heller Grund, nicht dunkel: der Abschnitt steht jetzt direkt unter der
    dunklen Claim-Bahn. Zwei dunkle Bänder hintereinander verschmelzen zu
    einem langen Block, die Kante dazwischen verschwindet.
  */}
  <Section tone="canvas">
    <SectionHeading
      title="Über adept&"
      lead="Wir sind kein reines Beratungshaus, das Empfehlungen ausspricht. Und kein klassisches Softwareunternehmen, das ein Standardprodukt verkauft. Wir tun beides: Wir analysieren das Problem und wir bauen die Lösung."
      align="center"
    />

    <ul class="mt-14 grid gap-6 sm:grid-cols-2" data-reveal>
      {
        ueberKacheln.map((kachel, i) => (
          <li>
            <a
              href={withBase(kachel.href)}
              class="hebt-sich streift group relative block overflow-hidden"
            >
              <Bild
                name={kachel.bild}
                index={i}
                ratio="16/9"
                scrim="unten"
                zoom
                sizes="(min-width: 640px) 50vw, 100vw"
              >
                <span class="absolute left-3 top-3 border border-white/40 bg-ink-deep/70 px-2.5 py-1 text-[0.6875rem] font-semibold uppercase tracking-widest text-white backdrop-blur-sm">
                  Text folgt
                </span>
                <span class="absolute bottom-6 left-6 font-serif text-2xl font-medium text-white md:text-3xl">
                  {kachel.title}
                </span>
              </Bild>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 text-center text-sm text-muted-fg">
      Texte für „Geschichte“ und „Werte“ liegen noch nicht vor.
    </p>
  </Section>
{/* ---------------------------------------------------- Branchen und Funktionen */}
  <Section tone="light">
    <SectionHeading
      kicker="Branchen"
      title="Wo wir arbeiten"
      lead="adept& arbeitet mit mittelständischen Unternehmen in produktionsnahen und logistikintensiven Branchen."
    />

    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
      {
        branchen.map((branche, i) => (
          <li>
            <a
              href={withBase(`/branchen/${branche.slug}`)}
              class="hebt-sich streift group relative block overflow-hidden"
            >
              <Bild
                name={branche.bild}
                index={i}
                ratio="4/3"
                scrim="unten"
                zoom
                sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
              >
                <div class="absolute inset-x-0 bottom-0 p-5">
                  <h3 class="text-lg font-medium text-white">{branche.title}</h3>
                  <span
                    class="mt-1.5 inline-flex items-center gap-1.5 text-sm text-white/85"
                    aria-hidden="true"
                  >
                    Ansehen
                    <svg
                      class="size-3.5 transition-transform duration-200 group-hover:translate-x-1"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="m9 18 6-6-6-6" />
                    </svg>
                  </span>
                </div>
              </Bild>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-16 border-t border-line pt-10">
      <h3 class="font-sans text-xs font-semibold uppercase tracking-[0.18em] text-accent">
        Funktionsbereiche
      </h3>
      <!-- Letzter Eintrag ueberspannt beide Spalten: bei fuenf Eintraegen bliebe
           sonst eine leere Zelle im Raster stehen. -->
      <ul class="mt-6 grid gap-px bg-line md:grid-cols-2 [&>li:last-child]:md:col-span-2">
        {
          funktionen.map((funktion) => (
            <li class="bg-surface">
              <a
                href={withBase(`/funktionen/${funktion.slug}`)}
                class="group flex h-full items-start justify-between gap-4 p-6 transition-colors duration-200 hover:bg-canvas"
              >
                <span class="font-medium text-ink transition-colors duration-200 group-hover:text-accent">
                  {funktion.title}
                </span>
                <svg
                  class="mt-1 size-4 shrink-0 text-accent transition-transform duration-200 group-hover:translate-x-1"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m9 18 6-6-6-6" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  </Base>
