---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import { funktionen } from '../../data/funktionen';
import { withBase } from '../../lib/url';
---

<Base
  title="Funktionen"
  description="Produktion, Logistik, Supply Chain, Reporting und Systemintegration – die Funktionsbereiche, für die adept& Module baut."
>
  <PageHeader
    kicker="Funktionen"
    title="Was wir bauen"
    lead="Jede Lösung entsteht als eigenständiges Modul im adept&-Gerüst und hängt über eine API am bestehenden ERP-System. Kein Systemwechsel. Keine Medienbrüche. Eine Oberfläche."
  />

  <Section>
    <ul class="grid gap-px bg-line md:grid-cols-2 xl:grid-cols-3">
      {
        funktionen.map((funktion) => (
          <li class="bg-surface">
            <a
              href={withBase(`/funktionen/${funktion.slug}`)}
              class="group flex h-full flex-col p-8 md:p-10 transition-colors duration-200 hover:bg-canvas"
            >
              <h2 class="flex items-start gap-2 text-xl font-semibold text-ink group-hover:text-accent transition-colors duration-200">
                <span>{funktion.title}</span>
                <svg
                  class="mt-1.5 size-4 shrink-0 text-accent transition-transform duration-200 group-hover:translate-x-1"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m9 18 6-6-6-6" />
                </svg>
              </h2>
              <p class="mt-3 text-ink-soft">{funktion.teaser}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>
</Base>
