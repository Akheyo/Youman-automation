---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import { funktionen } from '../../data/funktionen';
import { caseStudyNach } from '../../data/caseStudies';
import { branchen } from '../../data/branchen';
import { prozess } from '../../data/site';
import { withBase } from '../../lib/url';

export function getStaticPaths() {
  return funktionen.map((funktion) => ({
    params: { slug: funktion.slug },
    props: { funktion },
  }));
}

const { funktion } = Astro.props;

const passendeBranchen = branchen.filter((b) => b.funktionen.includes(funktion.slug));
const referenz = funktion.referenz ? caseStudyNach(funktion.referenz) : undefined;
---

<Base
  title={funktion.seoTitel ?? funktion.title}
  description={funktion.seoBeschreibung ?? funktion.teaser}
  bild={funktion.bild}
  dienstleistung={{ name: funktion.title, beschreibung: funktion.teaser }}
  breadcrumb={[
    { label: 'Home', href: '/' },
    { label: 'Funktionen', href: '/funktionen' },
  ]}
>
  <PageHeader
    kicker="Funktionen"
    bild={funktion.bild}
    title={funktion.title}
    lead={funktion.teaser}
    breadcrumb={[
      { label: 'Home', href: '/' },
      { label: 'Funktionen', href: '/funktionen' },
    ]}
  />

  {/*
    Problemstellungen vor den Bausteinen, wie auf den Branchenseiten: erst
    das Problem, dann die Antwort. Fehlt die Liste, entfaellt der Abschnitt
    ersatzlos.
  */}
  {
    funktion.painpoints && funktion.painpoints.length > 0 && (
      <Section tone="canvas">
        <SectionHeading
          kicker="Woran es hakt"
          title="Typische Problemstellungen in diesem Bereich"
          lead="Wenn Ihnen davon etwas bekannt vorkommt, lohnt sich ein Gespräch. Genau an solchen Stellen setzen wir an."
        />
        <ul class="mt-12 rasterfugen sm:grid-cols-2" data-reveal>
          {funktion.painpoints.map((punkt, i) => (
            <li class="flex gap-5 bg-surface p-7">
              <span class="font-display text-sm font-semibold tabular-nums text-accent">
                {String(i + 1).padStart(2, '0')}
              </span>
              <p class="text-ink-soft">{punkt}</p>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <Section>
    <SectionHeading
      title="Bausteine"
      lead="Diese Elemente setzen wir in diesem Funktionsbereich um, immer zugeschnitten auf den konkreten Prozess und nie als Standardfunktion von der Stange."
    />

    {/*
      Verweis auf ein Referenzprojekt im Fliesstext. Die Referenzprojekte sind
      das staerkste Argument auf der Seite und waren zugleich am schlechtesten
      erreichbar: je ein einziger Verweis aus dem Inhaltsbereich.
    */}
    {
      referenz && funktion.referenzHinweis && (
        <p class="prose-measure mt-8 text-lg text-ink-soft">
          {funktion.referenzHinweis}{' '}
          <a href={withBase(referenz.href)} class="textverweis">{referenz.title}</a>.
        </p>
      )
    }

    {
      funktion.beitrag && (
        <p class="prose-measure mt-4 text-lg text-ink-soft">
          {funktion.beitrag.hinweis}{' '}
          <a href={withBase(funktion.beitrag.href)} class="textverweis">{funktion.beitrag.titel}</a>.
        </p>
      )
    }
    {/*
      Jeder Baustein laesst sich aufklappen. <details> und <summary> statt
      eigener Schaltflaechen: die Browser bringen Tastaturbedienung und
      Ansage an Screenreader mit, und ohne JavaScript funktioniert es
      ebenfalls. Der Kreis rechts ist die sichtbare Marke; der
      Standardpfeil der Browser ist im Stylesheet abgeschaltet.
    */}
    <ul class="mt-12 grid gap-x-10 md:grid-cols-2">
      {
        funktion.bausteine.map((baustein) => (
          <li class="border-t border-line">
            <details class="group">
              <summary class="flex min-h-11 cursor-pointer items-center justify-between gap-6 py-6">
                <span class="text-lg text-ink">{baustein.titel}</span>
                <span
                  class="grid size-9 shrink-0 place-items-center rounded-full border border-line text-ink transition-colors duration-200 group-hover:border-accent group-open:border-accent group-open:bg-accent group-open:text-white"
                  aria-hidden="true"
                >
                  <svg
                    class="size-4 transition-transform duration-200 group-open:rotate-180"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </span>
              </summary>
              <p class="prose-measure pb-7 pr-4 text-ink-soft">{baustein.text}</p>
            </details>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section tone="canvas">
    <SectionHeading kicker="Vorgehen" title="Von der Analyse bis zum Rollout" />
    <ol class="mt-12 rasterfugen md:grid-cols-3 lg:grid-cols-5">
      {
        prozess.map((schritt) => (
          <li class="bg-canvas p-6">
            <p class="font-display text-3xl font-semibold text-accent">{schritt.step}</p>
            <h3 class="mt-3 text-lg text-ink">{schritt.title}</h3>
            <p class="mt-2 text-sm text-ink-soft">{schritt.description}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  {
    passendeBranchen.length > 0 && (
      <Section>
        <SectionHeading kicker="Branchen" title="Wo dieser Bereich greift" />
        <ul class="mt-10 flex flex-wrap gap-3">
          {passendeBranchen.map((branche) => (
            <li>
              <a
                href={withBase(`/branchen/${branche.slug}`)}
                class="inline-flex min-h-11 items-center border border-line px-5 py-2.5 text-ink hover:border-accent hover:text-accent transition-colors duration-200"
              >
                {branche.title}
              </a>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <Section tone="dark">
    <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
      <SectionHeading
        title="Konkreten Fall besprechen"
        lead="Wir schauen uns Ihren Prozess an und sagen Ihnen, was sich als Modul abbilden lässt."
        tone="dark"
      />
      <Button href="/kontakt" variant="ghost" class="shrink-0">Kontakt aufnehmen</Button>
    </div>
  </Section>
</Base>
