---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { mainNav, footerLegalNav } from '../data/navigation';
import { withBase } from '../lib/url';
import { site } from '../data/site';
import { anbieter, anbieterVollstaendig } from '../data/anbieter';

const jahr = new Date().getFullYear();
const bereiche = mainNav.filter((item) => item.children);
---

<!--
  Aufbau wie in der Referenz, jedoch OHNE Newsletter-Block:
  kein "Subscribe", kein E-Mail-Feld, kein Submit-Button.
-->
<footer class="mt-auto">
  <!-- Abschluss-Sektion mit Name und Kontakt-CTA -->
  <div class="bg-canvas border-t border-line">
    <div
      class="container-page flex flex-col gap-8 py-14 md:flex-row md:items-center md:justify-between"
    >
      <p class="font-display text-2xl md:text-3xl text-ink">
        {site.name} in {site.region}
      </p>
      <div class="flex flex-wrap gap-3">
        <Button href="/kontakt" variant="primary">Kontakt aufnehmen</Button>
        <Button href="/ueber-uns" variant="secondary">Über adept&amp;</Button>
      </div>
    </div>
  </div>

  <div class="border-t border-line bg-surface">
    <div class="container-page py-14">
      <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
        <div>
          <a href={withBase('/')} class="unterstrich inline-flex min-h-11 items-center rounded-sm" aria-label="adept&, zur Startseite">
            <Logo class="text-3xl" />
          </a>
          <p class="prose-measure mt-4 text-sm text-muted-fg">
            {site.claim}<br />{site.subclaim}
          </p>
        </div>

        {
          bereiche.map((bereich) => (
            <nav aria-label={bereich.label}>
              <h2 class="font-sans text-sm font-semibold text-ink">
                <a href={withBase(bereich.href)} class="unterstrich inline-flex min-h-11 items-center hover:text-accent transition-colors duration-200">
                  {bereich.label}
                </a>
              </h2>
              <ul class="mt-4 space-y-2">
                {bereich.children?.map((child) => (
                  <li>
                    <a
                      href={withBase(child.href)}
                      class="unterstrich inline-flex min-h-11 items-center text-sm text-muted-fg hover:text-accent transition-colors duration-200"
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }

        <nav aria-label="Unternehmen">
          <h2 class="font-sans text-sm font-semibold text-ink">Unternehmen</h2>
          <ul class="mt-4 space-y-2">
            {
              mainNav
                .filter((item) => !item.children && item.href !== '/')
                .map((item) => (
                  <li>
                    <a
                      href={withBase(item.href)}
                      class="unterstrich inline-flex min-h-11 items-center text-sm text-muted-fg hover:text-accent transition-colors duration-200"
                    >
                      {item.label}
                    </a>
                  </li>
                ))
            }
          </ul>
        </nav>
      </div>

      <div
        class="mt-12 flex flex-col gap-4 border-t border-line pt-8 sm:flex-row sm:items-center sm:justify-between"
      >
        {/*
          Anschrift auf jeder Seite, nicht nur im Impressum. Fuer ortsbezogene
          Suchen zaehlt, dass Name, Anschrift und Telefonnummer ueberall
          identisch stehen, auf der eigenen Seite wie in Verzeichnissen. Steht
          die Anschrift nur im Impressum, fehlt dieses Signal auf 21 von 22
          Seiten. Als <address> ausgezeichnet, damit die Angabe auch
          maschinell als Anschrift erkennbar ist.

          Erscheint nur vollstaendig; eine halbe Adresse ist schlechter als
          keine, weil sie die Uebereinstimmung mit anderen Quellen bricht.
        */}
        <div class="text-sm text-muted-fg">
          <p>© {jahr} adept&amp;</p>
          {anbieterVollstaendig && (
            <address class="mt-1 not-italic">
              {anbieter.strasse}, {anbieter.plz} {anbieter.ort}
              {anbieter.personen[0]?.telefon && (
                <>
                  {' · '}
                  <a
                    href={`tel:${anbieter.personen[0].telefon.replace(/\s/g, '')}`}
                    class="unterstrich hover:text-accent transition-colors duration-200"
                  >
                    {anbieter.personen[0].telefon}
                  </a>
                </>
              )}
            </address>
          )}
        </div>
        <ul class="flex flex-wrap gap-x-6 gap-y-1">
          {
            footerLegalNav.map((item) => (
              <li>
                <a
                  href={withBase(item.href)}
                  class="unterstrich inline-flex min-h-11 items-center text-sm text-muted-fg hover:text-accent transition-colors duration-200"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</footer>
