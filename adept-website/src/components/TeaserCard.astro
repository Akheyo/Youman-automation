---
import Bild from './Bild.astro';
import type { BildKey } from '../data/images';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  href: string;
  kicker?: string;
  date?: string | null;
  excerpt?: string;
  /** Schlüssel aus dem Bildregister. */
  bild?: BildKey;
  /** Bestimmt die Ersatzfläche, solange kein Bild vorliegt. */
  index?: number;
  /** Kennzeichnet Kacheln, deren Inhalt noch aussteht. */
  platzhalter?: boolean;
}

const {
  title,
  href,
  kicker,
  date,
  excerpt,
  bild,
  index = 0,
  platzhalter = false,
} = Astro.props;

const dateLabel = date
  ? new Intl.DateTimeFormat('de-DE', { dateStyle: 'long' }).format(new Date(date))
  : null;
---

<article class="group relative flex h-full flex-col">
  <Bild name={bild} index={index} ratio="16/9" class="w-full">
    <div
      class="pointer-events-none absolute inset-0 bg-ink-deep/0 transition-colors duration-300 group-hover:bg-ink-deep/15"
      aria-hidden="true"
    >
    </div>
    {
      platzhalter && (
        <span class="absolute left-3 top-3 border border-white/40 bg-ink-deep/70 px-2.5 py-1 text-[0.6875rem] font-semibold uppercase tracking-widest text-white backdrop-blur-sm">
          Platzhalter
        </span>
      )
    }
  </Bild>

  <div class="flex flex-1 flex-col pt-5">
    {
      kicker && (
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">{kicker}</p>
      )
    }
    <h3 class="mt-2 text-xl leading-snug font-semibold text-ink">
      <a
        href={withBase(href)}
        class="after:absolute after:inset-0 transition-colors duration-200 group-hover:text-accent"
      >
        {title}
      </a>
    </h3>
    {
      (dateLabel || excerpt) && (
        <p class="mt-3 text-ink-soft">
          {dateLabel && <span class="italic">{dateLabel} – </span>}
          {excerpt}
        </p>
      )
    }
    <span
      class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-accent"
      aria-hidden="true"
    >
      Mehr erfahren
      <svg
        class="size-4 transition-transform duration-200 group-hover:translate-x-1"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="m9 18 6-6-6-6"></path>
      </svg>
    </span>
  </div>
</article>
