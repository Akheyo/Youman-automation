---
import { withBase } from '../lib/url';

interface Props {
  title: string;
  href: string;
  kicker?: string;
  date?: string | null;
  excerpt?: string;
  /** Bildpfad. Fehlt er, wird eine neutrale Farbfläche gezeigt. */
  image?: string;
  imageAlt?: string;
  /** Bestimmt die Farbfläche, solange kein Bild vorliegt. */
  index?: number;
  platzhalter?: boolean;
}

const {
  title,
  href,
  kicker,
  date,
  excerpt,
  image,
  imageAlt = '',
  index = 0,
  platzhalter = false,
} = Astro.props;

// Neutrale Flächen ohne Rot, abgestuft in der Marken-Palette.
const flaechen = [
  'from-ink-deep to-[#0a3350]',
  'from-[#0a3350] to-accent',
  'from-ink to-ink-deep',
  'from-[#1e3a52] to-[#0a3350]',
];
const flaeche = flaechen[index % flaechen.length];

const dateLabel = date
  ? new Intl.DateTimeFormat('de-DE', { dateStyle: 'long' }).format(new Date(date))
  : null;
---

<article class="group relative flex h-full flex-col">
  <div class="relative aspect-16/9 w-full overflow-hidden bg-muted">
    {
      image ? (
        <img
          src={withBase(image)}
          alt={imageAlt}
          width="640"
          height="360"
          loading="lazy"
          decoding="async"
          class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      ) : (
        <div
          class:list={['size-full bg-gradient-to-br', flaeche]}
          aria-hidden="true"
        />
      )
    }
    {
      platzhalter && (
        <span class="absolute left-3 top-3 border border-white/50 bg-black/60 px-2.5 py-1 text-[0.6875rem] font-semibold uppercase tracking-widest text-white">
          Platzhalter
        </span>
      )
    }
  </div>

  <div class="flex flex-1 flex-col pt-5">
    {
      kicker && (
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">{kicker}</p>
      )
    }
    <h3 class="mt-2 text-xl font-semibold text-ink">
      <a
        href={withBase(href)}
        class="inline-flex items-start gap-1.5 after:absolute after:inset-0 group-hover:text-accent transition-colors duration-200"
      >
        <span>{title}</span>
        <svg
          class="mt-1.5 size-4 shrink-0 text-accent transition-transform duration-200 group-hover:translate-x-1"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m9 18 6-6-6-6"></path>
        </svg>
      </a>
    </h3>
    {
      (dateLabel || excerpt) && (
        <p class="mt-3 text-ink-soft">
          {dateLabel && <span class="italic">{dateLabel} – </span>}
          {excerpt}
        </p>
      )
    }
  </div>
</article>
