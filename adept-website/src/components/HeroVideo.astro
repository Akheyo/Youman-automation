---
import { withBase } from '../lib/url';
import { bild } from '../lib/images';

interface Props {
  title: string;
  subtitle?: string;
  /**
   * Eine Zeile darunter, die sagt, worum es geht. Der Name allein beantwortet
   * das nicht – wer zum ersten Mal hier landet, sieht sonst nur eine Marke.
   * Bewusst kurz: alles Weitere steht im Abschnitt direkt unter dem Hero.
   */
  claim?: string;
  /**
   * Pfad zum Hero-Video (z. B. "/hero.mp4"). Fehlt die Datei, wird nur das
   * Poster gezeigt und die Play/Pause-Steuerung entfällt.
   */
  videoSrc?: string;
  /**
   * Standbild hinter dem Video. Ohne Angabe wird das Bild `halle` aus dem
   * Register genommen, sonst die abstrakte Ersatzgrafik.
   */
  poster?: string;
  /**
   * Abspielgeschwindigkeit. Werte < 1 verlangsamen das Video, ohne dass es
   * neu gerendert werden muss – nützlich, wenn eine Drohnenfahrt zu hektisch
   * wirkt. 0.6 heißt: 60 % der Originalgeschwindigkeit.
   */
  playbackRate?: number;
  /**
   * true, wenn der Titel bereits fest im Video steht.
   *
   * Die Überschrift wird dann nur so lange angezeigt, wie das Video nicht
   * läuft – also beim Laden, bei reduzierter Bewegung und bei blockiertem
   * Autoplay. Sobald die Wiedergabe beginnt, blendet sie aus, damit der Text
   * nicht doppelt im Bild steht. Im Markup bleibt sie immer erhalten.
   */
  titelImVideo?: boolean;
  /** Blendet den Platzhalter-Hinweis ein, solange kein echtes Video vorliegt. */
  platzhalter?: boolean;
  /**
   * Ziel des Scroll-Pfeils unten links. Muss die id eines Abschnitts auf
   * derselben Seite sein. Wird nur ohne JavaScript wirklich als Anker
   * benutzt – sonst scrollt das Skript und laesst die Adresse in Ruhe.
   */
  sprungziel?: string;
}

const {
  title,
  subtitle,
  claim,
  videoSrc,
  poster,
  playbackRate = 1,
  titelImVideo = false,
  platzhalter = !videoSrc,
  sprungziel = '#inhalt',
} = Astro.props;

// Reihenfolge: ausdrücklich gesetztes Poster, sonst das Foto aus dem
// Register, sonst die abstrakte Ersatzgrafik.
const halle = bild('halle');
const posterUrl = poster ? withBase(poster) : (halle?.quelle.src ?? withBase('/hero-poster.svg'));
const posterAlt = halle?.alt ?? '';

// MIME-Typ aus der Endung ableiten, damit neben MP4 auch WebM funktioniert.
const mimeTypes: Record<string, string> = {
  mp4: 'video/mp4',
  webm: 'video/webm',
  ogv: 'video/ogg',
};
const videoType = mimeTypes[videoSrc?.split('.').pop()?.toLowerCase() ?? ''] ?? 'video/mp4';
---

<section
  class="on-dark relative isolate flex min-h-[calc(100svh-5rem)] md:min-h-[calc(100svh-6rem)] flex-col items-center justify-center overflow-hidden bg-ink-deep text-white"
  data-hero
>
  <!-- Hintergrundebene. Feste Größe reserviert den Platz (CLS < 0.1). -->
  {
    videoSrc ? (
      <video
        class="absolute inset-0 -z-10 size-full object-cover"
        poster={posterUrl}
        width="1920"
        height="1080"
        muted
        loop
        playsinline
        preload="metadata"
        aria-label={`Hintergrundvideo: ${title}`}
        data-playback-rate={playbackRate}
        data-hero-video
      >
        <source src={withBase(videoSrc)} type={videoType} />
      </video>
    ) : (
      <img
        class="absolute inset-0 -z-10 size-full object-cover"
        src={posterUrl}
        width="1920"
        height="1080"
        alt={posterAlt}
        fetchpriority="high"
      />
    )
  }

  <!--
    Zwei Ebenen statt einer festen Abdunklung:

    Grundschleier – nur noch ein Hauch am unteren Rand. Oben braucht es keinen:
    die Navigationsleiste steht auf einer eigenen weißen Fläche. Unten fängt er
    den Scroll-Hinweis ab, der sonst auf hellem Hallenboden verschwindet.

    Titelschleier – eine weiche Ellipse genau dort, wo die Überschrift steht.
    Eine flächige Abdunklung über dem ganzen Bild wäre einfacher, legt aber
    einen sichtbaren Schleier über das Motiv; die Ellipse läuft zum Rand hin
    auf null aus, sodass die Ecken des Bildes unangetastet bleiben. Nötig ist
    sie, weil die erste Einstellung eine fast weiße Halle zeigt – weißer Text
    ohne Abdunklung wäre dort unlesbar.

    Steht der Titel bereits fest im Video, blendet die Ellipse zusammen mit der
    Überschrift aus, sobald die Wiedergabe läuft.
  -->
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-b from-transparent via-transparent to-ink-deep/30"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-0 -z-10 transition-opacity duration-500 bg-[radial-gradient(ellipse_76%_58%_at_50%_50%,rgba(0,0,0,0.66)_0%,rgba(0,0,0,0.50)_45%,rgba(0,0,0,0.18)_70%,rgba(0,0,0,0)_86%)]"
    aria-hidden="true"
    data-hero-scrim={titelImVideo ? 'nur-pausiert' : undefined}
  >
  </div>

  <div
    class="container-page text-center transition-opacity duration-500 [text-shadow:0_2px_24px_rgba(0,0,0,0.55)]"
    data-hero-titel={titelImVideo ? 'nur-pausiert' : undefined}
  >
    <h1 class="font-display text-5xl sm:text-6xl lg:text-8xl font-semibold tracking-tight">
      {title}
    </h1>
    {
      subtitle && (
        <p class="mt-3 font-display text-2xl sm:text-3xl lg:text-5xl font-light text-white/95">
          {subtitle}
        </p>
      )
    }
    {
      claim && (
        <p class="mx-auto mt-7 max-w-2xl font-sans text-xs uppercase leading-relaxed tracking-[0.14em] text-white sm:text-sm sm:tracking-[0.22em] md:mt-9 lg:text-base">
          {claim}
        </p>
      )
    }
  </div>

  <!-- Scroll-Hinweis, wie in der Referenz unten links.
       href bleibt als Rueckfall stehen, damit der Sprung auch ohne
       JavaScript funktioniert. Das Skript unten faengt den Klick ab und
       scrollt selbst, damit kein Anker in der Adresszeile landet.
       Ziel ist der erste Abschnitt unter dem Hero – nicht #inhalt, denn
       <main> beginnt beim Hero selbst, der Sprung liefe ins Leere. -->
  <a
    href={sprungziel}
    data-hero-sprung
    class="absolute bottom-8 left-5 md:left-10 grid size-11 place-items-center bg-black/50 text-white hover:bg-black/70 transition-colors duration-200"
    aria-label="Zum Seiteninhalt springen"
  >
    <svg
      class="size-7 motion-safe:animate-bounce"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M12 4v15m0 0 6-6m-6 6-6-6"></path>
    </svg>
  </a>

  {
    videoSrc && (
      <button
        type="button"
        class="absolute bottom-8 right-5 md:right-10 grid size-11 place-items-center bg-black/50 text-white hover:bg-black/70 transition-colors duration-200 cursor-pointer"
        aria-label="Video pausieren"
        data-hero-playpause
      >
        <svg
          class="size-5"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          data-icon-pause
        >
          <path d="M8 5h3v14H8zM13 5h3v14h-3z" />
        </svg>
        <svg
          class="size-5 hidden"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          data-icon-play
        >
          <path d="M8 5v14l11-7z" />
        </svg>
      </button>
    )
  }

  {
    platzhalter && (
      <p class="absolute bottom-24 sm:bottom-8 left-1/2 w-max max-w-[calc(100vw-2.5rem)] -translate-x-1/2 rounded-full border border-white/40 bg-black/50 px-4 py-1.5 text-xs tracking-wide text-white">
        PLATZHALTER: Hero-Video folgt
      </p>
    )
  }
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const button = document.querySelector<HTMLButtonElement>('[data-hero-playpause]');

  if (video) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Manche Browser setzen playbackRate beim Laden bzw. beim Start zurück,
    // deshalb an mehreren Stellen erneut anwenden.
    const rate = Number(video.dataset.playbackRate ?? '1') || 1;
    const applyRate = () => {
      if (video.playbackRate !== rate) video.playbackRate = rate;
    };
    applyRate();
    video.addEventListener('loadedmetadata', applyRate);
    video.addEventListener('play', applyRate);
    const iconPause = button?.querySelector('[data-icon-pause]');
    const iconPlay = button?.querySelector('[data-icon-play]');

    const syncButton = () => {
      if (!button) return;
      const playing = !video.paused;
      button.setAttribute('aria-label', playing ? 'Video pausieren' : 'Video abspielen');
      iconPause?.classList.toggle('hidden', !playing);
      iconPlay?.classList.toggle('hidden', playing);
    };

    /** true, sobald die Person das Video bewusst pausiert hat. */
    let pausedByUser = reduced.matches;

    const tryPlay = () => {
      if (pausedByUser || reduced.matches) return;
      void video.play().catch(() => {
        /* Autoplay kann vom Browser blockiert werden – Poster bleibt sichtbar. */
      });
    };

    // Bei reduzierter Bewegung bleibt das Poster stehen, kein Autoplay.
    if (!reduced.matches) tryPlay();
    syncButton();

    video.addEventListener('play', syncButton);
    video.addEventListener('pause', syncButton);

    /* Steht der Titel schon im Video, wird die Überschrift der Seite nur
       eingeblendet, solange das Video steht. So ist immer genau ein Titel
       sichtbar – und bei fehlendem Autoplay bleibt der Hero nicht stumm. */
    const titel = document.querySelector<HTMLElement>('[data-hero-titel="nur-pausiert"]');
    const scrim = document.querySelector<HTMLElement>('[data-hero-scrim="nur-pausiert"]');
    if (titel || scrim) {
      const syncTitel = () => {
        const laeuft = !video.paused && !video.ended && video.readyState >= 3;
        titel?.classList.toggle('opacity-0', laeuft);
        scrim?.classList.toggle('opacity-0', laeuft);
      };
      syncTitel();
      for (const ereignis of ['playing', 'pause', 'ended', 'waiting', 'emptied'] as const) {
        video.addEventListener(ereignis, syncTitel);
      }
    }

    button?.addEventListener('click', () => {
      if (video.paused) {
        pausedByUser = false;
        tryPlay();
      } else {
        pausedByUser = true;
        video.pause();
      }
    });

    // Außerhalb des Viewports pausieren (Akku, Daten, CPU).
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry) return;
        if (entry.isIntersecting) tryPlay();
        else video.pause();
      },
      { threshold: 0.15 },
    );
    observer.observe(video);

    reduced.addEventListener('change', (event) => {
      if (event.matches) {
        pausedByUser = true;
        video.pause();
      }
    });
  }

  /* Der Pfeil scrollt selbst, statt den Anker zu benutzen. Damit bleibt die
     Adresse sauber (/ statt /#themen). Das Ziel wird aus dem href gelesen,
     der Rueckfall ohne JavaScript und das Skript koennen so nicht
     auseinanderlaufen. Der Fokus wandert mit, sonst saesse die Tastatur
     nach dem Sprung weiter im Hero. */
  const sprung = document.querySelector<HTMLAnchorElement>('[data-hero-sprung]');
  const ziel = sprung && document.querySelector<HTMLElement>(sprung.getAttribute('href') ?? '');

  if (sprung && ziel) {
    sprung.addEventListener('click', (ereignis) => {
      // Neuer Tab, Mittelklick usw. dem Browser ueberlassen.
      if (ereignis.defaultPrevented || ereignis.metaKey || ereignis.ctrlKey) return;
      ereignis.preventDefault();
      const sanft = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      ziel.scrollIntoView({ behavior: sanft ? 'smooth' : 'auto', block: 'start' });
      // Abschnitte sind nicht von Haus aus fokussierbar; ohne das bliebe die
      // Tastatur oben stehen und tabbte erneut durch den Hero.
      if (!ziel.hasAttribute('tabindex')) ziel.setAttribute('tabindex', '-1');
      ziel.focus({ preventScroll: true });
    });
  }
</script>
