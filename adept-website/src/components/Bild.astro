---
import { Image } from 'astro:assets';
import { bild } from '../lib/images';
import type { BildKey } from '../data/images';
import { bildFokus } from '../data/images';

interface Props {
  /** Schlüssel aus dem Bildregister. Fehlt die Datei, greift die Ersatzfläche. */
  name?: BildKey;
  ratio?: '16/9' | '4/3' | '3/2' | '21/9' | 'fill';
  /** Bestimmt die Farbstimmung der Ersatzfläche, damit Kacheln sich unterscheiden. */
  index?: number;
  /** Abdunkler über dem Bild – nötig, sobald Text darauf steht. */
  scrim?: 'none' | 'sanft' | 'kraeftig' | 'unten';
  /** Erstes Bild im Viewport nicht verzögert laden. */
  priority?: boolean;
  /** Sichtbare Breite des Bildes, für die Auswahl der passenden Auflösung. */
  sizes?: string;
  /** Sanftes Heranfahren beim Überfahren der umgebenden Gruppe. */
  zoom?: boolean;
  /**
   * Scrollgesteuerte Bewegung. Wird auf das Bild selbst gelegt, nicht auf den
   * Rahmen – so bleibt die Skalierung innerhalb des beschnittenen Rahmens und
   * schiebt nichts über den Viewport hinaus.
   */
  parallax?: boolean;
  class?: string;
}

const {
  name,
  ratio = '16/9',
  index = 0,
  scrim = 'none',
  priority = false,
  sizes = '(min-width: 1280px) 33vw, (min-width: 768px) 50vw, 100vw',
  zoom = false,
  parallax = false,
  class: className = '',
} = Astro.props;

const quelle = name ? bild(name) : null;

const ratios: Record<string, string> = {
  '16/9': 'aspect-16/9',
  '4/3': 'aspect-4/3',
  '3/2': 'aspect-3/2',
  '21/9': 'aspect-21/9',
  fill: 'size-full',
};

// Ersatzflächen in der Markenpalette. Kein Rot, durchgehend kühl.
const flaechen = [
  'from-[#000000] via-[#1c1c1c] to-[#3a3a3a]',
  'from-[#2b2b2b] via-[#111111] to-[#000000]',
  'from-[#151515] via-[#000000] to-[#2f2f2f]',
];
const flaeche = flaechen[index % flaechen.length];

const scrims: Record<string, string> = {
  none: '',
  sanft: 'bg-ink-deep/20',
  kraeftig: 'bg-ink-deep/45',
  unten: 'bg-gradient-to-t from-ink-deep/90 via-ink-deep/35 via-35% to-transparent',
};
---

<div class:list={['relative overflow-hidden bg-ink-deep', ratios[ratio], className]}>
  {
    quelle ? (
      <Image
        src={quelle.quelle}
        alt={quelle.alt}
        widths={[480, 800, 1200, 1672]}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={priority ? 'high' : 'auto'}
        style={name && bildFokus[name] ? `object-position:${bildFokus[name]}` : undefined}
        class:list={[
          'size-full object-cover',
          zoom && 'transition-transform duration-700 ease-out group-hover:scale-[1.04]',
          parallax && 'faehrt-heran',
        ]}
      />
    ) : (
      <>
        <div
          class:list={[
            'size-full bg-gradient-to-br',
            flaeche,
            zoom && 'transition-transform duration-700 ease-out group-hover:scale-[1.04]',
            parallax && 'faehrt-heran',
          ]}
          aria-hidden="true"
        />
        {/*
          Ein weicher Lichtschein aus einer Ecke statt eines Rasters. Er gibt
          der Fläche Tiefe, ohne dass ein Muster darüberliegt.
        */}
        <div
          class="pointer-events-none absolute inset-0 [background-image:radial-gradient(90%_70%_at_18%_8%,rgba(255,255,255,0.16)_0%,transparent_60%)]"
          aria-hidden="true"
        />
        <div
          class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink-deep/70 to-transparent"
          aria-hidden="true"
        />
        
      </>
    )
  }

  {
    scrim !== 'none' && (
      <div class:list={['pointer-events-none absolute inset-0', scrims[scrim]]} aria-hidden="true" />
    )
  }

  <slot />
</div>
