---
import { withBase } from '../lib/url';
import Bild from './Bild.astro';
import type { BildKey } from '../data/images';

interface Props {
  kicker?: string;
  title: string;
  lead?: string;
  breadcrumb?: { label: string; href: string }[];
  /** Hintergrundbild. Ohne Angabe bleibt der Kopf einfarbig. */
  bild?: BildKey;
}

const { kicker, title, lead, breadcrumb = [], bild } = Astro.props;
---

<div class="on-dark relative isolate overflow-hidden bg-ink-deep text-white">
  {
    bild && (
      <div class="absolute inset-0 -z-10">
        <Bild name={bild} ratio="fill" priority parallax sizes="100vw" class="size-full" />
        {/*
          Nur eine leichte Abdunklung, damit das Motiv Helligkeit und Kontrast
          behaelt. Den Textkontrast sichert der massive Block darunter, nicht
          eine flaechige Abdunklung des Bildes.
        */}
        <div class="absolute inset-0 bg-ink-deep/20" aria-hidden="true" />
      </div>
    )
  }
  <div class:list={['container-page', bild ? 'py-0' : 'py-16 md:py-24']}>
    <div
      class:list={[
        bild &&
          // Der Block laeuft bis an den linken Rand durch; die negativen
          // Aussenabstaende spiegeln die Innenabstaende von .container-page.
          'bg-ink-deep/95 -ml-5 -mr-5 px-5 py-14 sm:px-10 md:-ml-10 md:-mr-10 md:py-20 lg:mr-0 lg:max-w-3xl lg:pr-14 xl:max-w-4xl min-[90rem]:-ml-16 min-[90rem]:pl-16',
      ]}
    >
    {
      breadcrumb.length > 0 && (
        <nav aria-label="Brotkrumennavigation" class="mb-6">
          <ol class="flex flex-wrap items-center gap-x-2 text-sm text-white/70">
            {breadcrumb.map((crumb, index) => (
              <li class="flex items-center gap-2">
                {index > 0 && <span aria-hidden="true">/</span>}
                <a
                  href={withBase(crumb.href)}
                  class="inline-flex min-h-11 items-center hover:text-white transition-colors duration-200"
                >
                  {crumb.label}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    {
      kicker && (
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent-on-dark">{kicker}</p>
      )
    }
    <h1 class="mt-3 text-3xl sm:text-5xl lg:text-6xl">{title}</h1>
      {lead && <p class="prose-measure mt-6 text-lg text-white/80">{lead}</p>}
    </div>
  </div>
</div>
