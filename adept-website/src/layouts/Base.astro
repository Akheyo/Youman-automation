---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/url';
import { bild } from '../lib/images';
import { site } from '../data/site';
import { kontakt } from '../data/kontakt';
import { anbieter, anbieterVollstaendig } from '../data/anbieter';
import { indexierungErlaubt } from '../data/sichtbarkeit';

/*
 * Die drei lateinischen Schriftschnitte werden hier eingebunden, damit ihre
 * fertigen Adressen bekannt sind und vorab angemeldet werden koennen.
 *
 * Ohne das findet der Browser sie erst, nachdem er das Stylesheet gelesen
 * hat. Bis sie da sind, steht der Text in der Ersatzschrift; beim Wechsel
 * bricht er neu um und schiebt den Inhalt. Auf /ueber-uns hat das einen
 * CLS von 0.103 verursacht, also ueber dem Grenzwert von 0.1.
 *
 * Die uebrigen Schnitte (kyrillisch, griechisch, vietnamesisch) bleiben
 * unangemeldet. Sie laden wegen unicode-range bei deutschem Text ohnehin nie.
 */
import schriftSerif from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import schriftDisplay from '@fontsource-variable/lexend/files/lexend-latin-wght-normal.woff2?url';
import schriftSans from '@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url';
import type { BildKey } from '../data/images';

interface Props {
  title: string;
  description?: string;
  /** Wenn true, wird die Seite von Suchmaschinen ausgeschlossen. */
  noindex?: boolean;
  /**
   * Bild für die Vorschau beim Teilen. Ohne Angabe greift das Standbild des
   * Hero-Videos. Ein seitenspezifisches Bild ist deutlich klickstärker als
   * überall dasselbe.
   */
  bild?: BildKey;
  /**
   * Brotkrumenpfad ohne die aktuelle Seite. Erzeugt die BreadcrumbList für
   * Suchmaschinen; Google zeigt daraus den Pfad statt der nackten URL an.
   */
  breadcrumb?: { label: string; href: string }[];
  /**
   * Setzen, wenn die Seite ein redaktioneller Beitrag ist. Erzeugt zusätzlich
   * ein Article-Objekt in den strukturierten Daten.
   */
  artikel?: { titel: string; beschreibung: string; datum: string | null };
}

const {
  title,
  description = site.description,
  noindex = false,
  bild: bildKey,
  breadcrumb = [],
  artikel,
} = Astro.props;

// Gesperrt ist eine Seite, wenn sie es selbst verlangt oder wenn die
// gesamte Seite noch nicht zur Indexierung freigegeben ist.
const gesperrt = noindex || !indexierungErlaubt;

const seitentitel = title === site.name ? `${site.name} ${site.region}` : `${title} | ${site.name}`;
const basis = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, basis);

// Absolute Adressen: relative Pfade sind in OpenGraph und in strukturierten
// Daten nicht zulässig, manche Dienste ignorieren sie stillschweigend.
const absolut = (pfad: string) => new URL(pfad, basis).href;

const seitenbild = bildKey ? bild(bildKey) : null;
const ogImage = absolut(seitenbild ? seitenbild.quelle.src : withBase('/hero-poster.jpg'));

const organisation = {
  '@type': 'Organization',
  '@id': absolut(withBase('/')) + '#organisation',
  name: 'adept&',
  url: absolut(withBase('/')),
  // Fuer Suchmaschinen die Wortmarke, nicht das Favicon: das Favicon ist
  // nur das kaufmaennische Und und ausserhalb des Browser-Tabs nicht als
  // Absender zu erkennen.
  logo: absolut(withBase('/logo-adept.png')),
  description: site.description,
  slogan: site.claim,
  areaServed: { '@type': 'Country', name: 'Deutschland' },
  knowsAbout: [
    'ERP-Integration',
    'SAP-Integration',
    'Prozessberatung',
    'Individualsoftware',
    'Produktionsplanung',
    'Logistiksoftware',
    'Warenwirtschaft',
  ],
  // Nur aufnehmen, was tatsächlich hinterlegt ist. Leere Felder in
  // strukturierten Daten sind schlechter als fehlende.
  ...(kontakt.email ? { email: kontakt.email } : {}),
  ...(kontakt.telefon ? { telephone: kontakt.telefon } : {}),

  /*
   * Anschrift und Gruendungsjahr aus denselben Daten wie das Impressum.
   * Die Anschrift ist der stärkste Ortsbezug, den strukturierte Daten
   * hergeben; ohne sie bleibt regionale Sichtbarkeit Zufall. Sie erscheint
   * nur vollstaendig, damit keine halbe Adresse in den Daten landet.
   */
  ...(anbieterVollstaendig
    ? {
        address: {
          '@type': 'PostalAddress',
          streetAddress: anbieter.strasse,
          postalCode: anbieter.plz,
          addressLocality: anbieter.ort,
          addressCountry: 'DE',
        },
      }
    : {}),
  ...(site.gruendungsjahr ? { foundingDate: site.gruendungsjahr } : {}),
  ...(anbieter.personen.length
    ? { founder: anbieter.personen.map((person) => ({ '@type': 'Person', name: person.name })) }
    : {}),
  ...(kontakt.email || kontakt.telefon
    ? {
        contactPoint: {
          '@type': 'ContactPoint',
          contactType: 'sales',
          areaServed: 'DE',
          availableLanguage: 'German',
          ...(kontakt.email ? { email: kontakt.email } : {}),
          ...(kontakt.telefon ? { telephone: kontakt.telefon } : {}),
        },
      }
    : {}),
};

// Der Brotkrumenpfad enthält die aktuelle Seite als letztes Glied – so
// erwartet es Google, auch wenn sie in der Anzeige nicht verlinkt ist.
const brotkrumenListe =
  breadcrumb.length > 0
    ? {
        '@type': 'BreadcrumbList',
        itemListElement: [...breadcrumb, { label: title, href: Astro.url.pathname }].map(
          (glied, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: glied.label,
            item: absolut(glied.href.startsWith('/') ? withBase(glied.href) : glied.href),
          }),
        ),
      }
    : null;

const artikelObjekt = artikel
  ? {
      '@type': 'Article',
      headline: artikel.titel,
      description: artikel.beschreibung,
      image: ogImage,
      inLanguage: 'de-DE',
      mainEntityOfPage: canonical.href,
      author: { '@id': absolut(withBase('/')) + '#organisation' },
      publisher: { '@id': absolut(withBase('/')) + '#organisation' },
      // datePublished wird bewusst weggelassen, solange kein freigegebenes
      // Datum vorliegt – ein erfundenes Datum wäre schlimmer als keines.
      ...(artikel.datum ? { datePublished: artikel.datum } : {}),
    }
  : null;

/*
 * Ein WebSite-Knoten sagt Google, wie die Seite heisst. Ohne ihn leitet
 * Google den Namen aus der Domain ab, hier also "Adeptandpartners".
 */
const webseite = {
  '@type': 'WebSite',
  '@id': absolut(withBase('/')) + '#webseite',
  url: absolut(withBase('/')),
  name: site.name,
  inLanguage: 'de-DE',
  publisher: { '@id': absolut(withBase('/')) + '#organisation' },
};

const strukturierteDaten = {
  '@context': 'https://schema.org',
  '@graph': [organisation, webseite, brotkrumenListe, artikelObjekt].filter(Boolean),
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* crossorigin ist Pflicht: Schriften werden immer im CORS-Modus geholt.
        Ohne das Attribut laedt der Browser die Datei ein zweites Mal. */}
    <link rel="preload" as="font" type="font/woff2" href={schriftSerif} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={schriftDisplay} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={schriftSans} crossorigin />
    <title>{seitentitel}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {/* Der globale Schalter sticht die Einstellung der einzelnen Seite:
         solange die Seite nicht freigegeben ist, steht ueberall noindex. */}
    {gesperrt && <meta name="robots" content="noindex, nofollow" />}
    {
      !gesperrt && (
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
      )
    }

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#000000" />

    <meta property="og:type" content={artikel ? 'article' : 'website'} />
    <meta property="og:site_name" content="adept&" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={seitentitel} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={seitenbild?.alt ?? `${site.name} ${site.region}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seitentitel} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {indexierungErlaubt && <link rel="sitemap" href={withBase('/sitemap-index.xml')} />}

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(strukturierteDaten)}
    />

    <!-- Schaltet das Einblenden beim Scrollen frei. Steht im <head>, damit
         kein Aufblitzen entsteht, und ist bewusst inline: laeuft kein
         JavaScript, bleibt der Inhalt schlicht sofort sichtbar. -->
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('reveal-aktiv');
      }
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#inhalt"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-100 focus:bg-accent focus:px-4 focus:py-3 focus:text-white"
    >
      Zum Inhalt springen
    </a>

    <Header />

    <!-- tabindex="-1": ohne das nehmen manche Browser den Fokus beim
         Sprung nicht mit, die Tastatur bliebe oben stehen. Der Rahmen
         entfaellt, weil hier kein Bedienelement fokussiert wird. -->
    <main id="inhalt" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>

    <Footer />

    <script>
      /* Blendet Abschnitte beim Hereinscrollen ein. Ohne JavaScript oder bei
         reduzierter Bewegung bleibt alles sofort sichtbar – das CSS definiert
         den Ausgangszustand nur unter no-preference. */
      const ziele = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const zeigen = (el: Element) => el.classList.add('ist-sichtbar');

      if (ziele.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        if (!('IntersectionObserver' in window)) {
          // Ohne Unterstützung lieber alles sofort zeigen als etwas verstecken.
          ziele.forEach(zeigen);
        } else {
          const beobachter = new IntersectionObserver(
            (eintraege) => {
              for (const eintrag of eintraege) {
                if (!eintrag.isIntersecting) continue;
                zeigen(eintrag.target);
                beobachter.unobserve(eintrag.target);
              }
            },
            // Positiver unterer Rand: der Abschnitt blendet ein, kurz bevor er
            // ins Bild kommt. Ein negativer Wert würde ihn zu spät auslösen.
            { rootMargin: '0px 0px 12% 0px', threshold: 0 },
          );
          for (const ziel of ziele) beobachter.observe(ziel);
        }
      }
    </script>
  </body>
</html>
