{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DAEV Margin Tool",
  "version": "1.0.0",
  "identifier": "com.daev.margin-tool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DAEV Margin Tool",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["German", "English"]
      }
    },
    "category": "Productivity",
    "shortDescription": "Margen-Kalkulation für Gebrauchtwagen",
    "longDescription": "DAEV Margin Tool — lokales Werkzeug für Gebrauchtwagenhändler. Erfasst Einkauf, Kosten, Arbeitsstunden und Verkauf und berechnet Gewinnanteil und Marge nach §25a UStG (Differenzbesteuerung)."
  }
}
