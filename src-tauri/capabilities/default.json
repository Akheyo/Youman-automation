{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Standard-Capabilities: Hauptfenster + Lese-/Schreibzugriff auf den Speicherordner im Dokumente-Verzeichnis (für Auto-Sync via OneDrive).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-rename",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$DOCUMENT/DAEV Margin Tool/**" },
        { "path": "$DOCUMENT/DAEV Margin Tool" }
      ]
    }
  ]
}
