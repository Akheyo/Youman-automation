# ---------------------------------------------------------------------------
# Komplett Konzept — Dashboard
# Diese Datei nach ".env" kopieren und ausfüllen. Die .env bleibt auf dem
# Server und wird NICHT ins Git eingecheckt.
# ---------------------------------------------------------------------------

# Domain für das Dashboard.
#   Mit Domain:  DOMAIN=dashboard.beispiel.de   (HTTPS automatisch)
#   Ohne Domain: DOMAIN=:80                     (nur über die Server-IP)
DOMAIN=:80

# Öffentliche Adresse der App. Bei HTTPS bitte https:// eintragen —
# davon hängt ab, ob das Login-Cookie als "secure" markiert wird.
APP_URL=http://localhost

# --- Datenbank (Supabase) --------------------------------------------------
# Im Supabase-Dashboard unter "Connect" zu finden.
# Den Pooler nehmen, nicht die direkte Verbindung:
#   postgresql://postgres.<projekt>:<passwort>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- Sitzungen -------------------------------------------------------------
# Schlüssel zum Signieren der Login-Cookies. Ändern = alle werden ausgeloggt.
# Erzeugen mit:  openssl rand -hex 32
SESSION_SECRET=

# --- Anschlussstelle für Automationen --------------------------------------
# Schlüssel, mit dem sich Automationen (n8n, Cronjobs, Skripte) beim Melden
# ihrer Läufe ausweisen. Wer ihn hat, kann Einträge im Dashboard erzeugen.
# Erzeugen mit:  openssl rand -hex 32
INGEST_TOKEN=

# --- Sonstiges -------------------------------------------------------------
TZ=Europe/Berlin

# ---------------------------------------------------------------------------
# Maschinensucher — markierte Artikel auf den Marktplatz
# ---------------------------------------------------------------------------
# Zwei Hälften: Ein Abgleich holt die Artikeldaten aus PlentyONE in die
# Tabelle "artikel", und Maschinensucher holt nachts eine Importdatei bei uns
# ab, die AUSSCHLIESSLICH aus dieser Tabelle entsteht.

# --- PlentyONE (nur lesend, nur für den Abgleich) --------------------------
# Basis-URL der REST-API, ohne "/rest" am Ende,
# z. B. https://xxxxx.plentymarkets-cloud01.com
PLENTY_BASE_URL=
PLENTY_USER=
PLENTY_PASSWORD=
# Aus welcher Preisliste der Preis kommt (Backend → Einrichtung → Artikel →
# Verkaufspreise). Leer = die kleinste vorhandene ID, üblicherweise die
# Hauptpreisliste. Welche genommen wurde, steht in der Diagnose des Laufs.
PLENTY_SALES_PRICE_ID=
# Wie viel ein Abgleichs-Abschnitt liest. Höher = schneller durch, aber jeder
# Lauf dauert länger. 5 Seiten à 50 Varianten sind ein guter Anfang.
PLENTY_SYNC_SEITEN=5
# Bildabrufe je Abschnitt (ein Aufruf je Artikel). Geholt wird nur für
# Artikel ohne Bilder und für markierte.
PLENTY_SYNC_BILDER=150

# --- Die Abholadresse ------------------------------------------------------
# Das Geheimnis in der Adresse, die im Maschinensucher-Konto hinterlegt wird.
# Mindestens 16 Zeichen. Erzeugen mit:  openssl rand -hex 24
# ACHTUNG: Wer diese Adresse hat, sieht unseren markierten Bestand samt
# Preisen. Ein neues Token macht jede alte Adresse sofort wertlos. Ohne Token
# ist die Strecke AUS.
MASCHINENSUCHER_FEED_TOKEN=

# Die Kopfzeile der offiziellen Beispieldatei aus dem Maschinensucher-Konto,
# unverändert eingefügt. Sie ist die einzige verbindliche Quelle für die
# Spaltenreihenfolge — ohne sie geht unsere Standardreihenfolge raus, und die
# ist eine Annahme.
MASCHINENSUCHER_KOPFZEILE=

# Dateiformat. Vorgabe: Semikolon, UTF-8 (mit BOM), Umbrüche im Text werden zu
# Leerzeichen. "tab" ist als Trennzeichen ausschreibbar.
MASCHINENSUCHER_TRENNER=;
MASCHINENSUCHER_KODIERUNG=utf-8
MASCHINENSUCHER_UMBRUECHE=entfernen

# --- Preis -----------------------------------------------------------------
# Auf dem Marktplatz wird NETTO ausgezeichnet. Führt Plenty brutto (Vorgabe),
# wird mit diesem Satz heruntergerechnet.
MASCHINENSUCHER_PREIS_IST=brutto
MASCHINENSUCHER_MWST=19

# --- Kategorie -------------------------------------------------------------
# PFLICHT: ohne Rubrik nimmt Maschinensucher kein Inserat an.
# MASCHINENSUCHER_KATEGORIE ist die Auffangkategorie; die Zuordnung
# "Suchwort=Kategorie" greift davor, und eine am Artikel gesetzte Rubrik
# gewinnt gegen beides.
MASCHINENSUCHER_KATEGORIE=
MASCHINENSUCHER_KATEGORIEN=drehmaschine=,fraesmaschine=,saege=,kompressor=

# --- Standort und Kontakt am Inserat ---------------------------------------
# PFLICHT: Maschinensucher sortiert nach Standort, und eine Anfrage ohne
# Empfänger ist eine verlorene Anfrage.
MASCHINENSUCHER_LAND=DE
MASCHINENSUCHER_PLZ=
MASCHINENSUCHER_ORT=
MASCHINENSUCHER_ANSPRECHPARTNER=
MASCHINENSUCHER_TELEFON=
MASCHINENSUCHER_EMAIL=maschinensucher@komplett-konzept.de

# --- Kleinkram -------------------------------------------------------------
# Vorsatz der Inseratsnummer. Trägt die Variantennummer ihn schon, wird er
# nicht doppelt gesetzt. Ändern heißt: alle Inserate gelten als neu.
MASCHINENSUCHER_NUMMER_PRAEFIX=KK-
# Ab wann Artikeldaten in der Oberfläche als veraltet gemeldet werden (Tage
# ohne Abgleich). Hält kein Inserat auf, steht nur als Hinweis an der Zeile.
MASCHINENSUCHER_VERALTET_TAGE=3
# Adresse des eigenen Shops, für den Link am Inserat. Leer = kein Link.
SHOP_BASIS_URL=
