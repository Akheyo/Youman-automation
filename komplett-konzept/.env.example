# ---------------------------------------------------------------------------
# Komplett Konzept — Dashboard
# Diese Datei nach ".env" kopieren und ausfuellen. Die .env bleibt auf dem
# Server und wird NICHT ins Git eingecheckt.
# ---------------------------------------------------------------------------

# Domain fuer das Dashboard.
#   Mit Domain:  DOMAIN=dashboard.beispiel.de   (HTTPS automatisch)
#   Ohne Domain: DOMAIN=:80                     (nur ueber die Server-IP)
DOMAIN=:80

# Oeffentliche Adresse der App (fuer Links in Mails o.ae.)
APP_URL=http://localhost

# --- Datenbank -------------------------------------------------------------
POSTGRES_DB=komplett_konzept
POSTGRES_USER=kk
# Sicheres Passwort erzeugen:  openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Sitzungen -------------------------------------------------------------
# Schluessel zum Signieren der Login-Cookies. Aendern = alle werden ausgeloggt.
# Erzeugen mit:  openssl rand -hex 32
SESSION_SECRET=

# --- Sonstiges -------------------------------------------------------------
TZ=Europe/Berlin
