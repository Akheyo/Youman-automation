# ---------------------------------------------------------------------------
# Komplett Konzept — Dashboard
# Diese Datei nach ".env" kopieren und ausfüllen. Die .env bleibt auf dem
# Server und wird NICHT ins Git eingecheckt.
# ---------------------------------------------------------------------------

# Domain für das Dashboard.
#   Mit Domain:  DOMAIN=dashboard.beispiel.de   (HTTPS automatisch)
#   Ohne Domain: DOMAIN=:80                     (nur über die Server-IP)
DOMAIN=:80

# Öffentliche Adresse der App. Bei HTTPS bitte https:// eintragen —
# davon hängt ab, ob das Login-Cookie als "secure" markiert wird.
APP_URL=http://localhost

# --- Datenbank (Supabase) --------------------------------------------------
# Im Supabase-Dashboard unter "Connect" zu finden.
# Den Pooler nehmen, nicht die direkte Verbindung:
#   postgresql://postgres.<projekt>:<passwort>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- Sitzungen -------------------------------------------------------------
# Schlüssel zum Signieren der Login-Cookies. Ändern = alle werden ausgeloggt.
# Erzeugen mit:  openssl rand -hex 32
SESSION_SECRET=

# --- Anschlussstelle für Automationen --------------------------------------
# Schlüssel, mit dem sich Automationen (n8n, Cronjobs, Skripte) beim Melden
# ihrer Läufe ausweisen. Wer ihn hat, kann Einträge im Dashboard erzeugen.
# Erzeugen mit:  openssl rand -hex 32
INGEST_TOKEN=

# --- Sonstiges -------------------------------------------------------------
TZ=Europe/Berlin
