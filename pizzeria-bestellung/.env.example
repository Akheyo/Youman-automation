# --- Stripe -----------------------------------------------------------------
# Dashboard → Entwickler → API-Schlüssel. Zum Testen die Test-Schlüssel (sk_test_…).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Dashboard → Entwickler → Webhooks → Endpunkt anlegen → "Signing secret" (whsec_…)
STRIPE_WEBHOOK_SECRET=

# --- Datenbank (Supabase) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Service-Role-Key. Nur serverseitig, niemals ins Frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Shop -------------------------------------------------------------------
# Öffentliche Adresse des Shops, für die Rückleitung aus dem Stripe-Checkout.
NEXT_PUBLIC_SHOP_URL=https://bestellen.pizzeria-borken.de

# --- Küche ------------------------------------------------------------------
# Webhook, der den Bon druckt und das Tablet klingeln lässt (z. B. n8n).
KUECHE_WEBHOOK_URL=
KUECHE_WEBHOOK_TOKEN=
# Schlüssel, mit dem sich das Küchen-Tablet beim Annehmen/Ablehnen ausweist.
# Lang und zufällig wählen: openssl rand -hex 32
KUECHEN_TOKEN=
