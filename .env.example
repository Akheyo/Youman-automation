# ============================================================================
# A&B PV-Konfigurator — Environment Variables
# ============================================================================
# Copy this file to `.env.local` and fill in real values.
# Public keys (NEXT_PUBLIC_*) are exposed to the browser bundle. Restrict them
# at the provider's dashboard (HTTP-Referer / domain whitelist) before going
# live.
# ============================================================================

# ---- Mapbox ----------------------------------------------------------------
# Public token used by Mapbox GL JS (if/when 2D fallback map is shown).
# Restrict at https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_public_token_here

# Optional: secret token for server-side Geocoding requests (no scope limits).
# If empty, the public token above is used.
MAPBOX_SECRET_TOKEN=

# ---- Cesium Ion ------------------------------------------------------------
# Default token from cesium.com/ion gives access to World Terrain etc.
# Required for the 3D viewer.
NEXT_PUBLIC_CESIUM_ION_TOKEN=eyJhbGciOiJIUzI1NiJ9.your_token

# ---- NRW LoD2 Tileset (production 3D) -------------------------------------
# URL of the tileset.json after running scripts/lod2-pipeline/.
# Leave empty during development — the viewer shows an actionable banner
# and falls back to terrain + 2.5D solar segments instead of fake 3D buildings.
# Example:
# NEXT_PUBLIC_LOD2_TILESET_URL=https://lod2-nrw.r2.cloudflarestorage.com/borken/tileset.json
NEXT_PUBLIC_LOD2_TILESET_URL=

# ---- NRW Solarkataster (LANUK WFS) ----------------------------------------
# Optional: own CORS proxy URL (Cloudflare Worker). Falls back to corsproxy.io
# if not set. For production with high traffic, host your own.
# Example:
# NRW_WFS_PROXY=https://nrw-wfs-proxy.your-account.workers.dev/?
NRW_WFS_PROXY=

# Override the default WFS layer if NRW renames it.
NRW_WFS_LAYER=sk_dachflaechen

# ---- Overpass (OSM building footprints) -----------------------------------
# Optional: pin to a single mirror. Empty = use built-in cascade.
OVERPASS_URL=

# ---- Lead webhook ----------------------------------------------------------
# Where lead-form submissions are POSTed. Required for production.
# A&B can use a Zapier/Make/HubSpot webhook here.
LEAD_WEBHOOK_URL=

# Optional: HMAC secret to sign the webhook payload (X-Signature header).
LEAD_WEBHOOK_SECRET=

# ---- A&B Branding overrides (optional) ------------------------------------
# Override electricity price assumed in the sidebar (ct/kWh).
NEXT_PUBLIC_DEFAULT_PRICE_CT_KWH=35
# Override base electricity demand assumed (kWh/year).
NEXT_PUBLIC_DEFAULT_KWH_YEAR=4500
