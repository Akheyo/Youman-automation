# Copy to `.env` for `docker compose up`. None of these are required to start
# locally — defaults work — but you MUST set strong values before deploying
# to any public host.

POSTGRES_PASSWORD=adept_dev_change_me
POSTGRES_PORT=5432

BACKEND_PORT=3001

# Generate with: `openssl rand -hex 64`
JWT_SECRET=change_me_in_production_please_use_a_long_random_string
JWT_REFRESH_SECRET=change_me_too_in_production

# Comma-separated list of origins allowed to call the API.
# For the packaged Electron app keep `app://./` (production) and
# `http://localhost:5173` (Vite dev server).
ALLOWED_ORIGINS=http://localhost:5173,app://./
