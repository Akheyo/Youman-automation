# Copy to `.env` for local Docker Compose. For production, generate strong
# values via:
#   bash scripts/generate-secrets.sh > .env.production
# and pass that file into your hosting provider as environment variables.

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=adept_dev_change_me
POSTGRES_PORT=5432

# ─── Backend ─────────────────────────────────────────────────────────────────
BACKEND_PORT=3001

# ─── Secrets ─────────────────────────────────────────────────────────────────
# Generate with: `openssl rand -hex 64`
# NEVER use these defaults in production — they are public.
JWT_SECRET=change_me_in_production_please_use_a_long_random_string
JWT_REFRESH_SECRET=change_me_too_in_production

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API.
# Electron production renderer uses `app://./` — keep it in the list.
# Vite dev server: `http://localhost:5173`.
# Web frontend (if you build one): `https://app.your-domain.com`.
ALLOWED_ORIGINS=http://localhost:5173,app://./

# ─── Optional: Sentry (error tracking) ───────────────────────────────────────
# SENTRY_DSN=https://...@...ingest.sentry.io/...
# SENTRY_ENVIRONMENT=production
