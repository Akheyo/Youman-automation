# ============================================================================
# 3D Solar Planner – Environment Variables
# ============================================================================
# Copy this file to `.env.local` and fill in your values.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
# All other variables are server-side only and are used inside Next.js
# API routes. Never put a real Google API key into NEXT_PUBLIC_*.
# ============================================================================

# ---- Google Maps Geocoding (server side) -----------------------------------
# Used by /api/geocode to translate addresses into lat/lng.
# If empty, /api/geocode returns a 501 Not Implemented and the frontend
# falls back to a built-in mock geocoder for the demo addresses.
GOOGLE_MAPS_API_KEY=

# ---- Google Solar API (server side) ----------------------------------------
# Used by /api/detect-roof when the GoogleSolarRoofProvider is selected.
# If empty, the system falls back to MockRoofDetectionProvider.
GOOGLE_SOLAR_API_KEY=

# ---- Map basemap tiles (browser) -------------------------------------------
# A raster tile URL template for MapLibre, e.g. a Mapbox Satellite tileset,
# MapTiler key URL, or Esri World Imagery. Must contain {z}/{x}/{y}.
# If empty the app falls back to a light OSM-Carto basemap and shows a hint.
#
# Examples:
# NEXT_PUBLIC_TILE_URL=https://api.maptiler.com/maps/hybrid/{z}/{x}/{y}.jpg?key=YOUR_KEY
# NEXT_PUBLIC_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
NEXT_PUBLIC_TILE_URL=
NEXT_PUBLIC_TILE_ATTRIBUTION=
