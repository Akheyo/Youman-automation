# ============================================================================
# Youman Automation — Environment Variables
# ============================================================================
# Copy this file to `.env.local` (local) or set these in Vercel → Settings →
# Environment Variables (production). Public keys (NEXT_PUBLIC_*) are exposed to
# the browser bundle — restrict them at the provider's dashboard before launch.
# ============================================================================

# ---- Supabase (Login + Datenbank) -----------------------------------------
# Aus dem Supabase-Dashboard → Project Settings → API. PFLICHT für Login/SaaS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-Role-Key (GEHEIM, nur Server!) — für den Stripe-Webhook, der Pläne
# ohne eingeloggten Nutzer aktualisiert. NIEMALS im Browser verwenden.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe (Abo-Abrechnung) ----------------------------------------------
# Aus dem Stripe-Dashboard. Test-Keys beginnen mit sk_test_ / pk_test_,
# Live-Keys mit sk_live_ / pk_live_. PFLICHT für Bezahlung.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing-Secret des Stripe-Webhooks (Dashboard → Developers → Webhooks).
STRIPE_WEBHOOK_SECRET=
# Preis-IDs der Abo-Pläne (Stripe → Products → Preis → API-ID, beginnt mit price_).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# ---- App-URL ---------------------------------------------------------------
# Öffentliche Basis-URL der App. Wird für Stripe-Redirects, den Vapi-Webhook
# und den Google-OAuth-Callback gebraucht. Beide auf dieselbe Domain setzen,
# z. B. https://app.youman-automation.com
NEXT_PUBLIC_SITE_URL=
APP_URL=

# ---- Felix — KI-Lead-Scout (/felix) ---------------------------------------
# OpenRouter-API-Key für den Agenten „Felix", der Unternehmen findet und
# einschätzt. Server-seitig, NICHT im Browser. Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: Modell-Slug überschreiben (Standard: openai/gpt-4o-mini).
# Muss Tool-Calling unterstützen. https://openrouter.ai/models
FELIX_MODEL=
# Optional: eigene Domain für OpenRouter-Rankings (HTTP-Referer-Header).
OPENROUTER_SITE_URL=
# Hauptdatenquelle für Felix: Google Places API (New) — deutlich vollständiger
# als OpenStreetMap. Wenn gesetzt, nutzt Felix Google Places; sonst OSM/Overpass
# (gratis, aber lückenhaft). Google Cloud Console → „Places API (New)" aktivieren.
GOOGLE_MAPS_API_KEY=
# Versand-Webhook für die Pitch-Mail. Zeigt auf einen n8n-Webhook, der die Mail
# per SMTP verschickt (Body: { to, subject, html }). Ohne diese Variable kann
# Felix Pitches schreiben, aber nicht versenden.
FELIX_PITCH_WEBHOOK_URL=

# ---- Lina — KI-Telefon-Agent (/sales) -------------------------------------
# Vapi platziert die ausgehenden KI-Anrufe. Key + Telefonnummer-ID aus dem
# Vapi-Dashboard (https://dashboard.vapi.ai). Server-seitig, NICHT im Browser.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=

# ---- Google Calendar (Lina bucht Termine selbst) --------------------------
# OAuth-Client aus der Google Cloud Console (APIs & Services → Credentials →
# OAuth client ID, Typ „Web application"). Calendar API muss aktiviert sein.
# Autorisierter Redirect-URI = {APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---- Fehler-Monitoring (Sentry, optional) ---------------------------------
# DSN aus sentry.io (Projekt anlegen → Settings → Client Keys (DSN)). Ist die
# Variable leer, ist Sentry komplett inaktiv. Erst mit gesetztem DSN werden
# Fehler in Produktion gemeldet.
NEXT_PUBLIC_SENTRY_DSN=
