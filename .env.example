# ============================================================================
# A&B PV-Konfigurator — Environment Variables
# ============================================================================
# Copy this file to `.env.local` and fill in real values.
# Public keys (NEXT_PUBLIC_*) are exposed to the browser bundle. Restrict them
# at the provider's dashboard (HTTP-Referer / domain whitelist) before going
# live.
# ============================================================================

# ---- Mapbox ----------------------------------------------------------------
# Public token used by Mapbox GL JS (if/when 2D fallback map is shown).
# Restrict at https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_public_token_here

# Optional: secret token for server-side Geocoding requests (no scope limits).
# If empty, the public token above is used.
MAPBOX_SECRET_TOKEN=

# ---- Cesium Ion ------------------------------------------------------------
# Default token from cesium.com/ion gives access to World Terrain etc.
# Required for the 3D viewer.
NEXT_PUBLIC_CESIUM_ION_TOKEN=eyJhbGciOiJIUzI1NiJ9.your_token

# ---- NRW LoD2 Tileset (production 3D) -------------------------------------
# URL of the tileset.json after running scripts/lod2-pipeline/.
# Leave empty during development — the viewer shows an actionable banner
# and falls back to terrain + 2.5D solar segments instead of fake 3D buildings.
# Example:
# NEXT_PUBLIC_LOD2_TILESET_URL=https://lod2-nrw.r2.cloudflarestorage.com/borken/tileset.json
NEXT_PUBLIC_LOD2_TILESET_URL=

# ---- NRW Solarkataster (LANUK WFS) ----------------------------------------
# Optional: own CORS proxy URL (Cloudflare Worker). Falls back to corsproxy.io
# if not set. For production with high traffic, host your own.
# Example:
# NRW_WFS_PROXY=https://nrw-wfs-proxy.your-account.workers.dev/?
NRW_WFS_PROXY=

# Override the default WFS layer if NRW renames it.
NRW_WFS_LAYER=sk_dachflaechen

# ---- Overpass (OSM building footprints) -----------------------------------
# Optional: pin to a single mirror. Empty = use built-in cascade.
OVERPASS_URL=

# ---- Lead webhook ----------------------------------------------------------
# Where lead-form submissions are POSTed. Required for production.
# Point this at the n8n "A&B Vertrieb — Lead-Eingang" workflow:
#   https://youmanautomation.app.n8n.cloud/webhook/lead-intake
LEAD_WEBHOOK_URL=

# Optional: HMAC secret to sign the webhook payload (X-Signature header).
LEAD_WEBHOOK_SECRET=

# ---- Vertriebs-Dashboard (n8n API) -----------------------------------------
# Base URL of the n8n webhooks used by the /vertrieb dashboard. The dashboard's
# server routes append /vertrieb-leads (GET) and /vertrieb-update (POST).
# Example (n8n Cloud):
#   N8N_WEBHOOK_BASE_URL=https://youmanautomation.app.n8n.cloud/webhook
# Server-side only — NOT exposed to the browser.
N8N_WEBHOOK_BASE_URL=

# ---- Vertriebs-Dashboard Zugangsschutz (Basic Auth) -----------------------
# Schützt /vertrieb und /api/vertrieb/* per HTTP Basic Auth (middleware.ts).
# Das Sheet enthält personenbezogene Daten (DSGVO) — in Produktion PFLICHT.
# Sind beide Werte gesetzt, fragt der Browser einmalig User/Passwort ab.
# In Produktion ohne gesetzte Werte wird der Zugriff blockiert (fail closed).
VERTRIEB_BASIC_AUTH_USER=
VERTRIEB_BASIC_AUTH_PASSWORD=

# ---- Felix — KI-Lead-Scout (/felix) ---------------------------------------
# OpenRouter-API-Key für den Chat-Agenten „Felix", der Unternehmen aus
# OpenStreetMap (Overpass) findet und einschätzt. Server-seitig, NICHT im
# Browser. Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: Modell-Slug überschreiben (Standard: openai/gpt-4o-mini).
# Muss Tool-Calling unterstützen. Beispiele: openai/gpt-4o,
# anthropic/claude-3.7-sonnet, google/gemini-2.0-flash-001.
# Gültige Slugs findest du unter https://openrouter.ai/models
FELIX_MODEL=
# Optional: eigene Domain für OpenRouter-Rankings (HTTP-Referer-Header).
OPENROUTER_SITE_URL=
# Hauptdatenquelle für Felix: Google Places API (New) — deutlich vollständiger
# als OpenStreetMap. Wenn gesetzt, nutzt Felix Google Places; sonst OSM/Overpass
# (gratis, aber lückenhaft). Key: Google Cloud Console → „Places API (New)"
# aktivieren + Billing. https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=
# Versand-Webhook für „Paul" (Pitch-Mail). Zeigt auf einen n8n-Webhook, der die
# Mail per SMTP verschickt (Body: { to, subject, html }). Beispiel:
#   https://youmanautomation.app.n8n.cloud/webhook/felix-pitch-send
# Ohne diese Variable kann Felix Pitches schreiben, aber nicht versenden.
FELIX_PITCH_WEBHOOK_URL=

# ---- SaaS: Supabase (Login + Datenbank) -----------------------------------
# Aus dem Supabase-Dashboard → Project Settings → API.
# Sind diese gesetzt, läuft Felix als SaaS hinter Login + Nutzungslimits.
# Sind sie LEER, läuft alles offen wie bisher (kein Login).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-Role-Key (geheim, nur Server!) — für den Stripe-Webhook, der Pläne
# ohne eingeloggten Nutzer aktualisiert. NICHT im Browser verwenden.
SUPABASE_SERVICE_ROLE_KEY=

# ---- SaaS: Stripe (Abo-Abrechnung) ----------------------------------------
# Aus dem Stripe-Dashboard. Test-Keys beginnen mit sk_test_ / pk_test_.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing-Secret des Stripe-Webhooks (Dashboard → Developers → Webhooks).
STRIPE_WEBHOOK_SECRET=
# Preis-IDs der Abo-Pläne (Stripe → Products → Preis → API-ID, beginnt mit price_).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
# Öffentliche Basis-URL der App (für Stripe-Redirects), z. B. https://app.youman-automation.com
NEXT_PUBLIC_SITE_URL=

# ---- Lina — KI-Telefon-Agent (/sales) -------------------------------------
# Vapi platziert die ausgehenden KI-Anrufe. Key + Telefonnummer-ID aus dem
# Vapi-Dashboard (https://dashboard.vapi.ai → API Keys / Phone Numbers).
# Server-seitig, NICHT im Browser.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
# Öffentliche Basis-URL der App — Vapi ruft hierüber den Webhook auf
# (/api/sales/vapi-webhook) und Google leitet den OAuth-Callback hierher.
# Beispiel: https://app.youman-automation.com
APP_URL=

# ---- Google Calendar (Lina bucht Termine selbst) --------------------------
# OAuth-Client aus der Google Cloud Console (APIs & Services → Credentials →
# OAuth client ID, Typ „Web application"). Calendar API muss aktiviert sein.
# Autorisierter Redirect-URI = {APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---- A&B Branding overrides (optional) ------------------------------------
# Override electricity price assumed in the sidebar (ct/kWh).
NEXT_PUBLIC_DEFAULT_PRICE_CT_KWH=35
# Override base electricity demand assumed (kWh/year).
NEXT_PUBLIC_DEFAULT_KWH_YEAR=4500
