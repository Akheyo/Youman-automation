# Kopie als ".env" anlegen und Werte eintragen. NIEMALS committen (ist in .gitignore).
# Application Password in WordPress erzeugen: Benutzer -> Profil -> "Anwendungspasswörter".

WP_BASE_URL=https://ab-solarenergy.de
WP_USER=dein-wp-benutzername
# App-Passwort mit Leerzeichen genau so einfügen, wie WordPress es anzeigt:
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
