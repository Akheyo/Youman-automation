# ============================================================================
# Komplett Konzept — Projektplanung · Umgebungsvariablen
# Kopiere diese Datei nach `.env.local` (lokal) oder trage die Werte in Vercel
# → Settings → Environment Variables (Produktion) ein.
# ============================================================================

# ---- Supabase (Login + Suchverlauf) ---------------------------------------
# Aus dem Supabase-Dashboard → Project Settings → API. PFLICHT für Login/History.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-Role-Key (GEHEIM, nur Server!). PFLICHT für die Einstellungsseite —
# nur damit lässt sich der Plenty-Zugang in der Oberfläche speichern.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Verschlüsselung der gespeicherten Zugangsdaten ------------------------
# Schlüssel, mit dem das in der Oberfläche eingetragene Plenty-Passwort in der
# Datenbank verschlüsselt wird (AES-256-GCM). OPTIONAL: Fehlt er, wird
# ersatzweise SUPABASE_SERVICE_ROLE_KEY verwendet.
#
# Ein eigener Schlüssel ist besser, weil das Drehen des Service-Role-Keys
# sonst die gespeicherten Passwörter unlesbar macht (die Oberfläche sagt das
# dann und man trägt sie einmal neu ein). Erzeugen z. B. mit:
#   openssl rand -base64 48
EINSTELLUNGEN_SCHLUESSEL=

# ---- PlentyONE REST-API ----------------------------------------------------
# ALLE Werte hier sind nur noch die Grundeinstellung: Was unter „Einstellungen"
# in der Oberfläche eingetragen ist, hat Vorrang und wirkt ohne neuen Deploy.
#
# Basis-URL des Shops, ohne abschließenden Slash,
# z. B. https://ihr-shop.plentymarkets-cloud01.com
PLENTY_BASE_URL=
# REST-API-Zugangsdaten (eigener API-Benutzer empfohlen).
PLENTY_USER=
PLENTY_PASSWORD=
# Lager, auf dem die Lagerwerkzeuge arbeiten. Leer = das erste, das Plenty meldet.
PLENTY_WAREHOUSE_ID=
# plentyId (Mandanten-/Shop-ID). Meist 0 – im Backend unter Einstellungen → Mandant.
PLENTY_ID=0
# ID der Elternkategorie "Projekte". Unter dieser wird "Firma Ort" angelegt.
# (Backend → Artikel → Kategorien → "Projekte" öffnen, ID aus der URL/Detailansicht.)
PLENTY_PROJEKTE_CATEGORY_ID=
# ID der Barcode-Konfiguration, die als EAN13 an den Artikel gehängt wird
# (Backend → Einrichtung → Artikel → Barcode; z. B. die "EAN13_2"-Konfiguration).
PLENTY_EAN_BARCODE_ID=
# 2-stelliger EAN-Präfix für die intern erzeugten Codes. Standard 20
# (GS1-Bereich 20–29 = "in-store / restricted", kollidiert nie mit echten GTINs).
PLENTY_EAN_PREFIX=20
# ID der Varianteneigenschaft (Property) vom Typ "Datei", an die die Rechnung
# gehängt wird (z. B. die "Dokument 1"-Eigenschaft). Backend → Einrichtung →
# Artikel → Eigenschaften → die Datei-Eigenschaft öffnen, ID übernehmen.
PLENTY_INVOICE_PROPERTY_ID=

# --- Erfassung (Artikel am Regal fotografieren) ------------------------------
# Optionaler Anstoß, sobald ein Artikel abgeschickt wurde. Die Verarbeitung
# findet ihre Arbeit auch ohne — sie liest die Artikel mit status = 'bereit'
# aus der Datenbank. Der Haken ist nur da, damit ein Worker nicht pollen muss.
# Bleibt die Variable leer, passiert nichts, und das ist kein Mangel.
ERFASSUNG_WEBHOOK_URL=

# Schlüssel für die Bilderkennung (console.anthropic.com → API Keys).
# Ohne ihn läuft die Erfassung weiter, die Auswertung der Fotos aber nicht —
# die Seite sagt das dann deutlich, statt still nichts zu tun.
ANTHROPIC_API_KEY=
