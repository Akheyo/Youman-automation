# ============================================================================
# Komplett Konzept — Projektplanung · Umgebungsvariablen
# Kopiere diese Datei nach `.env.local` (lokal) oder trage die Werte in Vercel
# → Settings → Environment Variables (Produktion) ein.
# ============================================================================

# ---- Supabase (Login + Suchverlauf) ---------------------------------------
# Aus dem Supabase-Dashboard → Project Settings → API. PFLICHT für Login/History.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-Role-Key (GEHEIM, nur Server!). Optional – aktuell nicht zwingend nötig.
SUPABASE_SERVICE_ROLE_KEY=

# ---- PlentyONE REST-API ----------------------------------------------------
# Basis-URL des Shops, ohne abschließenden Slash,
# z. B. https://ihr-shop.plentymarkets-cloud01.com
PLENTY_BASE_URL=
# REST-API-Zugangsdaten (eigener API-Benutzer empfohlen).
PLENTY_USER=
PLENTY_PASSWORD=
# plentyId (Mandanten-/Shop-ID). Meist 0 – im Backend unter Einstellungen → Mandant.
PLENTY_ID=0
# ID der Elternkategorie "Projekte". Unter dieser wird "Firma Ort" angelegt.
# (Backend → Artikel → Kategorien → "Projekte" öffnen, ID aus der URL/Detailansicht.)
PLENTY_PROJEKTE_CATEGORY_ID=
# ID der Barcode-Konfiguration, die als EAN13 an den Artikel gehängt wird
# (Backend → Einrichtung → Artikel → Barcode; z. B. die "EAN13_2"-Konfiguration).
PLENTY_EAN_BARCODE_ID=
# 2-stelliger EAN-Präfix für die intern erzeugten Codes. Standard 20
# (GS1-Bereich 20–29 = "in-store / restricted", kollidiert nie mit echten GTINs).
PLENTY_EAN_PREFIX=20
