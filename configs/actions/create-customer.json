      "groupId": "address",
      "width": "third",
      "dynamicSource": {
        "endpoint": "/api/v1/search/countries",
        "searchParam": "q",
        "valueField": "code",
        "labelField": "name",
        "descriptionField": "code",
        "minChars": 0,
        "debounceMs": 0,
        "pageSize": 300
      }
    },
    {
      "id": "f-currency",
      "actionId": "action-create-customer",
      "key": "currency",
      "label": "Währung",
