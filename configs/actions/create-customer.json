        {
          "value": "EUR",
          "label": "EUR"
        },
        {
          "value": "USD",
          "label": "USD"
        },
        {
          "value": "GBP",
          "label": "GBP"
        },
        {
          "value": "CHF",
          "label": "CHF"
        }
      ]
    },
    {
      "id": "f-vat-id",
      "actionId": "action-create-customer",
      "key": "vatId",
      "label": "USt-IdNr.",
