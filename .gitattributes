# Shell scripts must always have LF line endings — they run inside Linux
# containers and CRLF breaks the shebang interpreter resolution.
*.sh text eol=lf

# Keep dotfiles consistent across platforms
.gitattributes text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf
.env.example text eol=lf
Dockerfile text eol=lf
